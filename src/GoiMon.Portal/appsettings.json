{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GraphQL": {
    "Endpoint": "http://localhost:5000/graphql"
  },
  "Auth": {
    "OtpDeliveryMethod": "Email"
  },
  "OAuth": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "RedirectUri": "http://localhost:5002/auth/google-callback"
    },
    "Facebook": {
      "AppId": "YOUR_FACEBOOK_APP_ID",
      "RedirectUri": "http://localhost:5002/auth/facebook-callback"
    }
  }
}
