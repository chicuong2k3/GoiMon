@inherits LayoutComponentBase

<div class="min-h-screen flex">
    <aside class="hidden md:flex w-64 flex-col border-r bg-sidebar p-4">
        <div class="flex items-center gap-2 text-lg font-bold mb-8">
            <LucideIcon Name="utensils" class="h-6 w-6 text-primary" />
            GoiMon
        </div>
        <nav class="flex flex-col gap-1 text-sm">
            <a href="/dashboard" class="flex items-center gap-2 rounded-md px-3 py-2 hover:bg-sidebar-accent">
                <LucideIcon Name="layout-dashboard" class="h-4 w-4" />
                Dashboard
            </a>
            <a href="/dashboard" class="flex items-center gap-2 rounded-md px-3 py-2 hover:bg-sidebar-accent">
                <LucideIcon Name="store" class="h-4 w-4" />
                Cửa hàng
            </a>
            <a href="/dashboard" class="flex items-center gap-2 rounded-md px-3 py-2 hover:bg-sidebar-accent">
                <LucideIcon Name="credit-card" class="h-4 w-4" />
                Subscription
            </a>
        </nav>
    </aside>

    <div class="flex-1 flex flex-col">
        <header class="flex h-16 items-center justify-between border-b px-6">
            <h2 class="text-lg font-semibold">Dashboard</h2>
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small">
                <LucideIcon Name="log-out" class="h-4 w-4 mr-2" />
                Đăng xuất
            </BbButton>
        </header>
        <main class="flex-1 p-6">
            @Body
        </main>
    </div>
</div>
