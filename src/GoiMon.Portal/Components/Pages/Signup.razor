@page "/signup"
@rendermode InteractiveServer

<PageTitle>Đăng ký - GoiMon</PageTitle>

<div class="grid lg:grid-cols-2 min-h-[calc(100vh-8rem)]">
    <!-- Left column - form -->
    <div class="relative flex flex-col items-center justify-center p-8">
        <div class="absolute left-8 top-8 flex items-center gap-2 text-lg font-medium">
            <LucideIcon Name="utensils" class="h-6 w-6 text-primary" />
            GoiMon
        </div>
        <div class="w-full max-w-sm space-y-6">
            <div class="space-y-2 text-center">
                <h1 class="text-2xl font-bold tracking-tight">Tạo tài khoản</h1>
                <p class="text-sm text-muted-foreground">
                    Điền thông tin bên dưới để tạo tài khoản
                </p>
            </div>
            <div class="space-y-4">
                <div class="space-y-2">
                    <BbLabel For="name">Họ và tên</BbLabel>
                    <BbInput Id="name" Placeholder="Nguyễn Văn A" @bind-Value="_name" />
                </div>
                <div class="space-y-2">
                    <BbLabel For="email">Email</BbLabel>
                    <BbInput Id="email" Type="InputType.Email" Placeholder="email@example.com" @bind-Value="_email" />
                </div>
                <div class="space-y-2">
                    <BbLabel For="password">Mật khẩu</BbLabel>
                    <BbInput Id="password" Type="InputType.Password" @bind-Value="_password" />
                    <p class="text-xs text-muted-foreground">Tối thiểu 8 ký tự.</p>
                </div>
                <div class="space-y-2">
                    <BbLabel For="confirm-password">Xác nhận mật khẩu</BbLabel>
                    <BbInput Id="confirm-password" Type="InputType.Password" @bind-Value="_confirmPassword" />
                </div>
                <BbButton Class="w-full" OnClick="HandleSignup">Tạo tài khoản</BbButton>
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <BbSeparator />
                    </div>
                    <div class="relative flex justify-center text-xs uppercase">
                        <span class="bg-background px-2 text-muted-foreground">Hoặc</span>
                    </div>
                </div>
                <BbButton Variant="ButtonVariant.Outline" Class="w-full">
                    <LucideIcon Name="mail" class="h-4 w-4 mr-2" />
                    Đăng ký với Google
                </BbButton>
            </div>
            <div class="text-center text-sm text-muted-foreground">
                Đã có tài khoản?
                <a href="/login" class="text-primary underline-offset-4 hover:underline">Đăng nhập</a>
            </div>
        </div>
    </div>

    <!-- Right column - cover -->
    <div class="relative hidden lg:block bg-muted overflow-hidden">
        <div class="absolute inset-0"
             style="background-image: radial-gradient(circle, color-mix(in oklch, var(--foreground) 10%, transparent) 1px, transparent 1px); background-size: 24px 24px;">
        </div>
        <div class="absolute inset-0"
             style="background: radial-gradient(ellipse at center, transparent 40%, var(--muted) 100%);">
        </div>
    </div>
</div>

@code {
    private string _name = "";
    private string _email = "";
    private string _password = "";
    private string _confirmPassword = "";

    private void HandleSignup()
    {
        // TODO: Implement registration via API
    }
}
