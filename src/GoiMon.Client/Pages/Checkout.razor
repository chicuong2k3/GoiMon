    private sealed record ConfiguredProductDto(
    Guid Id,
    string Name,
    decimal Price,
    string? UnitName,
    IReadOnlyList<VariantDto> Variants,
    IReadOnlyList<ModifierGroupDto> ModifierGroups);

    private sealed record VariantDto(Guid Id, string Name, decimal Price, int SortOrder, bool IsActive);

    private sealed record ModifierGroupDto(
    Guid Id,
    string Name,
    ModifierSelectionMode SelectionMode,
    int MinSelect,
    int MaxSelect,
    int SortOrder,
    bool IsRequired,
    bool IsActive,
    IReadOnlyList<ModifierOptionDto> Options);

    private sealed record ModifierOptionDto(
    Guid Id,
    string Name,
    decimal PriceDelta,
    int MaxQty,
    int SortOrder,
    bool IsDefault,
    bool IsActive);

    private sealed record CartLineItemDto(
    Guid ProductId,
    string ProductName,
    Guid? VariantId,
    string? VariantName,
    string? UnitName,
    IReadOnlyList<CartModifierDto> Modifiers,
    int Quantity,
    decimal UnitPrice);

    private sealed record CartModifierDto(Guid OptionId, string OptionName, int Qty, decimal PriceDelta);
}