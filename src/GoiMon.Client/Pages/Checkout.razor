@page "/checkout"
@inject IGoiMonClient Client
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject IStateReader<UiCacheState> UiStateReader
@inject IStateWriter<UiCacheState> UiStateWriter

@using EasyAppDev.Blazor.Store.Core
@using GoiMon.Client.State

<header class="flex h-14 shrink-0 items-center gap-2 border-b px-4">
    <BbSidebarTrigger />
    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="h-4" />
    <div>
        <h1 class="text-sm font-semibold">Đặt món tại quầy</h1>
        <p class="text-xs text-muted-foreground">Staff chọn món theo menu, cấu hình size/topping rồi xác nhận đơn cho
            khách.</p>
        </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 p-3 lg:p-4">
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Menu món ăn</BbCardTitle>
                <BbCardDescription>Hiển thị theo từng danh mục để staff chọn món trực quan như menu quán ăn.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent Class="space-y-3">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <BbInput Value="@_search"
                             ValueChanged="OnSearchChangedAsync"
                             UpdateTiming="UpdateTiming.Debounced"
                             DebounceInterval="300"
                             Placeholder="Tìm món theo tên..." />
                    <div class="flex items-center gap-2 overflow-x-auto pb-1">
                        <BbButton
                            Variant="@(_selectedCategory == AllCategoriesValue ? ButtonVariant.Default : ButtonVariant.Outline)"
                            Size="ButtonSize.Small" OnClick="() => SelectCategoryAsync(AllCategoriesValue)">
                            Tất cả
                        </BbButton>
                        @foreach (var category in CategoryNames)
                        {
                            <BbButton Variant="@(_selectedCategory == category ? ButtonVariant.Default : ButtonVariant.Outline)"
                                      Size="ButtonSize.Small" OnClick="() => SelectCategoryAsync(category)">
                                @category
                            </BbButton>
                        }
                    </div>
                </div>

                @if (_loadingProducts)
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
                        <BbSkeleton Height="180px" Class="w-full" />
                        <BbSkeleton Height="180px" Class="w-full" />
                        <BbSkeleton Height="180px" Class="w-full" />
                        <BbSkeleton Height="180px" Class="w-full" />
                        <BbSkeleton Height="180px" Class="w-full" />
                        <BbSkeleton Height="180px" Class="w-full" />
                    </div>
                }
                else
                {
                    @if (VisibleCategoryGroups.Count == 0)
                    {
                        <BbAlert Variant="AlertVariant.Info">
                            <BbAlertDescription>Không tìm thấy món phù hợp với bộ lọc hiện tại.</BbAlertDescription>
                        </BbAlert>
                    }
                    else
                    {
                        <div class="max-h-[72vh] overflow-y-auto space-y-4 pr-1">
                            @foreach (var group in VisibleCategoryGroups)
                            {
                                <div class="space-y-3">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <h3 class="text-sm font-semibold">@group.CategoryName</h3>
                                            <BbBadge Variant="BadgeVariant.Outline">@group.Products.Count món</BbBadge>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                                        @foreach (var product in group.Products)
                                        {
                                            var isSelected = _selectedProductId == product.Id;
                                            <div class="flex items-center gap-3 rounded-lg border p-2.5 cursor-pointer transition-colors @(isSelected ? "border-primary bg-primary/10 ring-1 ring-primary/40" : "hover:bg-muted/40")"
                                                 @onclick="() => SelectProductAsync(product.Id)">
                                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                                {
                                                    <img src="@product.ImageUrl" alt="@product.Name"
                                                         class="h-14 w-14 rounded-md object-cover shrink-0" />
                                                }
                                                else
                                                {
                                                    <div class="h-14 w-14 rounded-md bg-muted flex items-center justify-center shrink-0">
                                                        <LucideIcon Name="image" Class="h-5 w-5 text-muted-foreground/40" />
                                                    </div>
                                                }
                                                <div class="flex-1 min-w-0 space-y-0.5">
                                                    <div class="flex items-start justify-between gap-1">
                                                        <span class="text-sm font-semibold leading-snug truncate">@product.Name</span>
                                                        <span class="text-sm font-semibold whitespace-nowrap text-primary shrink-0">@product.Price.ToString("#,##0")đ</span>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(product.UnitName))
                                                    {
                                                        <div class="text-xs text-muted-foreground">@product.UnitName</div>
                                                    }
                                                    <div class="flex flex-wrap gap-1 pt-0.5">
                                                        @if (product.ActiveVariantCount > 0)
                                                        {
                                                            <BbBadge Variant="BadgeVariant.Secondary" Class="text-[10px] px-1.5 py-0">@product.ActiveVariantCount size</BbBadge>
                                                        }
                                                        @if (product.ActiveModifierGroupCount > 0)
                                                        {
                                                            <BbBadge Variant="BadgeVariant.Secondary" Class="text-[10px] px-1.5 py-0">@product.ActiveModifierGroupCount topping</BbBadge>
                                                        }
                                                        @if (product.ActiveVariantCount == 0 && product.ActiveModifierGroupCount == 0)
                                                        {
                                                            <BbBadge Variant="BadgeVariant.Outline" Class="text-[10px] px-1.5 py-0">Cơ bản</BbBadge>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </BbCardContent>
            </BbCard>

            <div class="lg:sticky lg:top-3 self-start">
                <div class="flex flex-col rounded-lg border bg-card overflow-hidden" style="max-height: calc(100vh - 6rem)">

                    <div class="flex items-center justify-between px-4 py-3 border-b shrink-0">
                        <span class="text-sm font-semibold">Đặt món</span>
                        @if (_cart.Count > 0)
                        {
                            <BbBadge>@_cart.Count món</BbBadge>
                        }
                    </div>

                    <div class="flex-1 overflow-y-auto divide-y">

                        <div class="p-4 space-y-3">
                            @if (_selectedProduct is null && !_loadingConfigurator)
                            {
                                <p class="text-sm text-muted-foreground py-1">Chọn một món trong menu để thêm vào đơn.</p>
                            }
                            else if (_loadingConfigurator)
                            {
                                <div class="space-y-2">
                                    <BbSkeleton Height="20px" Class="w-40" />
                                    <BbSkeleton Height="44px" Class="w-full" />
                                    <BbSkeleton Height="44px" Class="w-full" />
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center justify-between text-sm">
                                    <span class="font-medium">@_selectedProduct!.Name</span>
                                    <span class="text-muted-foreground">@_selectedProduct.Price.ToString("#,##0")đ cơ bản</span>
                                </div>

                                @if (_selectedProduct.Variants.Any(v => v.IsActive))
                                {
                                    <div class="space-y-1.5">
                                        <BbLabel>Chọn size</BbLabel>
                                        <div class="flex flex-wrap gap-2">
                                            @foreach (var variant in _selectedProduct.Variants.Where(v => v.IsActive).OrderBy(v => v.SortOrder))
                                            {
                                                <BbButton Variant="@(variant.Id == _selectedVariantId ? ButtonVariant.Default : ButtonVariant.Outline)"
                                                          Size="ButtonSize.Small" OnClick="() => _selectedVariantId = variant.Id">
                                                    @variant.Name (@variant.Price.ToString("#,##0")đ)
                                                </BbButton>
                                            }
                                        </div>
                                    </div>
                                }

                                @foreach (var group in _selectedProduct.ModifierGroups.Where(g => g.IsActive).OrderBy(g => g.SortOrder))
                                {
                                    <div class="space-y-2 border rounded-md p-3">
                                        <div class="flex items-center justify-between">
                                            <BbLabel>@group.Name</BbLabel>
                                            <span class="text-xs text-muted-foreground">Min @group.MinSelect • Max @group.MaxSelect</span>
                                        </div>
                                        @if (group.SelectionMode == ModifierSelectionMode.Single)
                                        {
                                            <div class="flex flex-wrap gap-2">
                                                @foreach (var option in group.Options.Where(o => o.IsActive).OrderBy(o => o.SortOrder))
                                                {
                                                    var optSelected = GetOptionQty(option.Id) > 0;
                                                    <BbButton Variant="@(optSelected ? ButtonVariant.Default : ButtonVariant.Outline)"
                                                              Size="ButtonSize.Small" OnClick="() => SelectSingleOption(group, option)">
                                                        @option.Name (+@option.PriceDelta.ToString("#,##0")đ)
                                                    </BbButton>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="space-y-2">
                                                @foreach (var option in group.Options.Where(o => o.IsActive).OrderBy(o => o.SortOrder))
                                                {
                                                    <div class="flex items-center justify-between gap-2">
                                                        <span class="text-sm">@option.Name (+@option.PriceDelta.ToString("#,##0")đ)</span>
                                                        <div class="flex items-center gap-1">
                                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall"
                                                                      OnClick="() => DecreaseOption(option)">
                                                                <LucideIcon Name="minus" Class="h-4 w-4" />
                                                            </BbButton>
                                                            <span class="w-8 text-center text-sm">@GetOptionQty(option.Id)</span>
                                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall"
                                                                      Disabled="@(!CanIncreaseOption(group, option))"
                                                                      OnClick="() => IncreaseOption(group, option)">
                                                                <LucideIcon Name="plus" Class="h-4 w-4" />
                                                            </BbButton>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="flex items-center justify-between pt-1">
                                    <div class="flex items-center gap-2">
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall"
                                                  Disabled="@(_lineQty <= 1)" OnClick="DecreaseLineQty">
                                            <LucideIcon Name="minus" Class="h-4 w-4" />
                                        </BbButton>
                                        <span class="w-10 text-center text-sm">@_lineQty</span>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" OnClick="IncreaseLineQty">
                                            <LucideIcon Name="plus" Class="h-4 w-4" />
                                        </BbButton>
                                    </div>
                                    <span class="text-sm">Tạm tính: <strong>@EstimatedLineTotal.ToString("#,##0")đ</strong></span>
                                </div>

                                @if (!IsCurrentSelectionValid())
                                {
                                    <BbAlert Variant="AlertVariant.Warning">
                                        <BbAlertDescription>Vui lòng chọn đúng số lượng topping theo ràng buộc từng nhóm.</BbAlertDescription>
                                    </BbAlert>
                                }

                                <BbButton OnClick="AddToCartAsync" Disabled="@(!CanAddToCart)" Class="w-full" Size="ButtonSize.Small">
                                    <LucideIcon Name="plus" Class="mr-2 h-4 w-4" />
                                    Thêm vào đơn
                                </BbButton>
                            }
                        </div>

                        @if (_cart.Count == 0)
                        {
                            <div class="px-4 py-6 text-center text-sm text-muted-foreground">Chưa có món nào trong đơn.</div>
                        }
                        else
                        {
                            <div class="p-4 space-y-2">
                                @foreach (var (item, index) in _cart.Select((x, i) => (x, i)))
                                {
                                    <div class="flex items-start justify-between gap-2 text-sm">
                                        <div class="flex-1 min-w-0 space-y-0.5">
                                            <div class="font-medium truncate">
                                                @item.ProductName @(item.VariantName is not null ? $"({item.VariantName})" : "")
                                            </div>
                                            @if (item.Modifiers.Count > 0)
                                            {
                                                <div class="text-xs text-muted-foreground truncate">
                                                    @string.Join(", ", item.Modifiers.Select(m => m.Qty > 1 ? $"{m.OptionName}×{m.Qty}" : m.OptionName))
                                                </div>
                                            }
                                            <div class="text-xs text-muted-foreground">
                                                @item.Quantity × @item.UnitPrice.ToString("#,##0")đ = <strong>@((item.Quantity * item.UnitPrice).ToString("#,##0"))đ</strong>
                                            </div>
                                        </div>
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                                  OnClick="() => RemoveCartItemAsync(index)">
                                            <LucideIcon Name="x" Class="h-4 w-4" />
                                        </BbButton>
                                    </div>
                                }
                            </div>
                        }

                    </div>

                    <div class="border-t px-4 py-3 space-y-2.5 shrink-0">
                        @if (_cart.Count > 0)
                        {
                            <div class="flex justify-between font-semibold text-sm">
                                <span>Tổng tạm tính</span>
                                <span>@CartTotal.ToString("#,##0")đ</span>
                            </div>
                            <div class="flex gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="ClearCartAsync">Xóa đơn</BbButton>
                                <BbButton Size="ButtonSize.Small" Class="flex-1" OnClick="PlaceOrderAsync"
                                          Loading="@_placingOrder" LoadingText="Đang đặt..." Disabled="@(!CanPlaceOrder)">
                                    Đặt hàng
                                </BbButton>
                            </div>
                        }
                        else
                        {
                            <div class="text-xs text-muted-foreground text-center py-1">Chưa có món trong đơn hiện tại.</div>
                        }
                    </div>

                </div>
            </div>
        </div>

@code {
    private bool _loadingProducts;
    private bool _loadingConfigurator;
    private bool _placingOrder;
    private string _search = string.Empty;
    private const string AllCategoriesValue = "__ALL__";
    private string _selectedCategory = AllCategoriesValue;
    private List<CartLineItemDto> _cart = [];

    private Guid? _selectedProductId;
    private ConfiguredProductDto? _selectedProduct;
    private Guid? _selectedVariantId;
    private int _lineQty = 1;
    private readonly Dictionary<Guid, int> _selectedOptionQuantities = new();
    private List<ProductListItem> _products = [];

    private IReadOnlyList<string> CategoryNames => _products
    .Select(product => product.CategoryName)
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .OrderBy(name => name)
    .ToList();

    private IReadOnlyList<CategoryGroupDto> VisibleCategoryGroups => FilteredProducts
    .GroupBy(product => product.CategoryName)
    .OrderBy(group => group.Key)
    .Select(group => new CategoryGroupDto(group.Key, group.OrderBy(product => product.Name).ToList()))
    .ToList();

    private IEnumerable<ProductListItem> FilteredProducts =>
    _products.Where(product =>
    (_selectedCategory == AllCategoriesValue || product.CategoryName.Equals(_selectedCategory,
    StringComparison.OrdinalIgnoreCase))
    && (string.IsNullOrWhiteSpace(_search)
    || product.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private decimal EstimatedUnitPrice
    {
        get
        {
            if (_selectedProduct is null) return 0m;
            var basePrice = _selectedProduct.Variants.Where(v => v.IsActive).FirstOrDefault(v => v.Id == _selectedVariantId)?.Price
            ?? _selectedProduct.Price;
            var modifiers = _selectedProduct.ModifierGroups
            .Where(g => g.IsActive)
            .SelectMany(g => g.Options)
            .Where(o => o.IsActive)
            .Sum(o => o.PriceDelta * GetOptionQty(o.Id));
            return basePrice + modifiers;
        }
    }

    private decimal EstimatedLineTotal => EstimatedUnitPrice * _lineQty;

    private bool CanAddToCart =>
    _selectedProduct is not null
    && _lineQty > 0
    && IsCurrentSelectionValid()
    && (!_selectedProduct.Variants.Any(v => v.IsActive) || _selectedVariantId.HasValue);

    private bool CanPlaceOrder => _cart.Count > 0 && !_placingOrder;

    private decimal CartTotal => _cart.Sum(l => l.UnitPrice * l.Quantity);

    protected override async Task OnInitializedAsync()
    {
        if (TryRestoreState())
        {
            if (_products.Count == 0)
            {
                await LoadProductsAsync();
            }

            return;
        }

        await LoadProductsAsync();
    }

    private bool TryRestoreState()
    {
        var cached = UiStateReader.GetState().Checkout;
        if (cached is null)
        {
            return false;
        }

        _search = cached.Search;
        _selectedCategory = string.IsNullOrWhiteSpace(cached.SelectedCategory) ? AllCategoriesValue : cached.SelectedCategory;

        _products = cached.Products
            .Select(product => new ProductListItem(
                product.Id,
                product.Name,
                product.Price,
                product.UnitName,
                product.Description,
                product.ImageUrl,
                product.CategoryName,
                product.ActiveVariantCount,
                product.ActiveModifierGroupCount))
            .ToList();

        _cart = cached.Cart
            .Select(item => new CartLineItemDto(
                item.ProductId,
                item.ProductName,
                item.VariantId,
                item.VariantName,
                item.UnitName,
                item.Modifiers.Select(modifier => new CartModifierDto(
                    modifier.OptionId,
                    modifier.OptionName,
                    modifier.Qty,
                    modifier.PriceDelta)).ToList(),
                item.Quantity,
                item.UnitPrice))
            .ToList();

        return true;
    }

    private Task PersistStateAsync()
    {
        var snapshot = new CheckoutPageState(
            _search,
            _selectedCategory,
            _products.Select(product => new CheckoutProductListItem(
                product.Id,
                product.Name,
                product.Price,
                product.UnitName,
                product.Description,
                product.ImageUrl,
                product.CategoryName,
                product.ActiveVariantCount,
                product.ActiveModifierGroupCount)).ToList(),
            _cart.Select(item => new CheckoutCartLineItem(
                item.ProductId,
                item.ProductName,
                item.VariantId,
                item.VariantName,
                item.UnitName,
                item.Quantity,
                item.UnitPrice,
                item.Modifiers.Select(modifier => new CheckoutCartModifierItem(
                    modifier.OptionId,
                    modifier.OptionName,
                    modifier.Qty,
                    modifier.PriceDelta)).ToList())).ToList());

        return UiStateWriter.UpdateAsync(state => state with { Checkout = snapshot }, "cache.checkout");
    }

    private async Task OnSearchChangedAsync(string value)
    {
        _search = value;
        await PersistStateAsync();
    }

    private async Task SelectCategoryAsync(string category)
    {
        _selectedCategory = category;
        await PersistStateAsync();
    }

    private async Task LoadProductsAsync()
    {
        _loadingProducts = true;
        try
        {
            var result = await Client.GetProducts.ExecuteAsync(
            skip: 0,
            take: 200,
            where: null,
            order: [new ProductSortInput { Name = SortEnumType.Asc }]);

            if (result.Data?.Products?.Items is { } items)
            {
                _products = items
                .Select(p => new ProductListItem(
                p.Id,
                p.Name,
                p.Price,
                p.UnitName,
                p.Description,
                p.ImageUrl,
                p.Category?.Name ?? "Khác",
                p.Variants.Count(v => v.IsActive),
                p.ModifierGroups.Count(group => group.IsActive)))
                .ToList();

                await PersistStateAsync();
            }
            else if (result.Errors.Count > 0)
            {
                ToastService.Error(result.Errors[0].Message);
            }
        }
        finally
        {
            _loadingProducts = false;
        }
    }

    private async Task SelectProductAsync(Guid productId)
    {
        // Click selected product again → deselect
        if (_selectedProductId == productId)
        {
            _selectedProductId = null;
            _selectedProduct = null;
            _selectedVariantId = null;
            _selectedOptionQuantities.Clear();
            _lineQty = 1;
            return;
        }

        _selectedProductId = productId;
        _selectedProduct = null;
        _selectedVariantId = null;
        _selectedOptionQuantities.Clear();
        _lineQty = 1;

        _loadingConfigurator = true;
        try
        {
            var result = await Client.GetProductConfigurator.ExecuteAsync(productId);
            var product = result.Data?.ProductById;
            if (product is null)
            {
                ToastService.Error(result.Errors.FirstOrDefault()?.Message ?? "Không tải được cấu hình sản phẩm");
                _selectedProductId = null;
                return;
            }

            _selectedProduct = new ConfiguredProductDto(
            product.Id,
            product.Name,
            product.Price,
            product.UnitName,
            product.Variants.Select(v => new VariantDto(v.Id, v.Name, v.Price, v.SortOrder, v.IsActive)).ToList(),
            product.ModifierGroups.Select(g => new ModifierGroupDto(
            g.Id,
            g.Name,
            g.SelectionMode,
            g.MinSelect,
            g.MaxSelect,
            g.SortOrder,
            g.IsRequired,
            g.IsActive,
            g.Options.Select(o => new ModifierOptionDto(o.Id, o.Name, o.PriceDelta, o.MaxQty, o.SortOrder, o.IsDefault,
            o.IsActive)).ToList())).ToList());

            if (_selectedProduct.Variants.Any(v => v.IsActive))
                _selectedVariantId = _selectedProduct.Variants.Where(v => v.IsActive).OrderBy(v => v.SortOrder).First().Id;

            foreach (var group in _selectedProduct.ModifierGroups.Where(g => g.IsActive))
            {
                var defaultOptions = group.Options.Where(o => o.IsActive && o.IsDefault).OrderBy(o => o.SortOrder).ToList();
                if (group.SelectionMode == ModifierSelectionMode.Single && defaultOptions.Count > 0)
                    _selectedOptionQuantities[defaultOptions[0].Id] = 1;
                else
                    foreach (var option in defaultOptions)
                        _selectedOptionQuantities[option.Id] = 1;
            }
        }
        finally
        {
            _loadingConfigurator = false;
        }
    }

    private int GetOptionQty(Guid optionId)
    => _selectedOptionQuantities.TryGetValue(optionId, out var qty) ? qty : 0;

    private void SelectSingleOption(ModifierGroupDto group, ModifierOptionDto option)
    {
        foreach (var groupOption in group.Options.Where(o => o.IsActive))
        {
            _selectedOptionQuantities.Remove(groupOption.Id);
        }

        _selectedOptionQuantities[option.Id] = 1;
    }

    private void IncreaseOption(ModifierGroupDto group, ModifierOptionDto option)
    {
        if (!CanIncreaseOption(group, option)) return;
        _selectedOptionQuantities[option.Id] = GetOptionQty(option.Id) + 1;
    }

    private void DecreaseOption(ModifierOptionDto option)
    {
        var current = GetOptionQty(option.Id);
        if (current <= 0) return;

        if (current == 1) _selectedOptionQuantities.Remove(option.Id);
        else _selectedOptionQuantities[option.Id] = current - 1;
    }

    private bool CanIncreaseOption(ModifierGroupDto group, ModifierOptionDto option)
    {
        if (!group.IsActive || !option.IsActive) return false;
        var current = GetOptionQty(option.Id);
        if (current >= option.MaxQty) return false;

        var selectedGroupTotal = group.Options.Where(o => o.IsActive).Sum(o => GetOptionQty(o.Id));
        return selectedGroupTotal < group.MaxSelect;
    }

    private bool IsCurrentSelectionValid()
    {
        if (_selectedProduct is null) return false;

        foreach (var group in _selectedProduct.ModifierGroups.Where(g => g.IsActive))
        {
            var selected = group.Options.Where(o => o.IsActive).Sum(o => GetOptionQty(o.Id));
            if (selected < group.MinSelect) return false;
            if (group.IsRequired && selected == 0) return false;
            if (selected > group.MaxSelect) return false;
            if (group.SelectionMode == ModifierSelectionMode.Single && selected > 1) return false;
        }

        return true;
    }

    private void IncreaseLineQty() => _lineQty++;
    private void DecreaseLineQty()
    {
        if (_lineQty > 1) _lineQty--;
    }

    private async Task AddToCartAsync()
    {
        if (_selectedProduct is null) return;
        var variantName = _selectedVariantId.HasValue
        ? _selectedProduct.Variants.FirstOrDefault(v => v.Id == _selectedVariantId)?.Name
        : null;
        var allOptions = _selectedProduct.ModifierGroups
        .Where(g => g.IsActive).SelectMany(g => g.Options).Where(o => o.IsActive).ToList();
        var activeOptionIds = allOptions.Select(o => o.Id).ToHashSet();
        var modifiers = _selectedOptionQuantities
        .Where(x => x.Value > 0 && activeOptionIds.Contains(x.Key))
        .Select(x =>
        {
            var option = allOptions.First(o => o.Id == x.Key);
            return new CartModifierDto(x.Key, option.Name, x.Value, option.PriceDelta);
        })
        .ToList();

        var newLine = new CartLineItemDto(
            _selectedProduct.Id,
            _selectedProduct.Name,
            _selectedVariantId,
            variantName,
            _selectedProduct.UnitName,
            modifiers,
            _lineQty,
            EstimatedUnitPrice);

        var existingIndex = _cart.FindIndex(item => IsSameCartConfiguration(item, newLine));
        if (existingIndex >= 0)
        {
            var existing = _cart[existingIndex];
            _cart[existingIndex] = existing with { Quantity = existing.Quantity + newLine.Quantity };
        }
        else
        {
            _cart.Add(newLine);
        }

        // Reset configurator state, re-apply defaults
        _selectedVariantId = null;
        _selectedOptionQuantities.Clear();
        _lineQty = 1;
        if (_selectedProduct.Variants.Any(v => v.IsActive))
            _selectedVariantId = _selectedProduct.Variants.Where(v => v.IsActive).OrderBy(v => v.SortOrder).First().Id;
        foreach (var group in _selectedProduct.ModifierGroups.Where(g => g.IsActive))
        {
            var defaults = group.Options.Where(o => o.IsActive && o.IsDefault).OrderBy(o => o.SortOrder).ToList();
            if (group.SelectionMode == ModifierSelectionMode.Single && defaults.Count > 0)
                _selectedOptionQuantities[defaults[0].Id] = 1;
            else
                foreach (var opt in defaults) _selectedOptionQuantities[opt.Id] = 1;
        }

        await PersistStateAsync();
    }

    private static bool IsSameCartConfiguration(CartLineItemDto left, CartLineItemDto right)
    {
        if (left.ProductId != right.ProductId) return false;
        if (left.VariantId != right.VariantId) return false;
        if (left.UnitPrice != right.UnitPrice) return false;
        return BuildModifierSignature(left.Modifiers) == BuildModifierSignature(right.Modifiers);
    }

    private static string BuildModifierSignature(IReadOnlyList<CartModifierDto> modifiers)
        => string.Join("|", modifiers
            .OrderBy(modifier => modifier.OptionId)
            .Select(modifier => $"{modifier.OptionId:N}:{modifier.Qty}:{modifier.PriceDelta}"));

    private async Task RemoveCartItemAsync(int index)
    {
        if (index < 0 || index >= _cart.Count)
        {
            return;
        }

        _cart.RemoveAt(index);
        await PersistStateAsync();
    }

    private async Task ClearCartAsync()
    {
        if (_cart.Count == 0)
        {
            return;
        }

        _cart.Clear();
        await PersistStateAsync();
    }

    private async Task PlaceOrderAsync()
    {
        if (!CanPlaceOrder) return;

        _placingOrder = true;
        try
        {
            var input = new CreateOrderInput
            {
                Lines = _cart.Select(item => new CreateOrderLineInput
                {
                    ProductId = item.ProductId,
                    VariantId = item.VariantId,
                    Quantity = item.Quantity,
                    Modifiers = item.Modifiers.Select(m => new CreateOrderLineModifierInput
                    {
                        OptionId = m.OptionId,
                        Quantity = m.Qty
                    }).ToList()
                }).ToList()
            };

            var result = await Client.CreateOrder.ExecuteAsync(input);
            if (result.IsErrorResult())
            {
                ToastService.Error(result.Errors.FirstOrDefault()?.Message ?? "Không thể tạo đơn hàng");
                return;
            }

            var payload = result.Data?.CreateOrder;
            if (payload is null)
            {
                ToastService.Error("Không thể tạo đơn hàng");
                return;
            }

            if (payload.Errors.Count > 0)
            {
                var first = payload.Errors[0];
                ToastService.Error($"{first.Code}: {first.Message}");
                return;
            }

            if (payload.Order is null)
            {
                ToastService.Error("Tạo đơn thất bại");
                return;
            }

            ToastService.Success($"Đặt hàng thành công: #{payload.Order.Id.ToString("N")[..6].ToUpper()}");
            _cart.Clear();
            await PersistStateAsync();
            Navigation.NavigateTo("/orders");
        }
        finally
        {
            _placingOrder = false;
        }
    }

    private sealed record ProductListItem(
    Guid Id,
