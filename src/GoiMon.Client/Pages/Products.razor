@page "/products"
@inject IGoiMonClient Client
@inject ToastService ToastService
@inject IStateReader<UiCacheState> UiStateReader
@inject IStateWriter<UiCacheState> UiStateWriter
@inject GoiMon.Client.Features.ImageUpload.Services.IImageUploadService ImageUploadSvc

@using EasyAppDev.Blazor.Store.Core
@using GoiMon.Client.State

<header class="flex h-14 shrink-0 items-center gap-2 border-b px-4">
    <BbSidebarTrigger />
    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="h-4" />
    <h1 class="text-sm font-semibold">Sản phẩm</h1>
    <div class="ml-auto flex items-center gap-2">
        @if (_selectedIds.Count > 0)
        {
            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                      OnClick="OpenBulkDeleteConfirm">
                <LucideIcon Name="trash-2" Class="h-4 w-4 mr-1" />
                Xóa (@_selectedIds.Count)
            </BbButton>
        }
        <BbButton OnClick="OpenCreateAsync" Size="ButtonSize.Small">
            <LucideIcon Name="plus" Class="h-4 w-4 mr-1" />
            Thêm sản phẩm
        </BbButton>
    </div>
</header>

<div class="p-6 space-y-4">
    <div class="flex flex-wrap items-center gap-3">
        <div class="w-72">
            <BbInput Value="@_search"
                     ValueChanged="@(async v => { _search = v; _skip = 0; await LoadAsync(); })"
                     UpdateTiming="UpdateTiming.Debounced"
                     DebounceInterval="400"
                     Placeholder="Tìm kiếm sản phẩm..." />
        </div>
        <div class="flex items-center gap-2">
            <div class="w-52">
                <BbCombobox TValue="Guid?"
                            Value="@_filterCategoryId"
                            ValueChanged="@(async v => { _filterCategoryId = v; _skip = 0; await LoadAsync(); })"
                            Options="FilterCategoryOptions"
                            Placeholder="Tất cả danh mục"
                            SearchPlaceholder="Tìm danh mục..."
                            EmptyMessage="Không tìm thấy danh mục."
                            MatchTriggerWidth="true" />
            </div>
        </div>
    </div>
    <div class="flex flex-wrap items-center gap-3">
        <div class="w-40">
            <BbInput Value="@_filterPriceMin"
                     ValueChanged="@(async v => { _filterPriceMin = v; _skip = 0; await LoadAsync(); })"
                     UpdateTiming="UpdateTiming.Debounced"
                     DebounceInterval="400"
                     Placeholder="Giá từ" />
        </div>
        <div class="w-40">
            <BbInput Value="@_filterPriceMax"
                     ValueChanged="@(async v => { _filterPriceMax = v; _skip = 0; await LoadAsync(); })"
                     UpdateTiming="UpdateTiming.Debounced"
                     DebounceInterval="400"
                     Placeholder="Giá đến" />
        </div>
        <div class="w-56">
            <BbCombobox TValue="string"
                        Value="@_sortOption"
                        ValueChanged="@(async v => { _sortOption = v; _skip = 0; await LoadAsync(); })"
                        Options="SortOptions"
                        Placeholder="Sắp xếp"
                        SearchPlaceholder="Tìm kiểu sắp xếp..."
                        EmptyMessage="Không có trường."
                        MatchTriggerWidth="true" />
        </div>
    </div>

    @if (_loading)
    {
        <div class="space-y-2">
            @for (int i = 0; i < 6; i++)
            {
                <BbSkeleton Height="52px" Class="w-full" />
            }
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-md border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            @_error
        </div>
    }
    else
    {
        <div class="rounded-md border">
            <table class="w-full text-sm">
                <thead class="border-b bg-muted/50">
                    <tr>
                        <th class="h-10 w-10 px-3">
                            <BbCheckbox Checked="@AllSelected" CheckedChanged="@ToggleSelectAll" />
                        </th>
                        <th class="h-10 px-4 text-left font-medium text-muted-foreground">Tên sản phẩm</th>
                        <th class="h-10 px-4 text-left font-medium text-muted-foreground">Danh mục</th>
                        <th class="h-10 px-4 text-right font-medium text-muted-foreground">Giá</th>
                        <th class="h-10 px-4 text-left font-medium text-muted-foreground hidden md:table-cell">Mô tả</th>
                        <th class="h-10 px-4 text-right font-medium text-muted-foreground w-28">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="p-8 text-center text-muted-foreground">
                                Không tìm thấy sản phẩm nào.
                            </td>
                        </tr>
                    }
                    @foreach (var item in _items)
                    {
                        <tr class="border-b last:border-0 hover:bg-muted/50 transition-colors @(_selectedIds.Contains(item.Id) ? "bg-muted/30" : "")">
                            <td class="px-3 py-3">
                                <BbCheckbox Checked="@_selectedIds.Contains(item.Id)"
                                            CheckedChanged="@(v => ToggleSelect(item.Id, v))" />
                            </td>
                            <td class="px-4 py-3 font-medium">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="h-10 w-10 rounded object-cover shrink-0" />
                                    }
                                    else
                                    {
                                        <div class="h-10 w-10 rounded bg-muted flex items-center justify-center shrink-0">
                                            <LucideIcon Name="image" Class="h-4 w-4 text-muted-foreground" />
                                        </div>
                                    }
                                    <span>@item.Name</span>
                                </div>
                            </td>
                            <td class="px-4 py-3">
                                @if (item.CategoryName is not null)
                                {
                                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium">
                                        @item.CategoryName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground text-xs">—</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-right font-medium tabular-nums">
                                @item.Price.ToString("#,##0") đ
                            </td>
                            <td class="px-4 py-3 text-muted-foreground hidden md:table-cell max-w-[200px] truncate">
                                @(item.Description ?? "—")
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex justify-end gap-1">
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Sửa" OnClick="async () => await OpenEditAsync(item)">
                                        <LucideIcon Name="pencil" Class="h-4 w-4" />
                                    </BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Xóa" Class="text-destructive hover:text-destructive hover:bg-destructive/10"
                                              OnClick="() => OpenDeleteConfirm(item.Id)">
                                        <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                    </BbButton>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-between text-sm text-muted-foreground">
            <span>Hiển thị @(_items.Count) / @_total sản phẩm</span>
            <div class="flex items-center gap-2">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          Disabled="@(CurrentPage <= 1)" OnClick="() => GoToPageAsync(CurrentPage - 1)">Trước</BbButton>
                @foreach (var page in VisiblePages)
                {
                    <BbButton Variant="@(page == CurrentPage ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Small"
                              Disabled="@(page == CurrentPage)"
                              OnClick="() => GoToPageAsync(page)">@(page)</BbButton>
                }
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          Disabled="@(CurrentPage >= TotalPages)" OnClick="() => GoToPageAsync(CurrentPage + 1)">Sau</BbButton>
            </div>
        </div>
    }
</div>

<!-- Create Dialog -->
<BbDialog Open="@_showCreate" OpenChanged="@(v => _showCreate = v)">
    <BbDialogContent Class="max-w-md flex flex-col max-h-[90vh]">
        <BbDialogHeader>
            <BbDialogTitle>Thêm sản phẩm</BbDialogTitle>
            <BbDialogDescription>Nhập thông tin sản phẩm mới.</BbDialogDescription>
        </BbDialogHeader>
        <div class="overflow-y-auto flex-1 space-y-3 py-4 pr-1">
            <div class="space-y-1">
                <label class="text-sm font-medium">Tên sản phẩm <span class="text-destructive">*</span></label>
                <BbInput @bind-Value="_formName" Placeholder="Tên sản phẩm" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium">Giá (đ) <span class="text-destructive">*</span></label>
                <BbInput @bind-Value="_formPriceStr" Type="InputType.Number" Placeholder="0" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium">Danh mục</label>
                <BbCombobox TValue="Guid?"
                            @bind-Value="_formCategoryId"
                            Options="CategoryOptions"
                            Placeholder="Chọn danh mục..."
                            SearchPlaceholder="Tìm danh mục..."
                            EmptyMessage="Không tìm thấy danh mục."
                            Class="w-full"
                            MatchTriggerWidth="true" />
                @if (_formCategoryId.HasValue)
                {
                    <p class="text-xs text-muted-foreground">Đã chọn: @GetCategoryDisplayName(_formCategoryId)</p>
                }
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium">Mô tả</label>
                <BbInput @bind-Value="_formDescription" Placeholder="Mô tả sản phẩm" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium">Hình ảnh</label>
                @if (HasImage)
                {
                    <img src="@DisplayImageUrl" class="w-full h-32 object-cover rounded-lg mb-2" alt="Product image" />
                }
                <InputFile OnChange="HandleImageSelected" accept="image/*" class="hidden" id="create-product-img" />
                <label for="create-product-img"
                       class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium shadow-sm hover:bg-accent hover:text-accent-foreground">
                    <LucideIcon Name="image" Class="h-4 w-4" />
                    <span>@(HasImage ? "Đổi ảnh" : "Chọn ảnh")</span>
                </label>
            </div>
        </div>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Hủy</BbButton>
            </BbDialogClose>
            <BbButton OnClick="HandleCreate"
                      Loading="@_saving" LoadingText="Đang lưu..."
                      Disabled="@(string.IsNullOrWhiteSpace(_formName) || !decimal.TryParse(_formPriceStr, out _))">
                Lưu
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<!-- Delete Confirm Dialog -->
<BbDialog Open="@_showDeleteConfirm" OpenChanged="@(v => _showDeleteConfirm = v)">
    <BbDialogContent Class="max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>Xóa sản phẩm?</BbDialogTitle>
            <BbDialogDescription>Hành động này không thể hoàn tác.</BbDialogDescription>
        </BbDialogHeader>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Hủy</BbButton>
            </BbDialogClose>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="ConfirmDeleteAsync">Xóa</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<!-- Bulk Delete Confirm Dialog -->
<BbDialog Open="@_showBulkDeleteConfirm" OpenChanged="@(v => _showBulkDeleteConfirm = v)">
    <BbDialogContent Class="max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>Xóa @_selectedIds.Count sản phẩm?</BbDialogTitle>
            <BbDialogDescription>Hành động này không thể hoàn tác.</BbDialogDescription>
        </BbDialogHeader>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Hủy</BbButton>
            </BbDialogClose>
            <BbButton Variant="ButtonVariant.Destructive" Loading="@_bulkDeleting" LoadingText="Đang xóa..."
                      OnClick="HandleBulkDelete">Xóa</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<!-- Edit Dialog -->
<BbDialog Open="@_showEdit" OpenChanged="@(v => _showEdit = v)">
    <BbDialogContent Class="max-w-md flex flex-col max-h-[90vh]">
        <BbDialogHeader>
            <BbDialogTitle>Sửa sản phẩm</BbDialogTitle>
            <BbDialogDescription>Cập nhật thông tin sản phẩm.</BbDialogDescription>
        </BbDialogHeader>
        <div class="overflow-y-auto flex-1 space-y-3 py-4 pr-1">
            <div class="space-y-1">
                <label class="text-sm font-medium">Tên sản phẩm <span class="text-destructive">*</span></label>
                <BbInput @bind-Value="_formName" Placeholder="Tên sản phẩm" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium">Giá (đ) <span class="text-destructive">*</span></label>
                <BbInput @bind-Value="_formPriceStr" Type="InputType.Number" Placeholder="0" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium">Danh mục</label>
                <BbCombobox TValue="Guid?"
                            @bind-Value="_formCategoryId"
                            Options="CategoryOptions"
                            Placeholder="Chọn danh mục..."
                            SearchPlaceholder="Tìm danh mục..."
                            EmptyMessage="Không tìm thấy danh mục."
                            Class="w-full"
                            MatchTriggerWidth="true" />
                @if (_formCategoryId.HasValue)
                {
                    <p class="text-xs text-muted-foreground">Đã chọn: @GetCategoryDisplayName(_formCategoryId)</p>
                }
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium">Mô tả</label>
                <BbInput @bind-Value="_formDescription" Placeholder="Mô tả sản phẩm" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium">Hình ảnh</label>
                @if (HasImage)
                {
                    <img src="@DisplayImageUrl" class="w-full h-32 object-cover rounded-lg mb-2" alt="Product image" />
                }
                <InputFile OnChange="HandleImageSelected" accept="image/*" class="hidden" id="edit-product-img" />
                <label for="edit-product-img"
                       class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium shadow-sm hover:bg-accent hover:text-accent-foreground">
                    <LucideIcon Name="image" Class="h-4 w-4" />
                    <span>@(HasImage ? "Đổi ảnh" : "Chọn ảnh")</span>
                </label>
            </div>
        </div>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Hủy</BbButton>
            </BbDialogClose>
            <BbButton OnClick="HandleEdit"
                      Loading="@_saving" LoadingText="Đang lưu..."
                      Disabled="@(string.IsNullOrWhiteSpace(_formName) || !decimal.TryParse(_formPriceStr, out _))">
                Cập nhật
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<ProductDto> _items = [];
    private List<CategoryItem> _allCategories = [];
    private bool _loading, _saving;
    private int _skip, _take = 5, _total;
    private string _search = "";
    private Guid? _filterCategoryId;
    private string _filterPriceMin = "";
    private string _filterPriceMax = "";
    private string _sortOption = "name_asc";
    private string? _error;

    private bool _showCreate, _showEdit;
    private Guid? _editId;
    private string _formName = "";
    private string _formPriceStr = "";
    private Guid? _formCategoryId;
    private string _formDescription = "";
    private string _formImageUrl = "";
    private string? _imagePreviewUrl;
    private IBrowserFile? _pendingImage;
    private bool _uploadingImage;
    private string? DisplayImageUrl => _imagePreviewUrl ?? (string.IsNullOrEmpty(_formImageUrl) ? null : _formImageUrl);
    private bool HasImage => DisplayImageUrl is not null;
    private bool _showDeleteConfirm;
    private Guid? _pendingDeleteId;
    private HashSet<Guid> _selectedIds = [];
    private bool _showBulkDeleteConfirm;
    private bool _bulkDeleting;

    private bool AllSelected => _items.Count > 0 && _items.All(i => _selectedIds.Contains(i.Id));

    private void ToggleSelect(Guid id, bool selected)
    {
        if (selected) _selectedIds.Add(id);
        else _selectedIds.Remove(id);
        _ = PersistStateAsync();
    }

    private void ToggleSelectAll(bool selected)
    {
        _selectedIds = selected ? _items.Select(i => i.Id).ToHashSet() : [];
        _ = PersistStateAsync();
    }

    private void OpenBulkDeleteConfirm() => _showBulkDeleteConfirm = true;

    private async Task HandleBulkDelete()
    {
        _bulkDeleting = true;
        var ids = _selectedIds.ToList();
        var tasks = ids.Select(id => Client.DeleteProduct.ExecuteAsync(id));
        var results = await Task.WhenAll(tasks);
        _bulkDeleting = false;
        _showBulkDeleteConfirm = false;

        var deleted = results.Count(r => r.Data?.DeleteProduct == true);
        _selectedIds.Clear();

        if (deleted > 0)
        {
            ToastService.Success($"Đã xóa {deleted} sản phẩm.");
            await LoadAsync();
        }
        if (deleted < ids.Count)
            ToastService.Error($"{ids.Count - deleted} sản phẩm không thể xóa.");
    }

    private static readonly List<SelectOption<string>> SortOptions =
    [
        new("name_asc", "Tên A → Z"),
        new("name_desc", "Tên Z → A"),
        new("price_asc", "Giá tăng dần"),
        new("price_desc", "Giá giảm dần")
    ];

    private List<SelectOption<Guid?>> CategoryOptions =>
        [new SelectOption<Guid?>(null, "Không có"), .. _allCategories.Select(c => new SelectOption<Guid?>(c.Id, c.Name))];

    private List<SelectOption<Guid?>> FilterCategoryOptions =>
        [new SelectOption<Guid?>(null, "✕ Tất cả danh mục"), .. _allCategories.Select(c => new SelectOption<Guid?>(c.Id, c.Name))];

    protected override async Task OnInitializedAsync()
    {
        if (TryRestoreState())
        {
            _ = LoadCategoriesAsync(silent: true);
            return;
        }

        await Task.WhenAll(LoadCategoriesAsync(), LoadAsync(showLoading: true));
    }

    private bool TryRestoreState()
    {
        var cached = UiStateReader.GetState().Products;
        if (cached is null) return false;

        _search = cached.Search;
        _filterCategoryId = cached.FilterCategoryId;
        _skip = cached.Skip;
        _take = cached.Take;
        _total = cached.Total;
        _items = cached.Items.Select(i => new ProductDto(i.Id, i.Name, i.Price, i.Description, i.CategoryId, i.CategoryName, i.ImageUrl)).ToList();
        _allCategories = cached.Categories.Select(c => new CategoryItem(c.Id, c.Name)).ToList();
        _selectedIds = cached.SelectedIds.ToHashSet();
        return true;
    }

    private Task PersistStateAsync()
    {
        var snapshot = new ProductPageCache(
            _search,
            _filterCategoryId,
            _skip,
            _take,
            _total,
            _items.Select(i => new ProductListItem(i.Id, i.Name, i.Price, i.Description, i.CategoryId, i.CategoryName, i.ImageUrl)).ToList(),
            _allCategories.Select(c => new CategoryLookupItem(c.Id, c.Name)).ToList(),
            _selectedIds.ToList());

        return UiStateWriter.UpdateAsync(s => s with { Products = snapshot }, "cache.products");
    }

    private async Task LoadCategoriesAsync(bool silent = false)
    {
        try
        {
            _allCategories = await FetchAllCategoriesAsync();
            await PersistStateAsync();
        }
        catch (Exception ex)
        {
            if (!silent)
                ToastService.Warning($"Không tải được danh mục: {ex.Message}");
        }
    }

    private async Task EnsureCategoriesLoadedAsync(bool forceRefresh = false)
    {
        if (forceRefresh || _allCategories.Count == 0)
            await LoadCategoriesAsync(silent: true);
    }

    private async Task<List<CategoryItem>> FetchAllCategoriesAsync()
    {
        var pageSize = 100;
        const int minPageSize = 1;
        var skip = 0;
        var all = new List<CategoryItem>();

        while (true)
        {
            var result = await Client.GetCategories.ExecuteAsync(skip, pageSize, null, [new CategorySortInput { Name = SortEnumType.Asc }]);
            if (result.Data?.CategoriesOffset is { } data)
            {
                if (data.Items is { } cats)
                    all.AddRange(cats.Select(c => new CategoryItem(c.Id, c.Name)));

                if (data.PageInfo?.HasNextPage != true)
                    break;

                skip += pageSize;
                continue;
            }

            if (result.Errors.Count > 0)
            {
                var message = result.Errors[0].Message;
                if (IsPageSizeExceededError(message) && pageSize > minPageSize)
                {
                    pageSize = Math.Max(minPageSize, pageSize / 2);
                    continue;
                }

                throw new InvalidOperationException(message);
            }

            break;
        }

        return all
            .GroupBy(c => c.Id)
            .Select(g => g.First())
            .ToList();
    }

    private static bool IsPageSizeExceededError(string message)
        => message.Contains("maximum allowed items per page", StringComparison.OrdinalIgnoreCase)
           || message.Contains("items per page", StringComparison.OrdinalIgnoreCase)
           || message.Contains("page size", StringComparison.OrdinalIgnoreCase)
           || message.Contains("take", StringComparison.OrdinalIgnoreCase);

    private async Task LoadAsync(bool showLoading = false)
    {
        _loading = showLoading;
        _error = null;
        if (showLoading)
            StateHasChanged();
        try
        {
            var serverFilter = BuildServerFilter();
            var order = BuildOrder();

            if (_filterCategoryId.HasValue)
            {
                var allItems = await FetchAllProductsAsync(serverFilter, order);
                var filtered = allItems.Where(i => i.CategoryId == _filterCategoryId).ToList();

                _total = filtered.Count;
                if (_skip >= _total && _total > 0)
                    _skip = Math.Max(0, ((_total - 1) / _take) * _take);

                _items = filtered.Skip(_skip).Take(_take).ToList();
                await PersistStateAsync();
            }
            else
            {
                var result = await Client.GetProducts.ExecuteAsync(_skip, _take, serverFilter, order);
                if (result.Data?.Products is { } data)
                {
                    _items = data.Items?.Select(i => new ProductDto(
                        i.Id, i.Name, i.Price, i.Description, i.CategoryId, i.Category?.Name, i.ImageUrl
                    )).ToList() ?? [];
                    _total = data.TotalCount;
                    await PersistStateAsync();
                }
                else if (result.Errors.Count > 0)
                    _error = GraphQLErrorFormatter.Format(result.Errors, "Không tải được sản phẩm.");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private ProductFilterInput? BuildServerFilter()
    {
        var hasSearch = !string.IsNullOrWhiteSpace(_search);
        var hasPriceMin = decimal.TryParse(_filterPriceMin, out var minPrice);
        var hasPriceMax = decimal.TryParse(_filterPriceMax, out var maxPrice);

        if (!hasSearch && !hasPriceMin && !hasPriceMax)
            return null;

        DecimalOperationFilterInput? priceFilter = null;
        if (hasPriceMin || hasPriceMax)
        {
            priceFilter = new DecimalOperationFilterInput
            {
                Gte = hasPriceMin ? minPrice : null,
                Lte = hasPriceMax ? maxPrice : null
            };
        }

        return new ProductFilterInput
        {
            Or = hasSearch
                ?
                [
                    new ProductFilterInput { Name = new StringOperationFilterInput { Contains = _search } },
                    new ProductFilterInput { Description = new StringOperationFilterInput { Contains = _search } }
                ]
                : null,
            Price = priceFilter
        };
    }

    private async Task<List<ProductDto>> FetchAllProductsAsync(ProductFilterInput? filter, IReadOnlyList<ProductSortInput>? order)
    {
        var pageSize = 100;
        const int minPageSize = 1;
        var skip = 0;
        var all = new List<ProductDto>();

        while (true)
        {
            var result = await Client.GetProducts.ExecuteAsync(skip, pageSize, filter, order);
            if (result.Data?.Products is { } data)
            {
                if (data.Items is { } items)
                {
                    all.AddRange(items.Select(i => new ProductDto(
                        i.Id,
                        i.Name,
                        i.Price,
                        i.Description,
                        i.CategoryId,
                        i.Category?.Name,
                        i.ImageUrl)));
                }

                if (data.PageInfo?.HasNextPage != true)
                    break;

                skip += pageSize;
                continue;
            }

            if (result.Errors.Count > 0)
            {
                var message = result.Errors[0].Message;
                if (IsPageSizeExceededError(message) && pageSize > minPageSize)
                {
                    pageSize = Math.Max(minPageSize, pageSize / 2);
                    continue;
                }

                throw new InvalidOperationException(GraphQLErrorFormatter.Format(result.Errors, "Không tải được sản phẩm."));
            }

            break;
        }

        return all
            .GroupBy(i => i.Id)
            .Select(g => g.First())
            .ToList();
    }

    private IReadOnlyList<ProductSortInput>? BuildOrder()
    {
        var sort = new ProductSortInput();
        switch (_sortOption)
        {
            case "name_desc":
                sort.Name = SortEnumType.Desc;
                break;
            case "price_asc":
                sort.Price = SortEnumType.Asc;
                break;
            case "price_desc":
                sort.Price = SortEnumType.Desc;
                break;
            default:
                sort.Name = SortEnumType.Asc;
                break;
        }

        return [sort];
    }

    private bool MatchesCurrentFilter(Guid id, string name, decimal price, string? description, Guid? categoryId)
    {
        var textMatches = string.IsNullOrWhiteSpace(_search)
            || name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
        var categoryMatches = !_filterCategoryId.HasValue || categoryId == _filterCategoryId;
        var priceMinMatches = !decimal.TryParse(_filterPriceMin, out var minPrice) || price >= minPrice;
        var priceMaxMatches = !decimal.TryParse(_filterPriceMax, out var maxPrice) || price <= maxPrice;
        return textMatches && categoryMatches && priceMinMatches && priceMaxMatches;
    }

    private int CurrentPage => (_skip / _take) + 1;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_total / (double)_take));
    private IEnumerable<int> VisiblePages
    {
        get
        {
            if (TotalPages <= 7)
                return Enumerable.Range(1, TotalPages);

            var start = Math.Max(1, CurrentPage - 2);
            var end = Math.Min(TotalPages, start + 4);
            start = Math.Max(1, end - 4);
            return Enumerable.Range(start, end - start + 1);
        }
    }

    private async Task GoToPageAsync(int page)
    {
        var targetPage = Math.Clamp(page, 1, TotalPages);
        _skip = (targetPage - 1) * _take;
        await LoadAsync();
    }

    private async Task OpenCreateAsync()
    {
        await EnsureCategoriesLoadedAsync(forceRefresh: true);
        if (_allCategories.Count == 0)
            ToastService.Warning("Chưa có danh mục để chọn. Vui lòng tạo danh mục trước.");

        _editId = null;
        _formName = "";
        _formPriceStr = "";
        _formCategoryId = null;
        _formDescription = "";
        ResetImageForm();
        _showCreate = true;
    }
    private void CloseCreate() => _showCreate = false;
    private void CloseEdit() => _showEdit = false;

    private async Task OpenEditAsync(ProductDto item)
    {
        await EnsureCategoriesLoadedAsync(forceRefresh: true);
        if (_allCategories.Count == 0)
            ToastService.Warning("Chưa có danh mục để chọn. Vui lòng tạo danh mục trước.");

        _editId = item.Id;
        _formName = item.Name;
        _formPriceStr = item.Price.ToString();
        _formCategoryId = item.CategoryId;
        _formDescription = item.Description ?? "";
        _pendingImage = null;
        _imagePreviewUrl = null;
        _formImageUrl = item.ImageUrl ?? "";
        _showEdit = true;
    }

    private string GetCategoryDisplayName(Guid? categoryId)
    {
        if (!categoryId.HasValue) return "Không có";
        return _allCategories.FirstOrDefault(c => c.Id == categoryId.Value)?.Name ?? "(Không tìm thấy danh mục)";
    }

    private string? GetCategoryName(Guid? categoryId)
    {
        if (!categoryId.HasValue) return null;
        return _allCategories.FirstOrDefault(c => c.Id == categoryId.Value)?.Name;
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        _pendingImage = e.File;
        // Create a local data URL for preview without uploading
        var buffer = new byte[e.File.Size];
        await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        await stream.ReadExactlyAsync(buffer);
        _imagePreviewUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }

    private async Task<string?> UploadPendingImageAsync(string folder)
    {
        if (_pendingImage is null) return null;
        _uploadingImage = true;
        StateHasChanged();
        var url = await ImageUploadSvc.UploadAsync(_pendingImage, folder);
        _uploadingImage = false;
        _pendingImage = null;
        _imagePreviewUrl = null;
        if (url is null) ToastService.Error("Tải ảnh thất bại.");
        return url;
    }

    private void ResetImageForm()
    {
        _pendingImage = null;
        _imagePreviewUrl = null;
        _formImageUrl = "";
    }

    private async Task HandleCreate()
    {
        if (!decimal.TryParse(_formPriceStr, out var price)) return;
        _saving = true;

        // Upload pending image if any
        var uploadedUrl = await UploadPendingImageAsync("products");
        var imageUrl = uploadedUrl ?? (string.IsNullOrEmpty(_formImageUrl) ? null : _formImageUrl);

        var desc = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription;
        var result = await Client.CreateProduct.ExecuteAsync(_formName, price, _formCategoryId, desc, imageUrl);
        _saving = false;
        if (result.Data?.CreateProduct is { } created)
        {
            _showCreate = false;
            ToastService.Success("Đã thêm sản phẩm.");

            if (MatchesCurrentFilter(created.Id, created.Name, created.Price, created.Description, created.CategoryId))
            {
                _total++;
                _items.Insert(0, new ProductDto(
                    created.Id,
                    created.Name,
                    created.Price,
                    created.Description,
                    created.CategoryId,
                    GetCategoryName(created.CategoryId),
                    created.ImageUrl));
                if (_items.Count > _take)
                    _items.RemoveAt(_items.Count - 1);
            }
            await PersistStateAsync();
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private async Task HandleEdit()
    {
        if (!decimal.TryParse(_formPriceStr, out var price)) return;
        _saving = true;

        // Upload pending image if any
        var uploadedUrl = await UploadPendingImageAsync("products");
        var imageUrl = uploadedUrl ?? (string.IsNullOrEmpty(_formImageUrl) ? null : _formImageUrl);

        var desc = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription;
        var result = await Client.UpdateProduct.ExecuteAsync(_editId!.Value, _formName, price, _formCategoryId, desc, imageUrl);
        _saving = false;
        if (result.Data?.UpdateProduct is { } updated)
        {
            _showEdit = false;
            ToastService.Success("Đã cập nhật sản phẩm.");

            var index = _items.FindIndex(x => x.Id == updated.Id);
            if (index >= 0)
            {
                if (MatchesCurrentFilter(updated.Id, updated.Name, updated.Price, updated.Description, updated.CategoryId))
                {
                    _items[index] = new ProductDto(
                        updated.Id,
                        updated.Name,
                        updated.Price,
                        updated.Description,
                        updated.CategoryId,
                        GetCategoryName(updated.CategoryId),
                        updated.ImageUrl);
                    await PersistStateAsync();
                }
                else
                {
                    _items.RemoveAt(index);
                    _total = Math.Max(0, _total - 1);
                    if (_items.Count == 0 && _skip > 0 && _total > 0)
                    {
                        _skip = Math.Max(0, _skip - _take);
                        await LoadAsync();
                    }
                    await PersistStateAsync();
                }
            }
            else
            {
                await LoadAsync();
            }
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private void OpenDeleteConfirm(Guid id)
    {
        _pendingDeleteId = id;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (!_pendingDeleteId.HasValue)
            return;

        _showDeleteConfirm = false;
        var id = _pendingDeleteId.Value;
        _pendingDeleteId = null;
        await HandleDelete(id);
    }

    private async Task HandleDelete(Guid id)
    {
        var result = await Client.DeleteProduct.ExecuteAsync(id);
        if (result.Data?.DeleteProduct == true)
        {
            ToastService.Success("Đã xóa sản phẩm.");
            var index = _items.FindIndex(x => x.Id == id);
            if (index >= 0)
            {
                _items.RemoveAt(index);
                _total = Math.Max(0, _total - 1);

                if (_items.Count == 0 && _skip > 0 && _total > 0)
                    _skip = Math.Max(0, _skip - _take);

                if ((_items.Count < _take && _total > _items.Count) || (_items.Count == 0 && _total > 0))
                    await LoadAsync();
                else
                    await PersistStateAsync();
            }
            else
            {
                await LoadAsync();
            }
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private record CategoryItem(Guid Id, string Name);
    private record ProductDto(Guid Id, string Name, decimal Price, string? Description, Guid? CategoryId, string? CategoryName, string? ImageUrl = null);
}
