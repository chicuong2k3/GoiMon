@page "/orders"
@inherits StoreComponentWithUtilities<OrdersUiState>
@inject IGoiMonClient Client
@inject ToastService ToastService
@inject IStateWriter<OrdersUiState> UiStateWriter
@inject IJSRuntime JS
@implements IAsyncDisposable

@using EasyAppDev.Blazor.Store.Core
@using GoiMon.Client.State
@using GoiMon.Client.Features.Orders.Components
@using System.Globalization

<header class="flex h-12 shrink-0 items-center gap-2 border-b px-4 py-1 md:px-5">
    <BbSidebarTrigger />
    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="h-3" />
    <h1 class="text-[10px] font-semibold">Quản lý đơn hàng</h1>
    <span class="ml-2 flex items-center gap-1 text-xs text-emerald-600 font-medium">
        <span class="h-2 w-2 rounded-full bg-emerald-500 inline-block"></span>
        Trực tuyến
    </span>
</header>

<div class="flex flex-1 overflow-hidden p-4 md:p-5 h-[calc(100vh-3.5rem)]">

    <div class="flex flex-col rounded-lg border bg-background overflow-hidden w-full min-w-0">
        <div class="border-b bg-background px-4 md:px-5 py-3 space-y-3">
            <div class="space-y-2">
                <BbInput Value="@_searchKeyword"
                         ValueChanged="OnSearchKeywordChangedAsync"
                         Placeholder="Tìm mã đơn hoặc món..." />
                <p class="text-xs text-muted-foreground">Tự động cập nhật theo thời gian thực</p>
            </div>
            <div class="mb-1 flex flex-wrap items-center gap-2">
                <BbButton Variant="@(TabVariant("open"))" Size="ButtonSize.Small" OnClick="SetOpenTab">
                    Đang xử lý
                    <span class="ml-1 text-xs text-muted-foreground">@_tabCounts.GetValueOrDefault("open", 0)</span>
                </BbButton>
                <BbButton Variant="@(TabVariant("completed"))" Size="ButtonSize.Small" OnClick="SetCompletedTab">
                    Chờ thanh toán
                    <span class="ml-1 text-xs text-muted-foreground">@_tabCounts.GetValueOrDefault("completed", 0)</span>
                </BbButton>
                <BbButton Variant="@(TabVariant("paid"))" Size="ButtonSize.Small" OnClick="SetPaidTab">
                    Đã thanh toán
                    <span class="ml-1 text-xs text-muted-foreground">@_tabCounts.GetValueOrDefault("paid", 0)</span>
                </BbButton>
                <BbButton Variant="@(TabVariant("cancelled"))" Size="ButtonSize.Small" OnClick="SetCancelledTab">
                    Đã hủy
                    <span class="ml-1 text-xs text-muted-foreground">@_tabCounts.GetValueOrDefault("cancelled", 0)</span>
                </BbButton>
            </div>
        </div>

        @if (_loading)
        {
            <div class="px-4 md:px-5 py-4 space-y-2 flex-1 overflow-y-auto">
                <BbSkeleton Height="52px" Class="w-full" />
                <BbSkeleton Height="52px" Class="w-full" />
                <BbSkeleton Height="52px" Class="w-full" />
                <BbSkeleton Height="52px" Class="w-full" />
                <BbSkeleton Height="52px" Class="w-full" />
            </div>
        }
        else if (_error is not null)
        {
            <div class="px-4 md:px-5 py-4">
                <BbAlert Variant="AlertVariant.Danger">
                    <BbAlertDescription>@_error</BbAlertDescription>
                </BbAlert>
            </div>
        }
        else
        {
            <div class="flex-1 overflow-y-auto" @ref="_orderListRef" @onscroll="OnOrderListScrollAsync">
                <table class="w-full text-sm">
                    <thead class="border-b bg-muted/40 sticky top-0">
                        <tr>
                            <th class="h-9 px-4 text-left text-xs font-semibold text-muted-foreground tracking-wider uppercase align-middle">Mã đơn</th>
                            <th class="h-9 px-4 text-left text-xs font-semibold text-muted-foreground tracking-wider uppercase align-middle">Trạng thái</th>
                            <th class="h-9 px-4 text-left text-xs font-semibold text-muted-foreground tracking-wider uppercase align-middle">Thời gian</th>
                            <th class="h-9 px-4 text-right text-xs font-semibold text-muted-foreground tracking-wider uppercase align-middle">Tổng</th>
                            <th class="h-9 px-4 text-left text-xs font-semibold text-muted-foreground tracking-wider uppercase align-middle">Món ăn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredOrders.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="py-12 text-center text-muted-foreground text-sm">
                                    <LucideIcon Name="inbox" Class="h-8 w-8 mx-auto mb-2 text-muted-foreground/50" />
                                    Không tìm thấy đơn phù hợp
                                </td>
                            </tr>
                        }
                        @foreach (var order in FilteredOrders)
                        {
                            <tr class="@RowCls(order.Id)" @onclick="() => SelectOrder(order)">
                                <td class="px-4 py-3 font-semibold text-primary whitespace-nowrap align-middle">
                                    #GM-@ShortId(order.Id)
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap align-middle">
                                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium @StatusPillClass(order.Status)">
                                        @StatusText(order.Status)
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-muted-foreground whitespace-nowrap align-middle">
                                    @FormatTime(order.CreatedAt)
                                </td>
                                <td class="px-4 py-3 text-right whitespace-nowrap font-medium align-middle">
                                    @FormatCurrency(order.Total)
                                </td>
                                <td class="px-4 py-3 text-muted-foreground max-w-[180px] truncate align-middle">
                                    @ItemsSummary(order)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_loadingMore)
                {
                    <div class="px-4 md:px-5 py-3 space-y-2">
                        <BbSkeleton Height="40px" Class="w-full" />
                        <BbSkeleton Height="40px" Class="w-full" />
                    </div>
                }
                else if (!_hasNextPage && _orders.Count > 0)
                {
                    <p class="py-3 text-center text-xs text-muted-foreground">Đã tải hết đơn hàng</p>
                }
            </div>
        }
    </div>
</div>

@if (_selectedOrder is not null)
{
    <div class="fixed inset-0 z-50" @onclick="CloseDetail">
        <div class="absolute inset-0 bg-black/30"></div>
        <div class="absolute inset-y-0 right-0 w-full max-w-xl bg-background border-l shadow-xl flex flex-col"
             @onclick:stopPropagation="true">
            <OrderDetailPanel
                Order="_selectedOrder"
                ActionLoading="_actionLoading"
                ActionType="CurrentActionType"
                OnClose="CloseDetail"
                OnComplete="CompleteOrderAsync"
                OnCancel="CancelOrderAsync"
                OnPay="PayOrderAsync"
                OnSetPreparing="SetPreparingAsync"
                OnSetReadyToServe="SetReadyToServeAsync"
                OnSetAwaitingPayment="SetAwaitingPaymentAsync" />
        </div>
    </div>
}

@code {
    private static readonly CultureInfo VnCulture = CultureInfo.GetCultureInfo("vi-VN");

    private static string FormatCurrency(decimal amount)
        => string.Concat(amount.ToString("N0", VnCulture), "đ");

    private List<OrderListItem> _orders = new();
    private string _activeTab = "open";
    private Guid? _selectedId;
    private OrderListItem? _selectedOrder;
    private bool _loading;
    private bool _loadingMore;
    private bool _actionLoading;
    private string? _actionType;
    private string? CurrentActionType => _actionType;
    private string _searchKeyword = string.Empty;
    private string? _error;
    private bool _hasNextPage = true;
    private string? _endCursor;
    private const int OrdersPageSize = 30;
    private ElementReference _orderListRef;
    private IDisposable? _orderChangedSubscription;
    private DateTimeOffset _nextCountRefreshAt = DateTimeOffset.MinValue;

    private readonly Dictionary<string, int> _tabCounts = new()
    {
        ["open"] = 0,
        ["completed"] = 0,
        ["paid"] = 0,
        ["cancelled"] = 0,
    };

    private IReadOnlyList<OrderListItem> FilteredOrders
        => string.IsNullOrWhiteSpace(_searchKeyword)
            ? _orders
            : _orders.Where(MatchesSearch).ToList();

    protected override async Task OnInitializedAsync()
    {
        var cached = State.Cache;
        if (cached is not null)
        {
            _orders = cached.Items.ToList();
            _activeTab = cached.ActiveTab;
            _selectedId = cached.SelectedOrderId;
            _selectedOrder = _orders.FirstOrDefault(o => o.Id == _selectedId);
            _tabCounts[_activeTab] = _orders.Count;
        }

        StartRealtimeSubscription();

        if (_orders.Count == 0)
        {
            await ReloadFromStartAsync();
        }
        else
        {
            _ = ReloadFromStartAsync(showLoading: false);
        }
    }

    private async Task ReloadFromStartAsync(bool showLoading = true)
    {
        _loading = showLoading;
        _error = null;
        try
        {
            _orders.Clear();
            _endCursor = null;
            _hasNextPage = true;

            await LoadNextPageAsync();
            await RefreshTabCountsAsync();

            if (_selectedId.HasValue)
                _selectedOrder = _orders.FirstOrDefault(o => o.Id == _selectedId);

            await PersistState();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadNextPageAsync()
    {
        if (!_hasNextPage || _loadingMore)
            return;

        _loadingMore = true;
        try
        {
            var result = await Client.GetOrders.ExecuteAsync(
                first: OrdersPageSize,
                after: _endCursor,
                where: BuildFilterForTab(_activeTab));

            if (result.Data?.Orders is { } data)
            {
                if (data.Nodes is { } nodes)
                {
                    _orders.AddRange(nodes.Select(n => new OrderListItem(
                        n.Id,
                        n.TableSlotId,
                        NormalizeStatus(n.Status.ToString()),
                        (decimal)n.Total,
                        n.CreatedAt,
                        n.Items.Select(i => new OrderItemSnapshot(
                            i.Id,
                            i.ProductName,
                            i.UnitName,
                            i.ComboId,
                            i.ComboName,
                            i.Qty,
                            (decimal)i.UnitPrice,
                            i.Modifiers.Select(m => new OrderItemModifierSnapshot(
                                m.Id,
                                m.GroupName,
                                m.OptionName,
                                m.Qty,
                                (decimal)m.UnitDeltaPrice)).ToList())).ToList())));
                }

                _hasNextPage = data.PageInfo?.HasNextPage == true;
                _endCursor = data.PageInfo?.EndCursor;
                _tabCounts[_activeTab] = data.TotalCount;
                await PersistState();
                return;
            }

            if (result.Errors.Count > 0)
                throw new InvalidOperationException(result.Errors[0].Message);
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task OnOrderListScrollAsync(EventArgs _)
    {
        if (_loading || _loadingMore || !_hasNextPage)
            return;

        await ThrottleManager.Throttle(
            "orders.scroll.load-next",
            async () =>
            {
                var metrics = await JS.InvokeAsync<ScrollMetrics>("ordersScroll.getMetrics", _orderListRef);
                if (metrics.ScrollTop + metrics.ClientHeight >= metrics.ScrollHeight - 80)
                {
                    await LoadNextPageAsync();
                    await InvokeAsync(StateHasChanged);
                }
            },
            100,
            leading: true);
    }

    private async Task RefreshTabCountsAsync()
    {
        _tabCounts["open"] = await GetTabTotalCountAsync("open");
        _tabCounts["completed"] = await GetTabTotalCountAsync("completed");
        _tabCounts["paid"] = await GetTabTotalCountAsync("paid");
        _tabCounts["cancelled"] = await GetTabTotalCountAsync("cancelled");
    }

    private async Task<int> GetTabTotalCountAsync(string tab)
    {
        var cacheKey = $"orders.tab.count.{tab}";
        return await LazyCache.GetOrLoadAsync(
            cacheKey,
            async () =>
            {
                var result = await Client.GetOrders.ExecuteAsync(first: 1, after: null, where: BuildFilterForTab(tab));
                if (result.Data?.Orders is { } data)
                    return data.TotalCount;
                return 0;
            },
            TimeSpan.FromSeconds(10));
    }

    private async Task SetTab(string tab)
    {
        if (_activeTab == tab)
            return;

        _activeTab = tab;
        _selectedId = null;
        _selectedOrder = null;
        await ReloadFromStartAsync();
    }

    private Task SetOpenTab() => SetTab("open");
    private Task SetCompletedTab() => SetTab("completed");
    private Task SetPaidTab() => SetTab("paid");
    private Task SetCancelledTab() => SetTab("cancelled");

    private Task OnSearchKeywordChangedAsync(string value)
    {
        _searchKeyword = value;
        return InvokeAsync(StateHasChanged);
    }

    private async Task SelectOrder(OrderListItem order)
    {
        _selectedId = order.Id;
        _selectedOrder = order;
        await PersistState();
    }

    private async Task CloseDetail()
    {
        _selectedId = null;
        _selectedOrder = null;
        await PersistState();
    }

    private async Task CompleteOrderAsync()
    {
        if (_selectedOrder is null) return;

        _actionLoading = true;
        _actionType = "complete";
        try
        {
            var result = await Client.CompleteOrder.ExecuteAsync(_selectedOrder.Id);
            if (result.IsErrorResult())
            {
                ToastService.Error(result.Errors.FirstOrDefault()?.Message ?? "Không thể hoàn thành đơn hàng");
                return;
            }

            ToastService.Success("Đơn hàng đã hoàn thành");
            _selectedId = null;
            _selectedOrder = null;
            await ReloadFromStartAsync(showLoading: false);
        }
        finally
        {
            _actionLoading = false;
            _actionType = null;
        }
    }

    private async Task CancelOrderAsync()
    {
        if (_selectedOrder is null) return;

        _actionLoading = true;
        _actionType = "cancel";
        try
        {
            var result = await Client.CancelOrder.ExecuteAsync(_selectedOrder.Id);
            if (result.IsErrorResult())
            {
                ToastService.Error(result.Errors.FirstOrDefault()?.Message ?? "Không thể huỷ đơn hàng");
                return;
            }

            ToastService.Success("Đơn hàng đã huỷ");
            _selectedId = null;
            _selectedOrder = null;
            await ReloadFromStartAsync(showLoading: false);
        }
        finally
        {
            _actionLoading = false;
            _actionType = null;
        }
    }

    private async Task PayOrderAsync()
    {
        if (_selectedOrder is null) return;

        _actionLoading = true;
        _actionType = "pay";
        try
        {
            var result = await Client.MarkOrderPaid.ExecuteAsync(_selectedOrder.Id);
            if (result.IsErrorResult())
            {
                ToastService.Error(result.Errors.FirstOrDefault()?.Message ?? "Không thể thanh toán đơn hàng");
                return;
            }

            ToastService.Success("Đơn hàng đã thanh toán");
            _selectedId = null;
            _selectedOrder = null;
            await ReloadFromStartAsync(showLoading: false);
        }
        finally
        {
            _actionLoading = false;
            _actionType = null;
        }
    }

    private Task SetPreparingAsync()
        => SetTableStateForSelectedAsync(TableServiceState.Preparing, "preparing", "Bàn chuyển sang Đang chuẩn bị");

    private Task SetReadyToServeAsync()
        => SetTableStateForSelectedAsync(TableServiceState.ReadyToServe, "ready", "Bàn chuyển sang Sẵn sàng phục vụ");

    private Task SetAwaitingPaymentAsync()
        => SetTableStateForSelectedAsync(TableServiceState.AwaitingPayment, "awaiting", "Bàn chuyển sang Chờ thanh toán");

    private async Task SetTableStateForSelectedAsync(TableServiceState state, string actionType, string successMessage)
    {
        if (_selectedOrder?.TableSlotId is null)
        {
            ToastService.Error("Đơn hàng chưa gắn bàn phục vụ.");
            return;
        }

        _actionLoading = true;
        _actionType = actionType;
        try
        {
            var input = new SetTableStateInput
            {
                Id = _selectedOrder.TableSlotId.Value,
                State = state
            };

            var result = await Client.SetTableState.ExecuteAsync(input);
            if (result.IsErrorResult() || result.Data?.SetTableState is null)
            {
                ToastService.Error(GraphQLErrorFormatter.Format(result.Errors, "Không thể cập nhật trạng thái bàn"));
                return;
            }

            ToastService.Success(successMessage);
        }
        finally
        {
            _actionLoading = false;
            _actionType = null;
        }
    }

    private async Task PersistState()
    {
        await DebounceManager.Debounce(
            "orders.persist",
            async () =>
            {
                await UiStateWriter.UpdateAsync(s => s with
                {
                    Cache = new OrderPageState(_activeTab, _selectedId, _orders)
                }, "cache.orders");
            },
            250);
    }

    private static OrderFilterInput BuildFilterForTab(string tab)
        => tab switch
        {
            "open" => new OrderFilterInput
            {
                Status = new OrderStatusOperationFilterInput { Eq = OrderStatus.Open }
            },
            "completed" => new OrderFilterInput
            {
                Status = new OrderStatusOperationFilterInput { Eq = OrderStatus.Completed }
            },
            "paid" => new OrderFilterInput
            {
                Status = new OrderStatusOperationFilterInput { Eq = OrderStatus.Paid }
            },
            "cancelled" => new OrderFilterInput
            {
                Status = new OrderStatusOperationFilterInput { Eq = OrderStatus.Cancelled }
            },
            _ => new OrderFilterInput
            {
                Status = new OrderStatusOperationFilterInput { Eq = OrderStatus.Open }
            }
        };

    private static string NormalizeStatus(string status)
        => status.Trim().ToUpperInvariant();

    private void StartRealtimeSubscription()
    {
        _orderChangedSubscription?.Dispose();
        _orderChangedSubscription = Client.OnOrderChanged
            .Watch()
            .Subscribe(result =>
            {
                if (!result.IsErrorResult() && result.Data?.OnOrderChanged is { } changed)
                {
                    _ = ThrottleManager.Throttle(
                        "orders.realtime.merge",
                        async () =>
                        {
                            await InvokeAsync(() =>
                            {
                                MergeRealtimeOrder(changed);

                                if (DateTimeOffset.UtcNow >= _nextCountRefreshAt)
                                {
                                    _nextCountRefreshAt = DateTimeOffset.UtcNow.AddSeconds(10);
                                    _ = RefreshTabCountsAsync();
                                }

                                StateHasChanged();
                                return Task.CompletedTask;
                            });
                        },
                        200,
                        leading: true);
                }
            });
    }

    private void MergeRealtimeOrder(IOnOrderChanged_OnOrderChanged changed)
    {
        var mapped = new OrderListItem(
            changed.Id,
            changed.TableSlotId,
            NormalizeStatus(changed.Status.ToString()),
            changed.Total,
            changed.CreatedAt,
            changed.Items.Select(i => new OrderItemSnapshot(
                i.Id,
                i.ProductName,
                i.UnitName,
                i.ComboId,
                i.ComboName,
                i.Qty,
                i.UnitPrice,
                i.Modifiers.Select(m => new OrderItemModifierSnapshot(
                    m.Id,
                    m.GroupName,
                    m.OptionName,
                    m.Qty,
                    m.UnitDeltaPrice)).ToList())).ToList());

        var existingIndex = _orders.FindIndex(o => o.Id == mapped.Id);
        var shouldAppearInCurrentTab = OrderInCurrentTab(mapped.Status);

        if (existingIndex >= 0)
        {
            if (shouldAppearInCurrentTab)
                _orders[existingIndex] = mapped;
            else
                _orders.RemoveAt(existingIndex);
        }
        else if (shouldAppearInCurrentTab)
        {
            _orders.Insert(0, mapped);
            if (_orders.Count > OrdersPageSize)
                _orders.RemoveAt(_orders.Count - 1);
        }

        _selectedOrder = _selectedId.HasValue
            ? _orders.FirstOrDefault(o => o.Id == _selectedId)
            : null;

        _tabCounts[_activeTab] = _orders.Count;
        _ = PersistState();
    }

    private bool OrderInCurrentTab(string normalizedStatus)
        => _activeTab switch
        {
            "open" => normalizedStatus == "OPEN",
            "completed" => normalizedStatus == "COMPLETED",
            "paid" => normalizedStatus == "PAID",
            "cancelled" => normalizedStatus == "CANCELLED",
            _ => normalizedStatus == "OPEN"
        };

    private ButtonVariant TabVariant(string tab)
        => _activeTab == tab ? ButtonVariant.Default : ButtonVariant.Outline;

    private string RowCls(Guid id)
    {
        var selected = _selectedId == id;
        return selected
            ? "border-b last:border-0 cursor-pointer transition-colors bg-primary/5 border-l-2 border-l-primary"
            : "border-b last:border-0 cursor-pointer transition-colors hover:bg-muted/40";
    }

    private static string ItemsSummary(OrderListItem order)
    {
        var parts = order.Items.Take(3).Select(i => i.ProductName + " x" + i.Qty);
        var summary = string.Join(", ", parts);
        if (order.Items.Count > 3) summary += "...";
        return summary;
    }

    private bool MatchesSearch(OrderListItem order)
    {
        var term = _searchKeyword.Trim();
        if (string.IsNullOrWhiteSpace(term))
            return true;

        if (ShortId(order.Id).Contains(term, StringComparison.OrdinalIgnoreCase))
            return true;

        return order.Items.Any(item =>
            item.ProductName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(item.ComboName) && item.ComboName.Contains(term, StringComparison.OrdinalIgnoreCase)));
    }

    private static string StatusText(string normalizedStatus)
        => normalizedStatus switch
        {
            "OPEN" => "ĐANG XỬ LÝ",
            "COMPLETED" => "CHỜ THANH TOÁN",
            "PAID" => "ĐÃ THANH TOÁN",
            "CANCELLED" => "ĐÃ HỦY",
            _ => normalizedStatus
        };

    private static string StatusPillClass(string normalizedStatus)
        => normalizedStatus switch
        {
            "OPEN" => "bg-amber-100 text-amber-800 border-amber-200",
            "COMPLETED" => "bg-green-100 text-green-800 border-green-200",
            "PAID" => "bg-blue-100 text-blue-800 border-blue-200",
            "CANCELLED" => "bg-red-100 text-red-800 border-red-200",
            _ => "bg-muted text-muted-foreground border-border"
        };

    private static string FormatTime(DateTimeOffset dt)
        => dt.ToLocalTime().ToString("HH:mm");

    private static string ShortId(Guid id)
        => id.ToString("N")[..4].ToUpper();

    public ValueTask DisposeAsync()
    {
        _orderChangedSubscription?.Dispose();
        _orderChangedSubscription = null;
        return ValueTask.CompletedTask;
    }

    private sealed record ScrollMetrics(double ScrollTop, double ClientHeight, double ScrollHeight);
}
