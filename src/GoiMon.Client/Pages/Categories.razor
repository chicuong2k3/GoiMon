@page "/categories"
@inherits StoreComponentWithUtilities<CategoriesUiState>
@inject IGoiMonClient Client
@inject ToastService ToastService
@inject IStateWriter<CategoriesUiState> UiStateWriter

@using EasyAppDev.Blazor.Store.Core
@using GoiMon.Client.State

<header class="flex h-12 shrink-0 items-center gap-2 border-b px-4 py-1 md:px-5">
    <BbSidebarTrigger />
    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="h-3" />
    <h1 class="text-xs font-semibold">Danh mục</h1>
    <div class="ml-auto flex items-center gap-2">
        @if (_selectedIds.Count > 0)
        {
            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                      OnClick="OpenBulkDeleteConfirmAsync">
                <LucideIcon Name="trash-2" Class="h-4 w-4 mr-1" />
                Xóa (@_selectedIds.Count)
            </BbButton>
        }
        <BbButton OnClick="OpenCreateAsync" Size="ButtonSize.Small">
            <LucideIcon Name="plus" Class="h-4 w-4 mr-1" />
            Thêm danh mục
        </BbButton>
    </div>
</header>

<div class="p-4 md:p-5 space-y-4">
    <div class="mb-1 flex flex-wrap items-center gap-3">
        <div class="w-72">
            <BbInput Value="@_search"
                     ValueChanged="OnSearchChangedAsync"
                     Placeholder="Tìm kiếm danh mục..." />
        </div>
        <div class="w-56">
            <BbSelect TValue="string"
                      Value="@_sortOption"
                      ValueChanged="OnSortChangedAsync"
                      Options="SortOptions"
                      Placeholder="Sắp xếp"
                      Class="w-full" />
        </div>
    </div>

    @if (_loading)
    {
        <div class="space-y-2">
            @for (int i = 0; i < 5; i++)
            {
                <BbSkeleton Height="48px" Class="w-full" />
            }
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-md border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            @_error
        </div>
    }
    else
    {
        <div class="rounded-md border">
            <table class="w-full text-sm">
                <thead class="border-b bg-muted/50">
                    <tr>
                        <th class="h-10 w-10 px-3 align-middle">
                            <BbCheckbox Checked="@AllSelected" CheckedChanged="@ToggleSelectAll" />
                        </th>
                        <th class="h-10 px-4 text-left font-medium text-muted-foreground align-middle">Tên danh mục</th>
                        <th class="h-10 px-4 text-right font-medium text-muted-foreground w-32 align-middle">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="p-8 text-center text-muted-foreground">
                                Không tìm thấy danh mục nào.
                            </td>
                        </tr>
                    }
                    @foreach (var item in _items)
                    {
                        <tr class="border-b last:border-0 hover:bg-muted/50 transition-colors @(_selectedIds.Contains(item.Id) ? "bg-muted/30" : "")">
                            <td class="px-3 py-3 align-middle">
                                <BbCheckbox Checked="@_selectedIds.Contains(item.Id)"
                                            CheckedChanged="@(v => ToggleSelect(item.Id, v))" />
                            </td>
                            <td class="px-4 py-3 font-medium align-middle">@item.Name</td>
                            <td class="px-4 py-3 text-right align-middle">
                                <div class="flex items-center justify-end gap-1">
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Sửa" OnClick="() => OpenEditAsync(item)">
                                        <LucideIcon Name="pencil" Class="h-4 w-4" />
                                    </BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Xóa" Class="text-destructive hover:text-destructive hover:bg-destructive/10"
                                              OnClick="() => OpenDeleteConfirmAsync(item.Id)">
                                        <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                    </BbButton>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pt-1 flex items-center justify-between text-sm text-muted-foreground">
            <span>Hiển thị @(_items.Count) / @_total danh mục</span>
            <div class="flex items-center gap-2">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          Disabled="@(CurrentPage <= 1)" OnClick="() => GoToPageAsync(CurrentPage - 1)">Trước</BbButton>
                @foreach (var page in VisiblePages)
                {
                    <BbButton Variant="@(page == CurrentPage ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Small"
                              Disabled="@(page == CurrentPage)"
                              OnClick="() => GoToPageAsync(page)">@(page)</BbButton>
                }
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          Disabled="@(CurrentPage >= TotalPages)" OnClick="() => GoToPageAsync(CurrentPage + 1)">Sau</BbButton>
            </div>
        </div>
    }
</div>

<!-- Create Dialog -->
<FormDialog Open="@_showCreate"
            OpenChanged="@(v => _showCreate = v)"
            Title="Thêm danh mục"
            Description="Nhập tên danh mục mới."
            BodyClass="py-4 pr-1 max-h-[60vh] overflow-y-auto"
            SubmitText="Lưu"
            SubmitLoading="@_saving"
            SubmitLoadingText="Đang lưu..."
            SubmitDisabled="@(string.IsNullOrWhiteSpace(_formName))"
            OnSubmit="HandleCreate">
    <BbInput @bind-Value="_formName" Placeholder="Tên danh mục" />
</FormDialog>

<!-- Delete Confirm Dialog -->
<ConfirmDialog Open="@_showDeleteConfirm"
               OpenChanged="@(v => _showDeleteConfirm = v)"
               Title="Xóa danh mục?"
               Description="Hành động này không thể hoàn tác."
               OnConfirm="ConfirmDeleteAsync" />

<!-- Bulk Delete Confirm Dialog -->
<ConfirmDialog Open="@_showBulkDeleteConfirm"
               OpenChanged="@(v => _showBulkDeleteConfirm = v)"
               Title="@("Xóa " + _selectedIds.Count + " danh mục?")"
               Description="Hành động này không thể hoàn tác."
               ConfirmLoading="@_bulkDeleting"
               ConfirmLoadingText="Đang xóa..."
               OnConfirm="HandleBulkDelete" />

<!-- Edit Dialog -->
<FormDialog Open="@_showEdit"
            OpenChanged="@(v => _showEdit = v)"
            Title="Sửa danh mục"
            Description="Cập nhật tên danh mục."
            BodyClass="py-4 pr-1 max-h-[60vh] overflow-y-auto"
            SubmitText="Cập nhật"
            SubmitLoading="@_saving"
            SubmitLoadingText="Đang lưu..."
            SubmitDisabled="@(string.IsNullOrWhiteSpace(_formName))"
            OnSubmit="HandleEdit">
    <BbInput @bind-Value="_formName" Placeholder="Tên danh mục" />
</FormDialog>

@code {
    private List<CategoryDto> _items = [];
    private bool _loading, _saving;
    private int _skip, _take = 5, _total;
    private string _search = "";
    private string _sortOption = "name_asc";
    private string? _error;

    private bool _showCreate, _showEdit;
    private Guid? _editId;
    private string _formName = "";
    private bool _showDeleteConfirm;
    private Guid? _pendingDeleteId;
    private HashSet<Guid> _selectedIds = [];
    private bool _showBulkDeleteConfirm;
    private bool _bulkDeleting;

    private bool AllSelected => _items.Count > 0 && _items.All(i => _selectedIds.Contains(i.Id));

    private void ToggleSelect(Guid id, bool selected)
    {
        if (selected) _selectedIds.Add(id);
        else _selectedIds.Remove(id);
        _ = PersistStateAsync();
    }

    private void ToggleSelectAll(bool selected)
    {
        if (selected)
            foreach (var id in _items.Select(i => i.Id)) _selectedIds.Add(id);
        else
            foreach (var id in _items.Select(i => i.Id)) _selectedIds.Remove(id);
        _ = PersistStateAsync();
    }

    private async Task OpenBulkDeleteConfirmAsync()
    {
        _showBulkDeleteConfirm = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleBulkDelete()
    {
        _bulkDeleting = true;
        var ids = _selectedIds.ToList();
        var tasks = ids.Select(id => Client.DeleteCategory.ExecuteAsync(id));
        var results = await Task.WhenAll(tasks);
        _bulkDeleting = false;
        _showBulkDeleteConfirm = false;

        var deleted = results.Count(r => r.Data?.DeleteCategory == true);
        _selectedIds.Clear();

        if (deleted > 0)
        {
            ToastService.Success($"Đã xóa {deleted} danh mục.");
            await LoadAsync();
        }
        if (deleted < ids.Count)
            ToastService.Error($"{ids.Count - deleted} danh mục không thể xóa.");
    }

    private static readonly List<SelectOption<string>> SortOptions =
    [
        new("name_asc", "Tên A → Z"),
        new("name_desc", "Tên Z → A")
    ];

    protected override async Task OnInitializedAsync()
    {
        if (TryRestoreState())
            return;

        await LoadAsync(showLoading: true);
    }

    private bool TryRestoreState()
    {
        var cached = State.Cache;
        if (cached is null) return false;

        _search = cached.Search;
        _skip = cached.Skip;
        _take = cached.Take;
        _total = cached.Total;
        _items = cached.Items.Select(i => new CategoryDto(i.Id, i.Name)).ToList();
        _selectedIds = cached.SelectedIds.ToHashSet();
        return true;
    }

    private Task PersistStateAsync()
    {
        var snapshot = new CategoryPageCache(
            _search,
            _skip,
            _take,
            _total,
            _items.Select(i => new CategoryListItem(i.Id, i.Name)).ToList(),
            _selectedIds.ToList());

        return UiStateWriter.UpdateAsync(s => s with { Cache = snapshot }, "cache.categories");
    }

    private Task OnSearchChangedAsync(string value)
    {
        _search = value;
        _skip = 0;

        return DebounceManager.Debounce(
            "categories.search.load",
            async () => await InvokeAsync(async () => await LoadAsync()),
            300);
    }

    private Task OnSortChangedAsync(string value)
    {
        _sortOption = value;
        _skip = 0;
        return ReloadAsyncNonBlocking();
    }

    private Task ReloadAsyncNonBlocking()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync(showLoading: true);
            StateHasChanged();
        });

        return Task.CompletedTask;
    }

    private async Task LoadAsync(bool showLoading = false)
    {
        _loading = showLoading;
        _error = null;
        if (showLoading)
            StateHasChanged();
        try
        {
            var result = await Client.GetCategories.ExecuteAsync(_skip, _take, BuildFilter(), BuildOrder());
            if (result.Data?.CategoriesOffset is { } data)
            {
                _items = data.Items?.Select(i => new CategoryDto(i.Id, i.Name)).ToList() ?? [];
                _total = data.TotalCount;
                await PersistStateAsync();
            }
            else if (result.Errors.Count > 0)
                _error = GraphQLErrorFormatter.Format(result.Errors, "Không tải được danh mục.");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private CategoryFilterInput? BuildFilter()
    {
        var hasName = !string.IsNullOrWhiteSpace(_search);
        if (!hasName)
            return null;

        return new CategoryFilterInput
        {
            Name = new StringOperationFilterInput { Contains = _search }
        };
    }

    private IReadOnlyList<CategorySortInput>? BuildOrder()
    {
        var dir = _sortOption == "name_desc" ? SortEnumType.Desc : SortEnumType.Asc;
        var sort = new CategorySortInput { Name = dir };

        return [sort];
    }

    private int CurrentPage => (_skip / _take) + 1;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_total / (double)_take));
    private IEnumerable<int> VisiblePages
    {
        get
        {
            if (TotalPages <= 7)
                return Enumerable.Range(1, TotalPages);

            var start = Math.Max(1, CurrentPage - 2);
            var end = Math.Min(TotalPages, start + 4);
            start = Math.Max(1, end - 4);
            return Enumerable.Range(start, end - start + 1);
        }
    }

    private async Task GoToPageAsync(int page)
    {
        var targetPage = Math.Clamp(page, 1, TotalPages);
        _skip = (targetPage - 1) * _take;
        await LoadAsync();
    }

    private bool MatchesCurrentFilter(Guid id, string name)
    {
        var nameMatches = string.IsNullOrWhiteSpace(_search) || name.Contains(_search, StringComparison.OrdinalIgnoreCase);
        return nameMatches;
    }

    private async Task OpenCreateAsync()
    {
        _formName = "";
        _showCreate = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenEditAsync(CategoryDto item)
    {
        _editId = item.Id;
        _formName = item.Name;
        _showEdit = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCreate()
    {
        _saving = true;
        var result = await Client.CreateCategory.ExecuteAsync(_formName);
        _saving = false;
        if (result.Data?.CreateCategory is { } created)
        {
            _showCreate = false;
            ToastService.Success("Đã thêm danh mục.");
            if (MatchesCurrentFilter(created.Id, created.Name))
            {
                _total++;
                _items.Insert(0, new CategoryDto(created.Id, created.Name));
                if (_items.Count > _take)
                    _items.RemoveAt(_items.Count - 1);
            }
            await PersistStateAsync();
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private async Task HandleEdit()
    {
        _saving = true;
        var result = await Client.UpdateCategory.ExecuteAsync(_editId!.Value, _formName);
        _saving = false;
        if (result.Data?.UpdateCategory is { } updated)
        {
            _showEdit = false;
            ToastService.Success("Đã cập nhật danh mục.");

            var index = _items.FindIndex(x => x.Id == updated.Id);
            if (index >= 0)
            {
                if (MatchesCurrentFilter(updated.Id, updated.Name))
                {
                    _items[index] = new CategoryDto(updated.Id, updated.Name);
                    await PersistStateAsync();
                }
                else
                {
                    _items.RemoveAt(index);
                    _total = Math.Max(0, _total - 1);
                    if (_items.Count == 0 && _skip > 0 && _total > 0)
                    {
                        _skip = Math.Max(0, _skip - _take);
                        await LoadAsync();
                    }
                    await PersistStateAsync();
                }
            }
            else
            {
                await LoadAsync();
            }
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private async Task OpenDeleteConfirmAsync(Guid id)
    {
        _pendingDeleteId = id;
        _showDeleteConfirm = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmDeleteAsync()
    {
        if (!_pendingDeleteId.HasValue)
            return;

        _showDeleteConfirm = false;
        var id = _pendingDeleteId.Value;
        _pendingDeleteId = null;
        await HandleDelete(id);
    }

    private async Task HandleDelete(Guid id)
    {
        var result = await Client.DeleteCategory.ExecuteAsync(id);
        if (result.Data?.DeleteCategory == true)
        {
            ToastService.Success("Đã xóa danh mục.");
            var index = _items.FindIndex(x => x.Id == id);
            if (index >= 0)
            {
                _items.RemoveAt(index);
                _total = Math.Max(0, _total - 1);

                if (_items.Count == 0 && _skip > 0 && _total > 0)
                    _skip = Math.Max(0, _skip - _take);

                if ((_items.Count < _take && _total > _items.Count) || (_items.Count == 0 && _total > 0))
                    await LoadAsync();
                else
                    await PersistStateAsync();
            }
            else
            {
                await LoadAsync();
            }
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private record CategoryDto(Guid Id, string Name);
}
