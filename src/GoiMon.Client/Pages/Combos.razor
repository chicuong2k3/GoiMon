@page "/combos"
@inject IGoiMonClient Client
@inject ToastService ToastService
@inject DialogService DialogService

<header class="flex h-14 shrink-0 items-center gap-2 border-b px-4">
    <BbSidebarTrigger />
    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="h-4" />
    <h1 class="text-sm font-semibold">Combo</h1>
    <div class="ml-auto">
        <BbButton OnClick="OpenCreate" Size="ButtonSize.Small">
            <LucideIcon Name="plus" Class="h-4 w-4 mr-1" />
            Thêm combo
        </BbButton>
    </div>
</header>

<div class="p-6 space-y-4">
    <div class="w-72">
        <BbInput Value="@_search"
                 ValueChanged="@(async v => { _search = v; _skip = 0; await LoadAsync(); })"
                 UpdateTiming="UpdateTiming.Debounced"
                 DebounceInterval="400"
                 Placeholder="Tìm kiếm combo..." />
    </div>

    @if (_loading)
    {
        <div class="space-y-2">
            @for (int i = 0; i < 5; i++)
            {
                <BbSkeleton Height="60px" Class="w-full" />
            }
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-md border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            @_error
        </div>
    }
    else
    {
        <div class="rounded-md border">
            <table class="w-full text-sm">
                <thead class="border-b bg-muted/50">
                    <tr>
                        <th class="h-10 px-4 text-left font-medium text-muted-foreground">Tên combo</th>
                        <th class="h-10 px-4 text-right font-medium text-muted-foreground">Giá</th>
                        <th class="h-10 px-4 text-left font-medium text-muted-foreground hidden md:table-cell">Món trong combo</th>
                        <th class="h-10 px-4 text-right font-medium text-muted-foreground w-36">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="p-8 text-center text-muted-foreground">
                                Không tìm thấy combo nào.
                            </td>
                        </tr>
                    }
                    @foreach (var item in _items)
                    {
                        <tr class="border-b last:border-0 hover:bg-muted/50 transition-colors">
                            <td class="px-4 py-3 font-medium">@(item.Name ?? "—")</td>
                            <td class="px-4 py-3 text-right font-medium tabular-nums">
                                @item.Price.ToString("#,##0") đ
                            </td>
                            <td class="px-4 py-3 hidden md:table-cell">
                                <div class="flex flex-wrap gap-1">
                                    @if (!item.Items.Any())
                                    {
                                        <span class="text-muted-foreground text-xs">Chưa có món</span>
                                    }
                                    @foreach (var ci in item.Items)
                                    {
                                        <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs">
                                            @ci.Qty× @(ci.ProductName ?? ci.ProductId.ToString()[..8])
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex justify-end gap-1">
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Quản lý món" OnClick="() => OpenManageItems(item)">
                                        <LucideIcon Name="list-plus" Class="h-4 w-4" />
                                    </BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Sửa" OnClick="() => OpenEdit(item)">
                                        <LucideIcon Name="pencil" Class="h-4 w-4" />
                                    </BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Xóa" Class="text-destructive hover:text-destructive hover:bg-destructive/10"
                                              OnClick="() => HandleDelete(item.Id)">
                                        <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                    </BbButton>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-between text-sm text-muted-foreground">
            <span>Hiển thị @(_items.Count) / @_total combo</span>
            <div class="flex gap-2">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          Disabled="@(_skip == 0)" OnClick="PrevPage">Trước</BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          Disabled="@(_skip + _take >= _total)" OnClick="NextPage">Sau</BbButton>
            </div>
        </div>
    }
</div>

<!-- Create Dialog -->
<BbDialog @bind-Open="_showCreate">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>Thêm combo</BbDialogTitle>
            <BbDialogDescription>Nhập thông tin combo mới.</BbDialogDescription>
        </BbDialogHeader>
        <div class="space-y-3 py-4">
            <div class="space-y-1">
                <label class="text-sm font-medium">Tên combo <span class="text-destructive">*</span></label>
                <BbInput @bind-Value="_formName" Placeholder="Tên combo" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium">Giá (đ) <span class="text-destructive">*</span></label>
                <BbInput @bind-Value="_formPriceStr" Type="InputType.Number" Placeholder="0" />
            </div>
        </div>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Hủy</BbButton>
            </BbDialogClose>
            <BbButton OnClick="HandleCreate"
                      Loading="@_saving" LoadingText="Đang lưu..."
                      Disabled="@(string.IsNullOrWhiteSpace(_formName) || !decimal.TryParse(_formPriceStr, out _))">
                Lưu
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<!-- Edit Dialog -->
<BbDialog @bind-Open="_showEdit">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>Sửa combo</BbDialogTitle>
        </BbDialogHeader>
        <div class="space-y-3 py-4">
            <div class="space-y-1">
                <label class="text-sm font-medium">Tên combo</label>
                <BbInput @bind-Value="_formName" Placeholder="Tên combo" />
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium">Giá (đ)</label>
                <BbInput @bind-Value="_formPriceStr" Type="InputType.Number" Placeholder="0" />
            </div>
        </div>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Hủy</BbButton>
            </BbDialogClose>
            <BbButton OnClick="HandleEdit"
                      Loading="@_saving" LoadingText="Đang lưu..."
                      Disabled="@(!decimal.TryParse(_formPriceStr, out _))">
                Cập nhật
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<!-- Manage Items Dialog -->
<BbDialog @bind-Open="_showManageItems">
    <BbDialogContent Class="max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>Quản lý món — @(_currentCombo?.Name ?? "")</BbDialogTitle>
            <BbDialogDescription>Thêm hoặc xóa món trong combo.</BbDialogDescription>
        </BbDialogHeader>
        <div class="space-y-4 py-4">
            @if (_currentCombo?.Items.Any() == true)
            {
                <div class="space-y-1">
                    <p class="text-sm font-medium text-muted-foreground">Món hiện tại</p>
                    <div class="rounded-md border divide-y">
                        @foreach (var ci in _currentCombo.Items)
                        {
                            <div class="flex items-center justify-between px-3 py-2 text-sm">
                                <span>@(ci.ProductName ?? ci.ProductId.ToString()[..8])</span>
                                <div class="flex items-center gap-2">
                                    <span class="text-muted-foreground">×@ci.Qty</span>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Xóa món" Class="text-destructive hover:text-destructive"
                                              OnClick="() => HandleRemoveItem(ci.Id)">
                                        <LucideIcon Name="x" Class="h-3 w-3" />
                                    </BbButton>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <BbSeparator />

            <div class="space-y-2">
                <p class="text-sm font-medium">Thêm món</p>
                <div class="flex gap-2">
                    <div class="flex-1">
                        <BbSelect TValue="Guid?" @bind-Value="_addProductId">
                            <BbSelectTrigger>
                                <BbSelectValue Placeholder="Chọn sản phẩm..." />
                            </BbSelectTrigger>
                            <BbSelectContent>
                                @foreach (var p in _allProducts)
                                {
                                    <BbSelectItem Value="@((Guid?)p.Id)">@p.Name</BbSelectItem>
                                }
                            </BbSelectContent>
                        </BbSelect>
                    </div>
                    <div class="w-20">
                        <BbInput @bind-Value="_addQtyStr" Type="InputType.Number" Placeholder="SL" />
                    </div>
                    <BbButton OnClick="HandleAddItem"
                              Loading="@_savingItem"
                              Disabled="@(!_addProductId.HasValue || !int.TryParse(_addQtyStr, out var q) || q <= 0)">
                        Thêm
                    </BbButton>
                </div>
            </div>
        </div>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Đóng</BbButton>
            </BbDialogClose>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<ComboDto> _items = [];
    private List<ProductItem> _allProducts = [];
    private bool _loading, _saving, _savingItem;
    private int _skip, _take = 10, _total;
    private string _search = "";
    private string? _error;

    private bool _showCreate, _showEdit, _showManageItems;
    private Guid? _editId;
    private string _formName = "";
    private string _formPriceStr = "";

    private ComboDto? _currentCombo;
    private Guid? _addProductId;
    private string _addQtyStr = "1";

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadProductsAsync(), LoadAsync());
    }

    private async Task LoadProductsAsync()
    {
        var result = await Client.GetProducts.ExecuteAsync(0, 500, null);
        if (result.Data?.Products?.Items is { } prods)
            _allProducts = prods.Select(p => new ProductItem(p.Id, p.Name)).ToList();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();
        try
        {
            ProductComboFilterInput? where = string.IsNullOrWhiteSpace(_search) ? null
                : new ProductComboFilterInput { Name = new StringOperationFilterInput { Contains = _search } };
            var result = await Client.GetCombos.ExecuteAsync(_skip, _take, where);
            if (result.Data?.Combos is { } data)
            {
                _items = data.Items?.Select(c => new ComboDto(
                    c.Id, c.Name, c.Price,
                    c.Items.Select(ci => new ComboItemDto(ci.Id, ci.ProductId, ci.Product?.Name, ci.Qty)).ToList()
                )).ToList() ?? [];
                _total = data.TotalCount;
            }
            else if (result.Errors.Count > 0)
                _error = result.Errors[0].Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private async Task PrevPage() { _skip = Math.Max(0, _skip - _take); await LoadAsync(); }
    private async Task NextPage() { _skip += _take; await LoadAsync(); }

    private void OpenCreate() { _formName = ""; _formPriceStr = ""; _showCreate = true; }

    private void OpenEdit(ComboDto item)
    {
        _editId = item.Id;
        _formName = item.Name ?? "";
        _formPriceStr = item.Price.ToString();
        _showEdit = true;
    }

    private void OpenManageItems(ComboDto item)
    {
        _currentCombo = item;
        _addProductId = null;
        _addQtyStr = "1";
        _showManageItems = true;
    }

    private async Task HandleCreate()
    {
        if (!decimal.TryParse(_formPriceStr, out var price)) return;
        _saving = true;
        var result = await Client.CreateCombo.ExecuteAsync(_formName, price);
        _saving = false;
        if (result.Data?.CreateCombo is not null)
        {
            _showCreate = false;
            ToastService.Success("Đã thêm combo.");
            await LoadAsync();
        }
        else
        {
            ToastService.Error(result.Errors.FirstOrDefault()?.Message ?? "Có lỗi xảy ra.");
        }
    }

    private async Task HandleEdit()
    {
        if (!decimal.TryParse(_formPriceStr, out var price)) return;
        _saving = true;
        var name = string.IsNullOrWhiteSpace(_formName) ? null : _formName;
        var result = await Client.UpdateCombo.ExecuteAsync(_editId!.Value, name, price);
        _saving = false;
        if (result.Data?.UpdateCombo is not null)
        {
            _showEdit = false;
            ToastService.Success("Đã cập nhật combo.");
            await LoadAsync();
        }
        else
        {
            ToastService.Error(result.Errors.FirstOrDefault()?.Message ?? "Có lỗi xảy ra.");
        }
    }

    private async Task HandleDelete(Guid id)
    {
        var confirmed = await DialogService.Confirm(
            "Xóa combo?",
            "Hành động này không thể hoàn tác.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Xóa" });
        if (!confirmed) return;

        var result = await Client.DeleteCombo.ExecuteAsync(id);
        if (result.Data?.DeleteCombo == true)
        {
            ToastService.Success("Đã xóa combo.");
            if (_items.Count == 1 && _skip > 0) _skip -= _take;
            await LoadAsync();
        }
        else
        {
            ToastService.Error(result.Errors.FirstOrDefault()?.Message ?? "Có lỗi xảy ra.");
        }
    }

    private async Task HandleAddItem()
    {
        if (_currentCombo is null || !_addProductId.HasValue) return;
        if (!int.TryParse(_addQtyStr, out var qty) || qty <= 0) return;

        _savingItem = true;
        var result = await Client.AddComboItem.ExecuteAsync(_currentCombo.Id, _addProductId.Value, qty);
        _savingItem = false;

        if (result.Data?.AddComboItem is { } updated)
        {
            ToastService.Success("Đã thêm món vào combo.");
            _addProductId = null;
            _addQtyStr = "1";
            _currentCombo = _currentCombo with
            {
                Items = updated.Items.Select(ci => new ComboItemDto(
                    ci.Id, ci.ProductId, ci.Product?.Name, ci.Qty)).ToList()
            };
            await LoadAsync();
        }
        else
        {
            ToastService.Error(result.Errors.FirstOrDefault()?.Message ?? "Có lỗi xảy ra.");
        }
    }

    private async Task HandleRemoveItem(Guid itemId)
    {
        if (_currentCombo is null) return;

        var confirmed = await DialogService.Confirm(
            "Xóa món khỏi combo?",
            "Món sẽ bị xóa khỏi combo này.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Xóa" });
        if (!confirmed) return;

        var result = await Client.RemoveComboItem.ExecuteAsync(_currentCombo.Id, itemId);
        if (result.Data?.RemoveComboItem is not null)
        {
            ToastService.Success("Đã xóa món khỏi combo.");
            _currentCombo = _currentCombo with
            {
                Items = _currentCombo.Items.Where(ci => ci.Id != itemId).ToList()
            };
            await LoadAsync();
        }
        else
        {
            ToastService.Error(result.Errors.FirstOrDefault()?.Message ?? "Có lỗi xảy ra.");
        }
    }

    private record ProductItem(Guid Id, string Name);
    private record ComboItemDto(Guid Id, Guid ProductId, string? ProductName, int Qty);
    private record ComboDto(Guid Id, string? Name, decimal Price, List<ComboItemDto> Items);
}
