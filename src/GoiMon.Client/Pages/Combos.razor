@page "/combos"
@inherits StoreComponentWithUtilities<CombosUiState>
@inject IGoiMonClient Client
@inject ToastService ToastService
@inject IStateWriter<CombosUiState> UiStateWriter
@inject GoiMon.Client.Features.ImageUpload.Services.IImageUploadService ImageUploadSvc

@using EasyAppDev.Blazor.Store.Core
@using GoiMon.Client.State
@using System.Globalization

<header class="flex h-12 shrink-0 items-center gap-2 border-b px-4 py-1 md:px-5">
    <BbSidebarTrigger />
    <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="h-3" />
    <h1 class="text-[10px] font-semibold">Combo</h1>
    <div class="ml-auto flex items-center gap-2">
        @if (_selectedIds.Count > 0)
        {
            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                      OnClick="OpenBulkDeleteConfirm">
                <LucideIcon Name="trash-2" Class="h-4 w-4 mr-1" />
                Xóa (@_selectedIds.Count)
            </BbButton>
        }
        <BbButton OnClick="OpenCreate" Size="ButtonSize.Small">
            <LucideIcon Name="plus" Class="h-4 w-4 mr-1" />
            Thêm combo
        </BbButton>
    </div>
</header>

<div class="p-4 md:p-5 space-y-4">
    <div class="mb-1 flex flex-wrap items-center gap-3">
        <div class="w-64">
            <BbInput Value="@_search"
                     ValueChanged="OnSearchChangedAsync"
                     Placeholder="Tìm kiếm combo..." />
        </div>
        <div class="w-40">
            <BbSelect TValue="string"
                      Value="@_filterHasItems"
                      ValueChanged="OnFilterHasItemsChangedAsync"
                      Options="HasItemsOptions"
                      Placeholder="Lọc món"
                      Class="w-full" />
        </div>
        <div class="w-44">
            <BbSelect TValue="string"
                      Value="@_sortOption"
                      ValueChanged="OnSortOptionChangedAsync"
                      Options="SortOptions"
                      Placeholder="Sắp xếp"
                      Class="w-full" />
        </div>
        <div class="w-56 space-y-1">
            <div class="flex items-center justify-between text-[10px] text-muted-foreground leading-none">
                <span>Lọc giá</span>
                <span>@FormatCurrency((decimal)_priceRange.Start) – @FormatCurrency((decimal)_priceRange.End)</span>
            </div>
            <BbRangeSlider Value="@_priceRange"
                           ValueChanged="OnPriceRangeChangedAsync"
                           Min="0"
                           Max="@_priceRangeMax"
                           Step="5000"
                           MinRange="5000"
                           ShowTooltips="true"
                           Class="w-full"
                           StartLabel="Giá tối thiểu"
                           EndLabel="Giá tối đa" />
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="rounded-md border border-destructive/50 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            @_error
        </div>
    }
    <div class="rounded-md border">
        <table class="w-full text-sm">
            <thead class="border-b bg-muted/50">
                <tr>
                    <th class="h-10 w-10 px-3 align-middle">
                        <BbCheckbox Checked="@AllSelected" CheckedChanged="@ToggleSelectAll" />
                    </th>
                    <th class="h-10 px-4 text-left font-medium text-muted-foreground align-middle">Tên combo</th>
                    <th class="h-10 px-4 text-right font-medium text-muted-foreground align-middle">Giá</th>
                    <th class="h-10 px-4 text-left font-medium text-muted-foreground hidden md:table-cell align-middle">Món trong combo</th>
                    <th class="h-10 px-4 text-right font-medium text-muted-foreground w-36 align-middle">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    @for (int i = 0; i < 5; i++)
                    {
                        <tr class="border-b last:border-0">
                            <td colspan="5" class="px-4 py-2 align-middle">
                                <BbSkeleton Height="38px" Class="w-full" />
                            </td>
                        </tr>
                    }
                }
                else if (_items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="p-8 text-center text-muted-foreground">
                            Không tìm thấy combo nào.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in _items)
                    {
                        <tr class="border-b last:border-0 hover:bg-muted/50 transition-colors @(_selectedIds.Contains(item.Id) ? "bg-muted/30" : "")">
                            <td class="px-3 py-3 align-middle">
                                <BbCheckbox Checked="@_selectedIds.Contains(item.Id)"
                                            CheckedChanged="@(v => ToggleSelect(item.Id, v))" />
                            </td>
                            <td class="px-4 py-3 font-medium align-middle">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@(item.Name ?? "")" class="h-10 w-10 rounded object-cover shrink-0" />
                                    }
                                    else
                                    {
                                        <div class="h-10 w-10 rounded bg-muted flex items-center justify-center shrink-0">
                                            <LucideIcon Name="image" Class="h-4 w-4 text-muted-foreground" />
                                        </div>
                                    }
                                    <span>@(item.Name ?? "—")</span>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-right font-medium tabular-nums align-middle">
                                @FormatCurrency(item.Price)
                            </td>
                            <td class="px-4 py-3 hidden md:table-cell align-middle">
                                <div class="flex flex-wrap gap-1">
                                    @if (!item.Items.Any())
                                    {
                                        <span class="text-muted-foreground text-xs">Chưa có món</span>
                                    }
                                    @foreach (var ci in item.Items)
                                    {
                                        <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs">
                                            @ci.Qty× @(ci.ProductName ?? ci.ProductId.ToString()[..8])@(string.IsNullOrWhiteSpace(ci.VariantName) ? "" : $" ({ci.VariantName})")
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="px-4 py-3 text-right align-middle">
                                <div class="flex items-center justify-end gap-1">
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Quản lý món" OnClick="async () => await OpenManageItemsAsync(item)">
                                        <LucideIcon Name="list-plus" Class="h-4 w-4" />
                                    </BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Sửa" OnClick="() => OpenEdit(item)">
                                        <LucideIcon Name="pencil" Class="h-4 w-4" />
                                    </BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Xóa" Class="text-destructive hover:text-destructive hover:bg-destructive/10"
                                              OnClick="() => OpenDeleteConfirm(item.Id)">
                                        <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                    </BbButton>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

        <div class="pt-1 flex items-center justify-between text-sm text-muted-foreground">
            <span>Hiển thị @(_items.Count) / @_total combo</span>
            <div class="flex items-center gap-2">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          Disabled="@(_loading || CurrentPage <= 1)" OnClick="() => GoToPageAsync(CurrentPage - 1)">Trước</BbButton>
                @foreach (var page in VisiblePages)
                {
                    <BbButton Variant="@(page == CurrentPage ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Small"
                              Disabled="@(_loading || page == CurrentPage)"
                              OnClick="() => GoToPageAsync(page)">@(page)</BbButton>
                }
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                          Disabled="@(_loading || CurrentPage >= TotalPages)" OnClick="() => GoToPageAsync(CurrentPage + 1)">Sau</BbButton>
            </div>
        </div>
</div>

<!-- Create Dialog -->
<FormDialog Open="@_showCreate"
            OpenChanged="@(v => _showCreate = v)"
            Title="Thêm combo"
            Description="Nhập thông tin combo mới."
            SubmitText="Lưu"
            SubmitLoading="@_saving"
            SubmitLoadingText="Đang lưu..."
            SubmitDisabled="@(string.IsNullOrWhiteSpace(_formName) || !decimal.TryParse(_formPriceStr, out _))"
            OnSubmit="HandleCreate">
    <div class="space-y-1">
        <label class="text-sm font-medium">Tên combo <span class="text-destructive">*</span></label>
        <BbInput @bind-Value="_formName" Placeholder="Tên combo" />
    </div>
    <div class="space-y-1">
        <label class="text-sm font-medium">Giá (đ) <span class="text-destructive">*</span></label>
        <BbInput @bind-Value="_formPriceStr" Type="InputType.Number" Placeholder="0" />
    </div>
    <div class="space-y-1">
        <label class="text-sm font-medium">Hình ảnh</label>
        @if (HasImage)
        {
            <img src="@DisplayImageUrl" class="w-full h-32 object-cover rounded-lg mb-2" alt="Combo image" />
        }
        <InputFile OnChange="HandleImageSelected" accept="image/*" class="hidden" id="create-combo-img" />
        <label for="create-combo-img"
               class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium shadow-sm hover:bg-accent hover:text-accent-foreground">
            <LucideIcon Name="image" Class="h-4 w-4" />
            <span>@(HasImage ? "Đổi ảnh" : "Chọn ảnh")</span>
        </label>
    </div>
</FormDialog>

<!-- Delete Confirm Dialog -->
<ConfirmDialog Open="@_showDeleteConfirm"
               OpenChanged="@(v => _showDeleteConfirm = v)"
               Title="Xóa combo?"
               Description="Hành động này không thể hoàn tác."
               OnConfirm="ConfirmDeleteAsync" />

<!-- Bulk Delete Confirm Dialog -->
<ConfirmDialog Open="@_showBulkDeleteConfirm"
               OpenChanged="@(v => _showBulkDeleteConfirm = v)"
               Title="@("Xóa " + _selectedIds.Count + " combo?")"
               Description="Hành động này không thể hoàn tác."
               ConfirmLoading="@_bulkDeleting"
               ConfirmLoadingText="Đang xóa..."
               OnConfirm="HandleBulkDelete" />

<!-- Edit Dialog -->
<FormDialog Open="@_showEdit"
            OpenChanged="@(v => _showEdit = v)"
            Title="Sửa combo"
            SubmitText="Cập nhật"
            SubmitLoading="@_saving"
            SubmitLoadingText="Đang lưu..."
            SubmitDisabled="@(!decimal.TryParse(_formPriceStr, out _))"
            OnSubmit="HandleEdit">
    <div class="space-y-1">
        <label class="text-sm font-medium">Tên combo</label>
        <BbInput @bind-Value="_formName" Placeholder="Tên combo" />
    </div>
    <div class="space-y-1">
        <label class="text-sm font-medium">Giá (đ)</label>
        <BbInput @bind-Value="_formPriceStr" Type="InputType.Number" Placeholder="0" />
    </div>
    <div class="space-y-1">
        <label class="text-sm font-medium">Hình ảnh</label>
        @if (HasImage)
        {
            <img src="@DisplayImageUrl" class="w-full h-32 object-cover rounded-lg mb-2" alt="Combo image" />
        }
        <InputFile OnChange="HandleImageSelected" accept="image/*" class="hidden" id="edit-combo-img" />
        <label for="edit-combo-img"
               class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium shadow-sm hover:bg-accent hover:text-accent-foreground">
            <LucideIcon Name="image" Class="h-4 w-4" />
            <span>@(HasImage ? "Đổi ảnh" : "Chọn ảnh")</span>
        </label>
    </div>
</FormDialog>

<!-- Manage Items Dialog -->
<BbDialog Open="@_showManageItems" OpenChanged="@(v => _showManageItems = v)">
    <BbDialogContent Class="max-w-sm max-h-[90dvh] flex flex-col overflow-hidden">
        <BbDialogHeader>
            <BbDialogTitle>Quản lý món — @(_currentCombo?.Name ?? "")</BbDialogTitle>
            <BbDialogDescription>Thêm hoặc xóa món trong combo.</BbDialogDescription>
        </BbDialogHeader>
        <div class="flex-1 min-h-0 space-y-4 py-4 pr-1 overflow-y-auto">
            @if (_currentCombo?.Items.Any() == true)
            {
                <div class="space-y-1">
                    <p class="text-sm font-medium text-muted-foreground">Món hiện tại</p>
                    <div class="rounded-md border divide-y">
                        @foreach (var ci in _currentCombo.Items)
                        {
                            <div class="flex items-center justify-between px-3 py-2 text-sm">
                                <div class="min-w-0 flex-1 pr-2">
                                    <div class="truncate">@(ci.ProductName ?? ci.ProductId.ToString()[..8])</div>
                                    @if (!string.IsNullOrWhiteSpace(ci.VariantName))
                                    {
                                        <div class="text-xs text-muted-foreground break-words">@ci.VariantName</div>
                                    }
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-muted-foreground">×@ci.Qty</span>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                                              AriaLabel="Xóa món" Class="text-destructive hover:text-destructive"
                                              OnClick="() => HandleRemoveItem(ci.Id)">
                                        <LucideIcon Name="x" Class="h-3 w-3" />
                                    </BbButton>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <BbSeparator />

            <div class="space-y-2">
                <p class="text-sm font-medium">Thêm món</p>
                <div class="flex flex-wrap items-start gap-2">
                    <div class="w-24">
                        <BbCombobox TValue="Guid?"
                                    Value="@_addProductId"
                                    ValueChanged="OnAddProductChanged"
                                    Options="ProductOptions"
                                    Placeholder="Chọn sản phẩm..."
                                    SearchPlaceholder="Tìm sản phẩm..."
                                    EmptyMessage="Không tìm thấy sản phẩm."
                                    MatchTriggerWidth="true" />
                    </div>
                    @if (SelectedProductHasVariants)
                    {
                        <div class="w-24">
                            <BbCombobox TValue="Guid?"
                                        Value="@_addVariantId"
                                        ValueChanged="(v => _addVariantId = v)"
                                        Options="VariantOptions"
                                        Placeholder="Chọn size/biến thể..."
                                        SearchPlaceholder="Tìm size..."
                                        EmptyMessage="Không có biến thể."
                                        MatchTriggerWidth="true" />
                        </div>
                    }
                    <div class="w-24">
                        <BbInput @bind-Value="_addQtyStr" Type="InputType.Number" Placeholder="SL" />
                    </div>
                    <BbButton OnClick="HandleAddItem"
                              Loading="@_savingItem"
                              Disabled="@(!_addProductId.HasValue || !int.TryParse(_addQtyStr, out var q) || q <= 0 || (SelectedProductHasVariants && !_addVariantId.HasValue))">
                        Thêm
                    </BbButton>
                </div>
            </div>
        </div>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">Đóng</BbButton>
            </BbDialogClose>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private static readonly CultureInfo VnCulture = CultureInfo.GetCultureInfo("vi-VN");

    private static string FormatNumber(decimal amount)
        => amount.ToString("N0", VnCulture);

    private static string FormatCurrency(decimal amount)
        => string.Concat(FormatNumber(amount), "đ");

    private List<ComboDto> _items = [];
    private List<ProductItem> _allProducts = [];
    private bool _loading, _saving, _savingItem;
    private int _skip, _take = 5, _total;
    private string _search = "";
    private string _filterPriceMin = "";
    private string _filterPriceMax = "";
    private (double Start, double End) _priceRange = (0, 500000);
    private int _priceRangeMax = 500000;
    private bool _priceRangeInitialized;
    private string _filterHasItems = "";
    private string _sortOption = "name_asc";
    private string? _error;

    private bool _showCreate, _showEdit, _showManageItems;
    private Guid? _editId;
    private string _formName = "";
    private string _formPriceStr = "";
    private string _formImageUrl = "";
    private string? _imagePreviewUrl;
    private IBrowserFile? _pendingImage;
    private string? DisplayImageUrl => _imagePreviewUrl ?? (string.IsNullOrEmpty(_formImageUrl) ? null : _formImageUrl);
    private bool HasImage => DisplayImageUrl is not null;
    private bool _showDeleteConfirm;
    private Guid? _pendingDeleteId;
    private HashSet<Guid> _selectedIds = [];
    private bool _showBulkDeleteConfirm;
    private bool _bulkDeleting;

    private bool AllSelected => _items.Count > 0 && _items.All(i => _selectedIds.Contains(i.Id));

    private void ToggleSelect(Guid id, bool selected)
    {
        if (selected) _selectedIds.Add(id);
        else _selectedIds.Remove(id);
        _ = PersistStateAsync();
    }

    private void ToggleSelectAll(bool selected)
    {
        if (selected)
            foreach (var id in _items.Select(i => i.Id)) _selectedIds.Add(id);
        else
            foreach (var id in _items.Select(i => i.Id)) _selectedIds.Remove(id);
        _ = PersistStateAsync();
    }

    private void OpenBulkDeleteConfirm() => _showBulkDeleteConfirm = true;

    private async Task HandleBulkDelete()
    {
        _bulkDeleting = true;
        var ids = _selectedIds.ToList();
        var tasks = ids.Select(id => Client.DeleteCombo.ExecuteAsync(id));
        var results = await Task.WhenAll(tasks);
        _bulkDeleting = false;
        _showBulkDeleteConfirm = false;

        var deleted = results.Count(r => r.Data?.DeleteCombo == true);
        _selectedIds.Clear();

        if (deleted > 0)
        {
            ToastService.Success($"Đã xóa {deleted} combo.");
            await LoadAsync();
        }
        if (deleted < ids.Count)
            ToastService.Error($"{ids.Count - deleted} combo không thể xóa.");
    }

    private ComboDto? _currentCombo;
    private Guid? _addProductId;
    private Guid? _addVariantId;
    private string _addQtyStr = "1";

    private static readonly List<SelectOption<string>> HasItemsOptions =
    [
        new("", "Tất cả"),
        new("true", "Có món"),
        new("false", "Chưa có món")
    ];

    private static readonly List<SelectOption<string>> SortOptions =
    [
        new("name_asc", "Tên A → Z"),
        new("name_desc", "Tên Z → A"),
        new("price_asc", "Giá tăng dần"),
        new("price_desc", "Giá giảm dần")
    ];

    private List<SelectOption<Guid?>> ProductOptions =>
        _allProducts.Select(p => new SelectOption<Guid?>(p.Id, p.Name)).ToList();

    private ProductItem? SelectedProductForAdd => _allProducts.FirstOrDefault(p => p.Id == _addProductId);
    private bool SelectedProductHasVariants => SelectedProductForAdd?.Variants.Count > 0;
    private List<SelectOption<Guid?>> VariantOptions =>
        SelectedProductForAdd?.Variants
            .OrderBy(v => v.SortOrder)
            .Select(v => new SelectOption<Guid?>(v.Id, $"{v.Name} ({v.Price:#,##0}đ)"))
            .ToList()
        ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (TryRestoreState())
        {
            _ = LoadProductsAsync(silent: true);
            return;
        }

        await Task.WhenAll(LoadProductsAsync(), LoadAsync(showLoading: true));
    }

    private bool TryRestoreState()
    {
        var cached = State.Cache;
        if (cached is null) return false;

        _search = cached.Search;
        _skip = cached.Skip;
        _take = cached.Take;
        _total = cached.Total;
        _items = cached.Items
            .Select(c => new ComboDto(c.Id, c.Name, c.Price,
                c.Items.Select(ci => new ComboItemDto(ci.Id, ci.ProductId, ci.ProductName, ci.VariantId, ci.VariantName, ci.Qty)).ToList(),
                c.ImageUrl))
            .ToList();
        _allProducts = cached.Products.Select(p => new ProductItem(p.Id, p.Name, [])).ToList();
        _selectedIds = cached.SelectedIds.ToHashSet();
        return true;
    }

    private Task PersistStateAsync()
    {
        var snapshot = new ComboPageCache(
            _search,
            _skip,
            _take,
            _total,
            _items.Select(c => new ComboListItem(
                c.Id,
                c.Name,
                c.Price,
                c.Items.Select(ci => new ComboItemListItem(ci.Id, ci.ProductId, ci.ProductName, ci.VariantId, ci.VariantName, ci.Qty)).ToList(),
                c.ImageUrl))
                .ToList(),
            _allProducts.Select(p => new ProductLookupItem(p.Id, p.Name)).ToList(),
            _selectedIds.ToList());

        return UiStateWriter.UpdateAsync(s => s with { Cache = snapshot }, "cache.combos");
    }

    private Task OnSearchChangedAsync(string value)
    {
        _search = value;
        _skip = 0;
        return DebounceReloadAsync("combos.search.load");
    }

    private Task OnFilterHasItemsChangedAsync(string value)
    {
        _filterHasItems = value;
        _skip = 0;
        return ReloadAsyncNonBlocking();
    }

    private Task OnPriceRangeChangedAsync((double Start, double End) value)
    {
        _priceRange = value;
        _filterPriceMin = ((int)value.Start).ToString();
        _filterPriceMax = ((int)value.End).ToString();
        _skip = 0;
        return DebounceReloadAsync("combos.price-range.load", 200);
    }

    private Task OnSortOptionChangedAsync(string value)
    {
        _sortOption = value;
        _skip = 0;
        return ReloadAsyncNonBlocking();
    }

    private Task ReloadAsyncNonBlocking()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync(showLoading: true);
            StateHasChanged();
        });

        return Task.CompletedTask;
    }

    private Task DebounceReloadAsync(string key, int delayMs = 300)
    {
        return DebounceManager.Debounce(
            key,
            async () => await InvokeAsync(async () => await LoadAsync()),
            delayMs);
    }

    private async Task LoadProductsAsync(bool silent = false)
    {
        try
        {
            var asyncExecutor = RequireAsyncExecutor();
            _allProducts = await asyncExecutor.ExecuteCachedAsync(
                "combos.lookup.products",
                FetchAllProductsFromApiAsync,
                loading: state => state,
                success: (state, products) => state with
                {
                    Cache = BuildCacheWithProducts(state.Cache, products)
                },
                error: (state, _) => state,
                cacheFor: TimeSpan.FromMinutes(5));
        }
        catch (Exception ex)
        {
            if (!silent)
                ToastService.Warning($"Không tải được danh sách sản phẩm: {ex.Message}");
        }
    }

    private async Task EnsureProductsLoadedAsync(bool forceRefresh = false)
    {
        var asyncExecutor = RequireAsyncExecutor();
        if (forceRefresh)
            await asyncExecutor.InvalidateCacheAsync("combos.lookup.products");

        if (forceRefresh || _allProducts.Count == 0)
            await LoadProductsAsync(silent: true);
    }

    private IAsyncActionExecutor<CombosUiState> RequireAsyncExecutor()
        => AsyncExecutor ?? throw new InvalidOperationException("AsyncExecutor is not available.");

    private static ComboPageCache BuildCacheWithProducts(ComboPageCache? currentCache, IReadOnlyList<ProductItem> products)
    {
        var productLookup = products.Select(product => new ProductLookupItem(product.Id, product.Name)).ToList();

        if (currentCache is null)
        {
            return new ComboPageCache(string.Empty, 0, 5, 0, [], productLookup, []);
        }

        return currentCache with { Products = productLookup };
    }

    private async Task<List<ProductItem>> FetchAllProductsFromApiAsync()
    {
        var pageSize = 100;
        const int minPageSize = 1;
        var skip = 0;
        var all = new List<ProductItem>();

        while (true)
        {
            var result = await Client.GetProducts.ExecuteAsync(skip, pageSize, null, [new ProductSortInput { Name = SortEnumType.Asc }]);
            if (result.Data?.Products is { } data)
            {
                if (data.Items is { } items)
                    all.AddRange(items.Select(p => new ProductItem(
                        p.Id,
                        p.Name,
                        p.Variants
                            .Where(v => v.IsActive)
                            .Select(v => new ProductVariantItem(v.Id, v.Name, v.Price, v.SortOrder))
                            .ToList())));

                if (data.PageInfo?.HasNextPage != true)
                    break;

                skip += pageSize;
                continue;
            }

            if (result.Errors.Count > 0)
            {
                var message = result.Errors[0].Message;
                if (IsPageSizeExceededError(message) && pageSize > minPageSize)
                {
                    pageSize = Math.Max(minPageSize, pageSize / 2);
                    continue;
                }

                throw new InvalidOperationException(message);
            }

            break;
        }

        return all
            .GroupBy(p => p.Id)
            .Select(g => g.First())
            .ToList();
    }

    private static bool IsPageSizeExceededError(string message)
        => message.Contains("maximum allowed items per page", StringComparison.OrdinalIgnoreCase)
           || message.Contains("items per page", StringComparison.OrdinalIgnoreCase)
           || message.Contains("page size", StringComparison.OrdinalIgnoreCase)
           || message.Contains("take", StringComparison.OrdinalIgnoreCase);

    private async Task LoadAsync(bool showLoading = false)
    {
        _loading = showLoading;
        _error = null;
        if (showLoading)
            StateHasChanged();
        try
        {
            await SyncPriceRangeBoundsAsync();

            var serverFilter = BuildServerFilter();
            var order = BuildOrder();

            if (TryGetHasItemsFilter(out var hasItems))
            {
                var allItems = await FetchAllCombosAsync(serverFilter, order);
                var filtered = allItems
                    .Where(c => hasItems ? c.Items.Count > 0 : c.Items.Count == 0)
                    .ToList();

                _total = filtered.Count;
                if (_skip >= _total && _total > 0)
                    _skip = Math.Max(0, ((_total - 1) / _take) * _take);

                _items = filtered.Skip(_skip).Take(_take).ToList();
                await PersistStateAsync();
            }
            else
            {
                var result = await Client.GetCombos.ExecuteAsync(_skip, _take, serverFilter, order);
                if (result.Data?.Combos is { } data)
                {
                    _items = data.Items?.Select(c => new ComboDto(
                        c.Id, c.Name, c.Price,
                        c.Items.Select(ci => new ComboItemDto(ci.Id, ci.ProductId, ci.Product?.Name, ci.VariantId, ci.Variant?.Name, ci.Qty)).ToList(),
                        c.ImageUrl
                    )).ToList() ?? [];
                    _total = data.TotalCount;
                    await PersistStateAsync();
                }
                else if (result.Errors.Count > 0)
                    _error = GraphQLErrorFormatter.Format(result.Errors, "Không tải được combo.");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private async Task SyncPriceRangeBoundsAsync()
    {
        var cacheKey = $"combos.price.max.{_search.Trim()}.{_filterHasItems}";
        var dynamicMax = await LazyCache.GetOrLoadAsync(
            cacheKey,
            async () =>
            {
                var baseFilter = BuildServerFilter(includePrice: false);
                var allItems = await FetchAllCombosAsync(baseFilter, null);

                if (TryGetHasItemsFilter(out var hasItems))
                    allItems = allItems.Where(c => hasItems ? c.Items.Count > 0 : c.Items.Count == 0).ToList();

                if (allItems.Count == 0)
                    return 50000;

                var rawMax = allItems.Max(i => i.Price);
                var rounded = (int)(Math.Ceiling(rawMax / 5000m) * 5000m);
                return Math.Max(50000, rounded);
            },
            TimeSpan.FromSeconds(10));

        _priceRangeMax = dynamicMax;

        if (!_priceRangeInitialized)
        {
            _priceRange = (0, _priceRangeMax);
            _priceRangeInitialized = true;
            return;
        }

        var start = Math.Clamp((int)_priceRange.Start, 0, _priceRangeMax);
        var end = Math.Clamp((int)_priceRange.End, start, _priceRangeMax);
        _priceRange = (start, end);

        if (decimal.TryParse(_filterPriceMin, out var min) && min > _priceRangeMax)
            _filterPriceMin = start.ToString();

        if (decimal.TryParse(_filterPriceMax, out var max) && max > _priceRangeMax)
            _filterPriceMax = end.ToString();
    }

    private ProductComboFilterInput? BuildServerFilter(bool includePrice = true)
    {
        var hasName = !string.IsNullOrWhiteSpace(_search);
        var hasPriceMin = decimal.TryParse(_filterPriceMin, out var minPrice);
        var hasPriceMax = decimal.TryParse(_filterPriceMax, out var maxPrice);

        if (!includePrice)
        {
            hasPriceMin = false;
            hasPriceMax = false;
        }

        if (!hasName && !hasPriceMin && !hasPriceMax)
            return null;

        DecimalOperationFilterInput? priceFilter = null;
        if (hasPriceMin || hasPriceMax)
        {
            priceFilter = new DecimalOperationFilterInput
            {
                Gte = hasPriceMin ? minPrice : null,
                Lte = hasPriceMax ? maxPrice : null
            };
        }

        return new ProductComboFilterInput
        {
            Name = hasName ? new StringOperationFilterInput { Contains = _search } : null,
            Price = priceFilter
        };
    }

    private static bool TryGetHasItemsFilterValue(string value, out bool hasItems)
        => bool.TryParse(value, out hasItems);

    private bool TryGetHasItemsFilter(out bool hasItems)
        => TryGetHasItemsFilterValue(_filterHasItems, out hasItems);

    private async Task<List<ComboDto>> FetchAllCombosAsync(ProductComboFilterInput? filter, IReadOnlyList<ProductComboSortInput>? order)
    {
        var pageSize = 100;
        const int minPageSize = 1;
        var skip = 0;
        var all = new List<ComboDto>();

        while (true)
        {
            var result = await Client.GetCombos.ExecuteAsync(skip, pageSize, filter, order);
            if (result.Data?.Combos is { } data)
            {
                if (data.Items is { } items)
                {
                    all.AddRange(items.Select(c => new ComboDto(
                        c.Id,
                        c.Name,
                        c.Price,
                        c.Items.Select(ci => new ComboItemDto(ci.Id, ci.ProductId, ci.Product?.Name, ci.VariantId, ci.Variant?.Name, ci.Qty)).ToList(),
                        c.ImageUrl)));
                }

                if (data.PageInfo?.HasNextPage != true)
                    break;

                skip += pageSize;
                continue;
            }

            if (result.Errors.Count > 0)
            {
                var message = result.Errors[0].Message;
                if (IsPageSizeExceededError(message) && pageSize > minPageSize)
                {
                    pageSize = Math.Max(minPageSize, pageSize / 2);
                    continue;
                }

                throw new InvalidOperationException(GraphQLErrorFormatter.Format(result.Errors, "Không tải được combo."));
            }

            break;
        }

        return all
            .GroupBy(c => c.Id)
            .Select(g => g.First())
            .ToList();
    }

    private IReadOnlyList<ProductComboSortInput>? BuildOrder()
    {
        var sort = new ProductComboSortInput();
        switch (_sortOption)
        {
            case "name_desc":
                sort.Name = SortEnumType.Desc;
                break;
            case "price_asc":
                sort.Price = SortEnumType.Asc;
                break;
            case "price_desc":
                sort.Price = SortEnumType.Desc;
                break;
            default:
                sort.Name = SortEnumType.Asc;
                break;
        }

        return [sort];
    }

    private bool MatchesCurrentFilter(Guid id, string? name, decimal price, IReadOnlyCollection<ComboItemDto> items)
    {
        var nameMatches = string.IsNullOrWhiteSpace(_search) || (name?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
        var priceMinMatches = !decimal.TryParse(_filterPriceMin, out var minPrice) || price >= minPrice;
        var priceMaxMatches = !decimal.TryParse(_filterPriceMax, out var maxPrice) || price <= maxPrice;
        var itemsMatches = !bool.TryParse(_filterHasItems, out var hasItems) || (hasItems ? items.Count > 0 : items.Count == 0);
        return nameMatches && priceMinMatches && priceMaxMatches && itemsMatches;
    }

    private int CurrentPage => (_skip / _take) + 1;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_total / (double)_take));
    private IEnumerable<int> VisiblePages
    {
        get
        {
            if (TotalPages <= 7)
                return Enumerable.Range(1, TotalPages);

            var start = Math.Max(1, CurrentPage - 2);
            var end = Math.Min(TotalPages, start + 4);
            start = Math.Max(1, end - 4);
            return Enumerable.Range(start, end - start + 1);
        }
    }

    private async Task GoToPageAsync(int page)
    {
        var targetPage = Math.Clamp(page, 1, TotalPages);
        _skip = (targetPage - 1) * _take;
        await LoadAsync();
    }

    private void OpenCreate() { _formName = ""; _formPriceStr = ""; ResetImageForm(); _showCreate = true; }
    private void CloseCreate() => _showCreate = false;
    private void CloseEdit() => _showEdit = false;
    private void CloseManageItems() => _showManageItems = false;

    private void OpenEdit(ComboDto item)
    {
        _editId = item.Id;
        _formName = item.Name ?? "";
        _formPriceStr = item.Price.ToString();
        _pendingImage = null;
        _imagePreviewUrl = null;
        _formImageUrl = item.ImageUrl ?? "";
        _showEdit = true;
    }

    private async Task OpenManageItemsAsync(ComboDto item)
    {
        await EnsureProductsLoadedAsync(forceRefresh: true);
        if (_allProducts.Count == 0)
            ToastService.Warning("Chưa có sản phẩm để chọn. Vui lòng tạo sản phẩm trước.");

        _currentCombo = item;
        _addProductId = null;
        _addVariantId = null;
        _addQtyStr = "1";
        _showManageItems = true;
    }

    private Task OnAddProductChanged(Guid? productId)
    {
        _addProductId = productId;
        _addVariantId = null;
        return Task.CompletedTask;
    }


    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        _pendingImage = e.File;
        var buffer = new byte[e.File.Size];
        await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        await stream.ReadExactlyAsync(buffer);
        _imagePreviewUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }

    private async Task<string?> UploadPendingImageAsync(string folder)
    {
        if (_pendingImage is null) return null;
        var url = await ImageUploadSvc.UploadAsync(_pendingImage, folder);
        _pendingImage = null;
        _imagePreviewUrl = null;
        if (url is null) ToastService.Error("Tải ảnh thất bại.");
        return url;
    }

    private void ResetImageForm()
    {
        _pendingImage = null;
        _imagePreviewUrl = null;
        _formImageUrl = "";
    }

    private async Task HandleCreate()
    {
        if (!decimal.TryParse(_formPriceStr, out var price)) return;
        _saving = true;

        var uploadedUrl = await UploadPendingImageAsync("combos");
        var imageUrl = uploadedUrl ?? (string.IsNullOrEmpty(_formImageUrl) ? null : _formImageUrl);

        var result = await Client.CreateCombo.ExecuteAsync(_formName, price, imageUrl);
        _saving = false;
        if (result.Data?.CreateCombo is { } created)
        {
            _showCreate = false;
            ToastService.Success("Đã thêm combo.");

            if (MatchesCurrentFilter(created.Id, created.Name, created.Price, []))
            {
                _total++;
                _items.Insert(0, new ComboDto(created.Id, created.Name, created.Price, [], created.ImageUrl));
                if (_items.Count > _take)
                    _items.RemoveAt(_items.Count - 1);
            }
            await PersistStateAsync();
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private async Task HandleEdit()
    {
        if (!decimal.TryParse(_formPriceStr, out var price)) return;
        _saving = true;

        var uploadedUrl = await UploadPendingImageAsync("combos");
        var imageUrl = uploadedUrl ?? (string.IsNullOrEmpty(_formImageUrl) ? null : _formImageUrl);

        var name = string.IsNullOrWhiteSpace(_formName) ? null : _formName;
        var result = await Client.UpdateCombo.ExecuteAsync(_editId!.Value, name, price, imageUrl);
        _saving = false;
        if (result.Data?.UpdateCombo is { } updated)
        {
            _showEdit = false;
            ToastService.Success("Đã cập nhật combo.");

            var index = _items.FindIndex(x => x.Id == updated.Id);
            if (index >= 0)
            {
                if (MatchesCurrentFilter(updated.Id, updated.Name, updated.Price, _items[index].Items))
                {
                    _items[index] = _items[index] with
                    {
                        Name = updated.Name,
                        Price = updated.Price,
                        ImageUrl = updated.ImageUrl
                    };
                    await PersistStateAsync();
                }
                else
                {
                    _items.RemoveAt(index);
                    _total = Math.Max(0, _total - 1);
                    if (_items.Count == 0 && _skip > 0 && _total > 0)
                    {
                        _skip = Math.Max(0, _skip - _take);
                        await LoadAsync();
                    }
                    await PersistStateAsync();
                }
            }
            else
            {
                await LoadAsync();
            }
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private void OpenDeleteConfirm(Guid id)
    {
        _pendingDeleteId = id;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (!_pendingDeleteId.HasValue)
            return;

        _showDeleteConfirm = false;
        var id = _pendingDeleteId.Value;
        _pendingDeleteId = null;
        await HandleDelete(id);
    }

    private async Task HandleDelete(Guid id)
    {
        var result = await Client.DeleteCombo.ExecuteAsync(id);
        if (result.Data?.DeleteCombo == true)
        {
            ToastService.Success("Đã xóa combo.");
            var index = _items.FindIndex(x => x.Id == id);
            if (index >= 0)
            {
                _items.RemoveAt(index);
                _total = Math.Max(0, _total - 1);

                if (_items.Count == 0 && _skip > 0 && _total > 0)
                    _skip = Math.Max(0, _skip - _take);

                if ((_items.Count < _take && _total > _items.Count) || (_items.Count == 0 && _total > 0))
                    await LoadAsync();
                else
                    await PersistStateAsync();
            }
            else
            {
                await LoadAsync();
            }
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private async Task HandleAddItem()
    {
        if (_currentCombo is null || !_addProductId.HasValue) return;
        if (!int.TryParse(_addQtyStr, out var qty) || qty <= 0) return;

        _savingItem = true;
        var result = await Client.AddComboItem.ExecuteAsync(_currentCombo.Id, _addProductId.Value, qty, _addVariantId);
        _savingItem = false;

        if (result.Data?.AddComboItem is { } updated)
        {
            ToastService.Success("Đã thêm món vào combo.");
            _addProductId = null;
            _addVariantId = null;
            _addQtyStr = "1";
            var updatedItems = updated.Items.Select(ci => new ComboItemDto(
                ci.Id, ci.ProductId, ci.Product?.Name, ci.VariantId, ci.Variant?.Name, ci.Qty)).ToList();
            _currentCombo = _currentCombo with { Items = updatedItems };

            var listIndex = _items.FindIndex(c => c.Id == _currentCombo.Id);
            if (listIndex >= 0)
                _items[listIndex] = _items[listIndex] with { Items = updatedItems };
            await PersistStateAsync();
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private async Task HandleRemoveItem(Guid itemId)
    {
        if (_currentCombo is null) return;

        var result = await Client.RemoveComboItem.ExecuteAsync(_currentCombo.Id, itemId);
        if (result.Data?.RemoveComboItem is not null)
        {
            ToastService.Success("Đã xóa món khỏi combo.");
            var updatedItems = _currentCombo.Items.Where(ci => ci.Id != itemId).ToList();
            _currentCombo = _currentCombo with { Items = updatedItems };

            var listIndex = _items.FindIndex(c => c.Id == _currentCombo.Id);
            if (listIndex >= 0)
                _items[listIndex] = _items[listIndex] with { Items = updatedItems };
            await PersistStateAsync();
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private record ProductVariantItem(Guid Id, string Name, decimal Price, int SortOrder);
    private record ProductItem(Guid Id, string Name, IReadOnlyList<ProductVariantItem> Variants);
    private record ComboItemDto(Guid Id, Guid ProductId, string? ProductName, Guid? VariantId, string? VariantName, int Qty);
    private record ComboDto(Guid Id, string? Name, decimal Price, List<ComboItemDto> Items, string? ImageUrl = null);
