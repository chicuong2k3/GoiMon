@using GoiMon.Client.State

@* Detail header *@
<div class="flex items-center justify-between px-5 py-3 border-b bg-background">
    <div>
        <span class="font-semibold text-primary">Chi tiết đơn hàng</span>
        <span class="ml-2 text-sm font-bold text-primary">#GM-@ShortId(Order.Id)</span>
    </div>
    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" OnClick="OnClose">
        <LucideIcon Name="x" Class="h-4 w-4" />
    </BbButton>
</div>

@* Detail body *@
<div class="flex-1 overflow-y-auto px-5 py-4 space-y-5">

    @* Status + Time *@
    <div class="flex items-start justify-between gap-4">
        <div class="space-y-1">
            <p class="text-xs uppercase text-muted-foreground font-semibold tracking-wider">Trạng thái</p>
            <span
                class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold @StatusBadgeCls">
                @StatusLabel
            </span>
        </div>
        <div class="space-y-1 text-right">
            <p class="text-xs uppercase text-muted-foreground font-semibold tracking-wider">Thời gian tạo</p>
            <p class="text-sm font-medium">@CreatedLabel</p>
        </div>
    </div>

    <BbSeparator />

    @* Items *@
    <div class="space-y-1">
        <p class="text-xs uppercase text-muted-foreground font-semibold tracking-wider mb-3">Danh sách món ăn</p>
        @foreach (var item in Order.Items)
        {
            <div class="flex items-center gap-3 py-2.5 border-b last:border-0">
                <div class="h-10 w-10 rounded-md bg-muted flex items-center justify-center shrink-0">
                    <LucideIcon Name="utensils" Class="h-5 w-5 text-muted-foreground" />
                </div>
                <div class="flex-1 min-w-0">
                    <p class="font-medium text-sm truncate">@item.ProductName</p>
                    <p class="text-xs text-muted-foreground">@ItemUnit(item) • x@item.Qty</p>
                    @if (item.SafeModifiers.Count > 0)
                    {
                        <p class="text-xs text-muted-foreground mt-1 truncate">@ModifierSummary(item)</p>
                    }
                </div>
                <div class="text-right shrink-0">
                    <p class="font-semibold text-sm">@ItemTotal(item)đ</p>
                    <p class="text-xs text-muted-foreground">@UnitPriceLabel(item)đ/@ItemUnit(item)</p>
                </div>
            </div>
        }
    </div>

    @* Totals *@
    <div class="space-y-2 pt-1">
        <div class="flex justify-between text-sm text-muted-foreground">
            <span>Tạm tính</span>
            <span>@TotalLabel</span>
        </div>
        <div class="flex justify-between text-sm text-muted-foreground">
            <span>Giảm giá</span>
            <span>-0đ</span>
        </div>
        <BbSeparator />
        <div class="flex justify-between font-bold text-base text-primary">
            <span>Tổng cộng</span>
            <span>@TotalLabel</span>
        </div>
    </div>
</div>

@* Action buttons — only for Open orders *@
@if (IsOpen)
{
    <div class="flex gap-3 px-5 py-4 border-t bg-background">
        <BbButton Variant="ButtonVariant.Outline" Class="flex-1" Disabled="@ActionLoading" OnClick="OnCancel">
            @if (ActionLoading && ActionType == "cancel")
            {
                <BbSpinner Size="SpinnerSize.Small" Class="mr-2" />
            }
            Hủy đơn
        </BbButton>
        <BbButton Class="flex-1" Disabled="@ActionLoading" OnClick="OnComplete">
            @if (ActionLoading && ActionType == "complete")
            {
                <BbSpinner Size="SpinnerSize.Small" Class="mr-2" />
            }
            Hoàn thành
        </BbButton>
    </div>
}

@code {
    [Parameter, EditorRequired] public OrderListItem Order { get; set; } = default!;
    [Parameter] public bool ActionLoading { get; set; }
    [Parameter] public string? ActionType { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnComplete { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool IsOpen => Order.Status == "OPEN";

    private string StatusBadgeCls => Order.Status switch
    {
        "OPEN" => "bg-amber-100 text-amber-800 border-amber-200",
        "COMPLETED" => "bg-green-100 text-green-800 border-green-200",
        "PAID" => "bg-blue-100 text-blue-800 border-blue-200",
        "CANCELLED" => "bg-red-100 text-red-800 border-red-200",
        _ => "",
    };

    private string StatusLabel => Order.Status switch
    {
        "OPEN" => "ĐANG CHUẨN BỊ",
        "COMPLETED" => "HOÀN THÀNH",
        "PAID" => "ĐÃ THANH TOÁN",
        "CANCELLED" => "ĐÃ HUỶ",
        _ => Order.Status,
    };

    private string CreatedLabel =>
        Order.CreatedAt.ToLocalTime().ToString("HH:mm, dd/MM/yyyy");

    private string TotalLabel =>
        Order.Total.ToString("#,##0") + "đ";

    private static string ItemUnit(OrderItemSnapshot item) =>
        item.UnitName ?? "đvt";

    private static string ItemTotal(OrderItemSnapshot item) =>
        (item.Qty * item.UnitPrice).ToString("#,##0");

    private static string UnitPriceLabel(OrderItemSnapshot item) =>
        item.UnitPrice.ToString("#,##0");

    private static string ModifierSummary(OrderItemSnapshot item)
    {
        var parts = item.SafeModifiers.Select(m => $"{m.GroupName}: {m.OptionName} x{m.Qty}");
        return string.Join(", ", parts);
    }

    private static string ShortId(Guid id) =>
        id.ToString("N")[..4].ToUpper();
}