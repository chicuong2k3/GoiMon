@inherits LayoutComponentBase

<BbSidebarProvider>
    <BbSidebar>
        <BbSidebarHeader>
            <div class="flex items-center gap-2 px-2 h-10">
                <div class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-primary-foreground">
                    <LucideIcon Name="utensils" Class="h-4 w-4" />
                </div>
                <span class="text-sm font-semibold">GoiMon</span>
            </div>
        </BbSidebarHeader>
        <BbSidebarContent>
            <BbSidebarGroup>
                <BbSidebarGroupLabel>Quản lý</BbSidebarGroupLabel>
                <BbSidebarMenu>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/categories">
                            <LucideIcon Name="tag" Class="h-4 w-4" />
                            <span>Danh mục</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/products">
                            <LucideIcon Name="package" Class="h-4 w-4" />
                            <span>Sản phẩm</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/combos">
                            <LucideIcon Name="layers" Class="h-4 w-4" />
                            <span>Combo</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                </BbSidebarMenu>
            </BbSidebarGroup>
        </BbSidebarContent>
        <BbSidebarFooter>
            <div class="flex items-center gap-3 px-2 py-2">
                <BbAvatar Size="AvatarSize.Small">
                    <BbAvatarFallback>GM</BbAvatarFallback>
                </BbAvatar>
                <div class="flex flex-col flex-1 min-w-0">
                    <span class="text-sm font-medium truncate">Nhà hàng Deli</span>
                    <span class="text-xs text-muted-foreground truncate">Admin</span>
                </div>
            </div>
            <BbSeparator />
            <p class="px-2 py-2 text-[10px] text-muted-foreground text-center uppercase tracking-wider">
                © 2025 GoiMon • Vendor Management
            </p>
        </BbSidebarFooter>
    </BbSidebar>
    <BbSidebarInset>
        @Body
    </BbSidebarInset>
</BbSidebarProvider>

<BbToastProvider Position="ToastPosition.BottomRight" />
<BbDialogProvider />
