<BbDialog Open="@Open" OpenChanged="@OpenChanged">
    <BbDialogContent Class="@ContentClass">
        <BbDialogHeader>
            <BbDialogTitle>@Title</BbDialogTitle>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <BbDialogDescription>@Description</BbDialogDescription>
            }
        </BbDialogHeader>
        <div class="@BodyClass">
            @ChildContent
        </div>
        <BbDialogFooter>
            <BbDialogClose>
                <BbButton Variant="ButtonVariant.Outline">@CancelText</BbButton>
            </BbDialogClose>
            <BbButton Variant="@SubmitVariant"          Loading="@SubmitLoading"                LoadingText="@SubmitLoadingText"
                      Disabled="@SubmitDisabled"           OnClick="@OnSubmit">
                @SubmitText
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string SubmitText { get; set; } = "Lưu";
    [Parameter] public string CancelText { get; set; } = "Hủy";
    [Parameter] public ButtonVariant SubmitVariant { get; set; } = ButtonVariant.Default;
    [Parameter] public bool SubmitLoading { get; set; }
    [Parameter] public string SubmitLoadingText { get; set; } = "Đang lưu...";
    [Parameter] public bool SubmitDisabled { get; set; }
    [Parameter] public string ContentClass { get; set; } = "max-w-md max-h-[90dvh] overflow-y-auto";
    [Parameter] public string BodyClass { get; set; } = "space-y-3 py-4 pr-1 max-h-[60vh] overflow-y-auto";
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public EventCallback OnSubmit { get; set; }
}