@page "/prototype/cashier"
@layout PrototypeLayout
@using BlazorBlueprint.Components

<div class="p-6 max-w-7xl mx-auto">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h2 class="text-3xl font-bold tracking-tight mb-2">Sơ đồ bàn</h2>
            <div class="flex flex-wrap gap-4">
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full bg-border"></div>
                    <span class="text-xs text-muted-foreground">Trống</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full bg-primary/40"></div>
                    <span class="text-xs text-muted-foreground">Đã đặt</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full bg-primary shadow-[0_0_8px_rgba(22,163,74,0.5)]"></div>
                    <span class="text-xs text-muted-foreground">Đang phục vụ</span>
                </div>
            </div>
        </div>

        <div class="flex gap-2">
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small">
                <LucideIcon Name="filter" Class="h-4 w-4 mr-2" />
                Lọc khu vực
            </BbButton>
            <BbButton Size="ButtonSize.Small">
                <LucideIcon Name="plus" Class="h-4 w-4 mr-2" />
                Mở bàn nhanh
            </BbButton>
        </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
        @foreach (var table in _tables)
        {
            <a href="/prototype/cashier/order/@table.Id" 
               class="group relative flex flex-col justify-between p-4 rounded-xl border bg-card/40 backdrop-blur-sm hover:bg-card hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden cursor-pointer
                      @(table.Status == "Occupied" ? "border-primary/50 shadow-[inset_0_0_20px_rgba(22,163,74,0.05)]" : "border-border")">
                
                @if (table.Status == "Occupied")
                {
                    <div class="absolute top-0 right-0 w-12 h-12 overflow-hidden">
                        <div class="absolute top-2 -right-4 w-16 h-4 bg-primary text-[8px] font-bold text-primary-foreground text-center flex items-center justify-center uppercase tracking-widest rotate-45">
                            Serving
                        </div>
                    </div>
                }

                <div class="flex justify-between items-start mb-4">
                    <div class="flex items-center gap-2">
                        <div class="p-2 rounded-lg @(table.Status == "Occupied" ? "bg-primary text-primary-foreground" : "bg-muted text-muted-foreground") transition-colors group-hover:scale-110 duration-300">
                            <LucideIcon Name="table-2" Class="h-4 w-4" />
                        </div>
                        <span class="text-sm font-bold">@table.Name</span>
                    </div>
                </div>

                <div class="flex flex-col gap-1">
                    <div class="flex justify-between items-center text-[10px] text-muted-foreground uppercase tracking-widest italic font-medium">
                        <span>Sức chứa</span>
                        <span>@table.Capacity người</span>
                    </div>
                    @if (table.Status == "Occupied")
                    {
                        <div class="mt-2 pt-2 border-t border-border/50 flex justify-between items-end">
                            <div class="flex flex-col">
                                <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-tighter">Tổng tiền</span>
                                <span class="text-sm font-bold text-primary">@table.CurrentTotal.ToString("N0")đ</span>
                            </div>
                            <span class="text-[9px] text-muted-foreground">@table.ActiveTime</span>
                        </div>
                    }
                    else
                    {
                        <span class="mt-2 text-[10px] text-muted-foreground font-medium uppercase tracking-tighter">Sẵn sàng</span>
                    }
                </div>
            </a>
        }
    </div>
</div>

@code {
    private List<TableMock> _tables = new()
    {
        new("1", "Bàn 01", 4, "Occupied", 450000, "45p"),
        new("2", "Bàn 02", 4, "Empty"),
        new("3", "Bàn 03", 2, "Occupied", 120000, "15p"),
        new("4", "Bàn 04", 6, "Empty"),
        new("5", "Bàn 05", 4, "Reserved"),
        new("6", "Bàn 06", 4, "Occupied", 890000, "1h 10p"),
        new("7", "Bàn 07", 2, "Empty"),
        new("8", "Bàn 08", 4, "Empty"),
        new("9", "Bàn 09", 4, "Occupied", 35000, "5p"),
        new("10", "Bàn 10", 6, "Empty"),
        new("11", "Bàn 11", 8, "Empty"),
        new("12", "Bàn 12", 4, "Empty"),
    };

    public record TableMock(string Id, string Name, int Capacity, string Status, decimal CurrentTotal = 0, string ActiveTime = "");
}
