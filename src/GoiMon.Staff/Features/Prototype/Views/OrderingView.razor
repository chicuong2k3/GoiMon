@page "/prototype/cashier/order/{TableId}"
@layout PrototypeLayout
@using BlazorBlueprint.Components

<div class="flex h-full overflow-hidden">
    <!-- Main Ordering Area -->
    <div class="flex-1 flex flex-col min-w-0 bg-background/30">
        <!-- Header with search and categories -->
        <div class="p-6 pb-2 border-b bg-card/10 backdrop-blur-sm">
            <div class="flex items-center gap-4 mb-6">
                <a href="/prototype/cashier" class="p-2 hover:bg-muted rounded-lg transition-colors">
                    <LucideIcon Name="arrow-left" Class="h-5 w-5" />
                </a>
                <h2 class="text-2xl font-bold tracking-tight shrink-0">Bàn @TableId</h2>
                
                <div class="relative flex-1 group">
                    <LucideIcon Name="search" Class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground group-focus-within:text-primary transition-colors" />
                    <input type="text" placeholder="Tìm tên món hoặc mã..." 
                           class="w-full bg-background/50 border border-border rounded-xl pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all shadow-sm"
                           @bind="_searchQuery" @bind:event="oninput" />
                </div>
            </div>

            <div class="flex gap-2 overflow-x-auto pb-4 scrollbar-hide no-scrollbar">
                @foreach (var cat in _categories)
                {
                    <button @onclick="() => _selectedCategory = cat"
                            class="px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-widest whitespace-nowrap transition-all duration-300 border
                                   @(_selectedCategory == cat ? "bg-primary text-primary-foreground border-primary shadow-md scale-105" : "bg-card/40 text-muted-foreground border-border hover:border-primary/50 hover:bg-card")">
                        @cat
                    </button>
                }
            </div>
        </div>

        <!-- Product Grid -->
        <div class="flex-1 overflow-y-auto p-6 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
            @foreach (var prod in FilteredProducts)
            {
                <button @onclick="() => AddToCart(prod)"
                        class="group flex flex-col h-full bg-card/40 backdrop-blur-sm border border-border rounded-2xl overflow-hidden hover:bg-card hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-left">
                    <div class="aspect-square w-full bg-muted relative overflow-hidden">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-3 opacity-0 group-hover:opacity-100 transition-opacity">
                            <span class="text-[10px] font-bold text-white uppercase tracking-widest">+ Thêm vào đơn</span>
                        </div>
                        @if (!string.IsNullOrEmpty(prod.Image))
                        {
                            <img src="@prod.Image" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="@prod.Name" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-muted-foreground/20">
                                <LucideIcon Name="image" Class="h-12 w-12" />
                            </div>
                        }
                    </div>
                    <div class="p-4 flex flex-col flex-1">
                        <h3 class="font-bold text-sm mb-1 group-hover:text-primary transition-colors">@prod.Name</h3>
                        <p class="text-[10px] text-muted-foreground line-clamp-1 mb-3">Lorem ipsum dolor sit amet conset...</p>
                        <div class="mt-auto flex justify-between items-end">
                            <span class="text-sm font-bold text-primary">@prod.Price.ToString("N0")đ</span>
                            <div class="p-1 rounded-lg bg-primary/10 text-primary opacity-0 group-hover:opacity-100 transition-all">
                                <LucideIcon Name="plus" Class="h-4 w-4" />
                            </div>
                        </div>
                    </div>
                </button>
            }
        </div>
    </div>

    <!-- Right Sidebar: Cart -->
    <div class="w-96 border-l bg-card/60 backdrop-blur-xl flex flex-col shadow-2xl relative z-20">
        <div class="p-6 pb-4 border-b">
            <div class="flex justify-between items-center mb-1">
                <h2 class="text-xl font-bold">Chi tiết đơn</h2>
                <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary text-[10px] font-bold uppercase">@_cart.Sum(x => x.Quantity) Món</span>
            </div>
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest">Thời gian: @DateTime.Now.ToString("HH:mm:ss")</p>
        </div>

        <div class="flex-1 overflow-y-auto p-4 space-y-3">
            @if (!_cart.Any())
            {
                <div class="h-full flex flex-col items-center justify-center text-muted-foreground/30 opacity-50 space-y-4">
                    <LucideIcon Name="shopping-basket" Class="h-16 w-16" />
                    <p class="text-xs font-medium uppercase tracking-widest">Chưa có món nào</p>
                </div>
            }
            else
            {
                @foreach (var item in _cart)
                {
                    <div class="flex items-center gap-3 p-3 rounded-xl bg-background/50 border border-border group animate-in slide-in-from-right duration-300">
                        <div class="h-12 w-12 rounded-lg bg-muted overflow-hidden flex-shrink-0">
                             <img src="@item.Product.Image" class="w-full h-full object-cover" />
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold truncate">@item.Product.Name</h4>
                            <span class="text-[10px] font-bold text-primary">@item.Product.Price.ToString("N0")đ</span>
                        </div>
                        <div class="flex items-center gap-2 bg-muted/50 rounded-lg p-1">
                            <button @onclick="() => UpdateQty(item, -1)" class="w-6 h-6 flex items-center justify-center hover:bg-background rounded-md transition-colors"><LucideIcon Name="minus" Class="h-3 w-3"/></button>
                            <span class="text-xs font-bold w-4 text-center">@item.Quantity</span>
                            <button @onclick="() => UpdateQty(item, 1)" class="w-6 h-6 flex items-center justify-center hover:bg-background rounded-md transition-colors"><LucideIcon Name="plus" Class="h-3 w-3"/></button>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="p-6 bg-card border-t shadow-[0_-8px_30px_rgb(0,0,0,0.05)]">
            <div class="space-y-2 mb-6">
                <div class="flex justify-between text-xs text-muted-foreground">
                    <span>Tạm tính</span>
                    <span>@CartSubtotal.ToString("N0")đ</span>
                </div>
                <div class="flex justify-between text-xs text-muted-foreground">
                    <span>Thuế (10%)</span>
                    <span>@((CartSubtotal * 0.1m).ToString("N0"))đ</span>
                </div>
                <div class="flex justify-between items-center pt-2 border-t mt-2">
                    <span class="text-sm font-bold">Tổng cộng</span>
                    <span class="text-xl font-black text-primary">@CartTotal.ToString("N0")đ</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="w-full rounded-xl py-6" @onclick="ClearCart">
                    Hủy đơn
                </BbButton>
                <BbButton Size="ButtonSize.Small" Class="w-full rounded-xl py-6 shadow-lg shadow-primary/20" @onclick="OpenPayment">
                    Thanh toán
                </BbButton>
            </div>
        </div>
    </div>
</div>

@if (_showPayment)
{
    <div class="fixed inset-0 bg-black/40 backdrop-blur-md z-[100] flex items-center justify-center p-4 animate-in fade-in duration-300">
        <div class="bg-card w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden animate-in zoom-in-95 duration-300">
            <div class="p-8 pb-0 text-center">
                <div class="w-20 h-20 rounded-full bg-primary/10 text-primary mx-auto flex items-center justify-center mb-6">
                    <LucideIcon Name="credit-card" Class="h-10 w-10" />
                </div>
                <h3 class="text-2xl font-black mb-2">Chọn hình thức</h3>
                <p class="text-muted-foreground text-sm">Tổng cộng: <span class="font-bold text-foreground">@CartTotal.ToString("N0")đ</span></p>
            </div>

            <div class="p-8 grid grid-cols-2 gap-4">
                <button @onclick="ProcessPayment" class="p-6 border-2 border-border rounded-2xl hover:border-primary hover:bg-primary/5 transition-all flex flex-col items-center gap-3">
                    <LucideIcon Name="banknote" Class="h-8 w-8 text-muted-foreground" />
                    <span class="font-bold">Tiền mặt</span>
                </button>
                <button @onclick="ProcessPayment" class="p-6 border-2 border-border rounded-2xl hover:border-primary hover:bg-primary/5 transition-all flex flex-col items-center gap-3">
                    <LucideIcon Name="qr-code" Class="h-8 w-8 text-muted-foreground" />
                    <span class="font-bold">Chuyển khoản</span>
                </button>
            </div>

            <div class="p-8 pt-0 flex justify-center">
                 <button @onclick="() => _showPayment = false" class="text-muted-foreground text-xs font-bold uppercase tracking-widest hover:text-foreground">Quay lại</button>
            </div>
        </div>
    </div>
}

@if (_showSuccess)
{
    <div class="fixed inset-0 bg-primary z-[200] flex flex-col items-center justify-center p-4 animate-in fade-in duration-500">
        <div class="text-primary-foreground text-center animate-in zoom-in-50 duration-500">
            <div class="w-32 h-32 rounded-full border-8 border-white/20 flex items-center justify-center mx-auto mb-8 relative">
                <div class="absolute inset-0 rounded-full border-8 border-white border-t-transparent animate-spin opacity-20"></div>
                <LucideIcon Name="check" Class="h-16 w-16" />
            </div>
            <h2 class="text-5xl font-black mb-4 tracking-tighter">THÀNH CÔNG!</h2>
            <p class="text-white/80 max-w-xs mx-auto mb-12">Đơn hàng @TableId đã được xử lý. Hóa đơn đang được in...</p>
            <BbButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Class="px-12 py-6 rounded-full font-black text-lg shadow-2xl" @onclick="ResetPrototype">
                TIẾP TỤC
            </BbButton>
        </div>
    </div>
}

@code {
    [Parameter] public string TableId { get; set; } = string.Empty;
    [CascadingParameter(Name = "IsOffline")] public bool IsOffline { get; set; }

    @inject IJSRuntime JS
    @inject NavigationManager Nav

    private string _searchQuery = "";
    private string _selectedCategory = "Tất cả";
    private bool _showPayment = false;
    private bool _showSuccess = false;

    private List<string> _categories = new() { "Tất cả", "Cà phê", "Trà trái cây", "Soda", "Đá xay", "Bánh ngọt", "Ăn vặt" };

    private List<ProductMock> _products = new()
    {
        new("1", "Cà phê Sữa Đá", 35000, "Cà phê", "https://images.unsplash.com/photo-1541167760496-1628856ab772?q=80&w=200&auto=format&fit=crop"),
        new("2", "Bạc Xỉu", 39000, "Cà phê", "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=200&auto=format&fit=crop"),
        new("3", "Trà Đào Cam Sả", 45000, "Trà trái cây", "https://images.unsplash.com/photo-1556679343-c7306c1976bc?q=80&w=200&auto=format&fit=crop"),
        new("4", "Trà Vải Khiếm", 45000, "Trà trái cây", "https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?q=80&w=200&auto=format&fit=crop"),
        new("5", "Soda Blue Ocean", 42000, "Soda", "https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?q=80&w=200&auto=format&fit=crop"),
        new("6", "Matcha Đá Xay", 55000, "Đá xay", "https://images.unsplash.com/photo-1534706936160-d5ee67733579?q=80&w=200&auto=format&fit=crop"),
        new("7", "Cookie Cream", 55000, "Đá xay", "https://images.unsplash.com/photo-1572490122747-3968b75cc699?q=80&w=200&auto=format&fit=crop"),
        new("8", "Tiramisu", 49000, "Bánh ngọt", "https://images.unsplash.com/photo-1571877227200-a0d98ea607e9?q=80&w=200&auto=format&fit=crop"),
        new("9", "Croissant", 29000, "Bánh ngọt", "https://images.unsplash.com/photo-1555507036-ab1f4038808a?q=80&w=200&auto=format&fit=crop"),
        new("10", "Khoai tây chiên", 35000, "Ăn vặt", "https://images.unsplash.com/photo-1573082882294-063f2f9088f4?q=80&w=200&auto=format&fit=crop"),
    };

    private List<CartItem> _cart = new();

    private IEnumerable<ProductMock> FilteredProducts => _products
        .Where(p => _selectedCategory == "Tất cả" || p.Category == _selectedCategory)
        .Where(p => string.IsNullOrEmpty(_searchQuery) || p.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));

    private decimal CartSubtotal => _cart.Sum(x => x.Product.Price * x.Quantity);
    private decimal CartTotal => CartSubtotal * 1.1m;

    private void AddToCart(ProductMock prod)
    {
        var existing = _cart.FirstOrDefault(x => x.Product.Id == prod.Id);
        if (existing != null)
        {
            existing.Quantity++;
        }
        else
        {
            _cart.Add(new CartItem(prod, 1));
        }
    }

    private void UpdateQty(CartItem item, int delta)
    {
        item.Quantity += delta;
        if (item.Quantity <= 0) _cart.Remove(item);
    }

    private void ClearCart() => _cart.Clear();

    private void OpenPayment()
    {
        if (!_cart.Any()) return;
        _showPayment = true;
    }

    private async Task ProcessPayment()
    {
        _showPayment = false;
        _showSuccess = true;
        // In prototype, we just wait a bit
        await Task.Delay(2000);
    }

    private void ResetPrototype()
    {
        Nav.NavigateTo("/prototype/cashier");
    }

    public record ProductMock(string Id, string Name, decimal Price, string Category, string Image);
    public class CartItem
    {
        public ProductMock Product { get; }
        public int Quantity { get; set; }
        public CartItem(ProductMock product, int quantity) { Product = product; Quantity = quantity; }
    }
}
