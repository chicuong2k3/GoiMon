@page "/authentication"
@page "/authentication/google-callback"
@page "/authentication/facebook-callback"
@inherits StoreComponentWithUtilities<AuthUiState>
@using GoiMon.Staff.Features.Authentication.Helpers
@using GoiMon.Staff.Features.Authentication.Components
@using GoiMon.Staff.Features.Authentication.Services
@using GoiMon.Staff.State
@using EasyAppDev.Blazor.Store.Core

@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject ILogger<Authentication> Logger
@inject ITokenStorageService TokenStorage
@inject GoimonAuthenticationStateProvider AuthProvider
@inject IGoiMonClient Client
@inject IStateWriter<AuthUiState> UiStateWriter

<div class="flex min-h-[80vh] items-center justify-center p-4">
    <BbCard Class="w-full max-w-md">
        <BbCardHeader Class="text-center space-y-1">
            <BbCardTitle>Welcome to GoiMon</BbCardTitle>
            <BbCardDescription>Sign in with your social account</BbCardDescription>
        </BbCardHeader>

        <BbCardContent Class="space-y-4">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <BbAlert Variant="AlertVariant.Danger">
                    <BbAlertTitle>Error</BbAlertTitle>
                    <BbAlertDescription>@ErrorMessage</BbAlertDescription>
                </BbAlert>
            }

            @if (IsShowingOtpVerification)
            {
                <GoiMon.Staff.Features.Authentication.Components.OtpVerification DeliveryMethod="@SelectedDeliveryMethod"
                                                                                 UserId="@CurrentUserId"
                                                                                 OnVerificationSuccess="OnOtpVerified"
                                                                                 OnError="OnOtpError" />
            }
            else
            {
                @* OTP delivery method is configured in app settings; UI selection removed. *@

                <div class="grid gap-3">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="OnGoogleClicked" Disabled="@IsLoading"
                              Class="w-full">
                        @if (IsLoading)
                        {
                            <BbSpinner Class="mr-2 h-4 w-4" />
                        }
                        else
                        {
                            <img src="https://www.google.com/favicon.ico" alt="Google" class="mr-2 h-4 w-4" />
                        }
                        Sign in with Google
                    </BbButton>

                    <BbButton Variant="ButtonVariant.Default" OnClick="OnFacebookClicked" Disabled="@IsLoading"
                              Class="w-full">
                        @if (IsLoading)
                        {
                            <BbSpinner Class="mr-2 h-4 w-4" />
                        }
                        else
                        {
                            <LucideIcon Name="facebook" Class="mr-2 h-4 w-4" />
                        }
                        Sign in with Facebook
                    </BbButton>
                </div>
            }
        </BbCardContent>

    </BbCard>
</div>

@code {
    private bool IsLoading;
    private string? ErrorMessage;
    private string? _returnUrl;

    private bool IsShowingOtpVerification => State.OtpPendingUserId.HasValue;
    private Guid CurrentUserId => State.OtpPendingUserId ?? Guid.Empty;
    private string SelectedDeliveryMethod => State.DeliveryMethod;

    protected override async Task OnInitializedAsync()
    {
        var currentUri = new Uri(Navigation.Uri);
        _returnUrl = GetReturnUrl(currentUri);

        var deliveryMethod = Configuration["Auth:OtpDeliveryMethod"] ?? Configuration["otpDeliveryMethod"] ?? "email";
        if (!string.Equals(State.DeliveryMethod, deliveryMethod, StringComparison.OrdinalIgnoreCase))
            await UiStateWriter.UpdateAsync(s => s with { DeliveryMethod = deliveryMethod }, "auth.delivery");

        var idToken = OAuthHelper.ExtractTokenFromFragment(currentUri.Fragment);
        if (!string.IsNullOrWhiteSpace(idToken))
        {
            IsLoading = true;
            try
            {
                await HandleOAuthCallbackAsync(idToken);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "OAuth callback failed");
                ErrorMessage = "Unable to connect to the server. Please try again.";
            }
            finally
            {
                IsLoading = false;
            }
            return;
        }

        if (await TokenStorage.HasTokenAsync())
        {
            Navigation.NavigateTo(_returnUrl ?? "/", replace: true);
        }
    }

    private async Task HandleOAuthCallbackAsync(string idToken)
    {
        var delivery = SelectedDeliveryMethod.Equals("sms", StringComparison.OrdinalIgnoreCase)
            ? OtpDeliveryMethod.Sms
            : OtpDeliveryMethod.Email;

        string? token = null;
        bool requiresOtp = false;
        Guid userId = Guid.Empty;
        string email = string.Empty;
        string? firstName = null;
        string? lastName = null;
        bool isVerified = false;

        var authResult = await Client.AuthenticateWithGoogle.ExecuteAsync(idToken, delivery);
        if (authResult.IsErrorResult() || authResult.Data?.AuthenticateWithGoogle is null)
        {
            ErrorMessage = authResult.Errors.FirstOrDefault()?.Message ?? "Authentication failed. Please try again.";
            Logger.LogWarning("AuthenticateWithGoogle failed: {Error}", ErrorMessage);
            return;
        }
        var ad = authResult.Data.AuthenticateWithGoogle;
        token = ad.Token; requiresOtp = ad.RequiresOtpVerification;
        userId = ad.User.Id; email = ad.User.Email;
        firstName = ad.User.FirstName; lastName = ad.User.LastName; isVerified = ad.User.IsVerified;

        if (!requiresOtp && !string.IsNullOrEmpty(token))
        {
            await UiStateWriter.UpdateAsync(s => s with { OtpPendingUserId = null }, "auth.otp");
            var user = new Features.Authentication.Models.AuthenticationUser
            {
                Email = email,
                DisplayName = $"{firstName} {lastName}".Trim(),
                IsVerified = isVerified
            };
            await AuthProvider.LoginAsync(token, user);
            Navigation.NavigateTo(_returnUrl ?? "/", replace: true);
        }
        else
        {
            await UiStateWriter.UpdateAsync(s => s with { OtpPendingUserId = userId }, "auth.otp");
        }
    }

    private async Task OnOtpVerified(string otpCode)
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await Client.VerifyOtp.ExecuteAsync(CurrentUserId, otpCode);
            if (result.IsErrorResult() || result.Data?.VerifyOtp is null || !result.Data.VerifyOtp.Success)
            {
                ErrorMessage = result.Errors.FirstOrDefault()?.Message
                    ?? result.Data?.VerifyOtp?.Message
                    ?? "OTP verification failed.";
                return;
            }

            var data = result.Data.VerifyOtp;
            await UiStateWriter.UpdateAsync(s => s with { OtpPendingUserId = null }, "auth.otp");
            var user = new Features.Authentication.Models.AuthenticationUser
            {
                Email = data.User?.Email ?? string.Empty,
                DisplayName = $"{data.User?.FirstName} {data.User?.LastName}".Trim(),
                IsVerified = data.User?.IsVerified ?? true
            };
            await AuthProvider.LoginAsync(data.Token!, user);
            Navigation.NavigateTo(_returnUrl ?? "/", replace: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task OnOtpError(string error)
    {
        ErrorMessage = error;
        return Task.CompletedTask;
    }

    private static string? GetReturnUrl(Uri uri)
    {
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrWhiteSpace(query))
            return null;

        foreach (var segment in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = segment.Split('=', 2);
            if (parts.Length != 2) continue;
            if (!string.Equals(parts[0], "returnUrl", StringComparison.OrdinalIgnoreCase)) continue;
            var decoded = Uri.UnescapeDataString(parts[1]);
            if (string.IsNullOrWhiteSpace(decoded)) return null;
            return decoded.StartsWith('/') ? decoded : "/" + decoded;
        }

        return null;
    }

    private async Task OnGoogleClicked()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            var clientId = Configuration["OAuth:Google:ClientId"];
            var redirectUri = Configuration["OAuth:Google:RedirectUri"];

            if (string.IsNullOrEmpty(clientId) || string.IsNullOrEmpty(redirectUri))
            {
                ErrorMessage = "Google OAuth is not configured. Please contact support.";
                Logger.LogError("Google OAuth ClientId or RedirectUri not configured");
                return;
            }

            var authUrl = OAuthHelper.GetGoogleAuthUrl(clientId, redirectUri);
            Navigation.NavigateTo(authUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during Google OAuth");
            ErrorMessage = "An error occurred. Please try again.";
            IsLoading = false;
        }
    }

    private async Task OnFacebookClicked()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = null;

            var appId = Configuration["OAuth:Facebook:AppId"];
            var redirectUri = Configuration["OAuth:Facebook:RedirectUri"];

            if (string.IsNullOrEmpty(appId) || string.IsNullOrEmpty(redirectUri))
            {
                ErrorMessage = "Facebook OAuth is not configured. Please contact support.";
                Logger.LogError("Facebook OAuth AppId or RedirectUri not configured");
                return;
            }

            var authUrl = OAuthHelper.GetFacebookAuthUrl(appId, redirectUri);
            Navigation.NavigateTo(authUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during Facebook OAuth");
            ErrorMessage = "An error occurred. Please try again.";
            IsLoading = false;
        }
    }

    // Delivery selection is configured via settings; no runtime selector.
}
