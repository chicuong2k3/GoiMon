    }

    private async Task RefreshProductRowAsync()
    {
        if (_configuringProductId is null) return;
        var idx = _items.FindIndex(x => x.Id == _configuringProductId.Value);
        if (idx < 0) return;
        _items[idx] = _items[idx] with
        {
            ActiveVariantCount = _variants.Count(v => v.IsActive),
            ActiveModifierGroupCount = _modifierGroups.Count(g => g.IsActive)
        };
        await PersistStateAsync();
    }

