@code {
    private static readonly CultureInfo VnCulture = CultureInfo.GetCultureInfo("vi-VN");

    private static string FormatNumber(decimal amount)
        => amount.ToString("N0", VnCulture);

    private static string FormatCurrency(decimal amount)
        => string.Concat(FormatNumber(amount), "đ");

    private List<ProductDto> _items = new List<ProductDto>();
    private List<CategoryItem> _allCategories = new List<CategoryItem>();
    private bool _loading, _saving;
    private int _skip, _take = 5, _total;
    private string _search = "";
    private Guid? _filterCategoryId;
    private string _filterPriceMin = "";
    private string _filterPriceMax = "";
    private (double Start, double End) _priceRange = (0, 500000);
    private int _priceRangeMax = 500000;
    private bool _priceRangeInitialized;
    private string _sortOption = "name_asc";
    private string? _error;

    private bool _showCreate, _showEdit;
    private Guid? _editId;
    private string _formName = "";
    private string _formPriceStr = "";
    private string _formUnitName = "";
    private Guid? _formCategoryId;
    private string _formDescription = "";
    private string _formImageUrl = "";
    private string? _imagePreviewUrl;
    private IBrowserFile? _pendingImage;
    private string? DisplayImageUrl => _imagePreviewUrl ?? (string.IsNullOrEmpty(_formImageUrl) ? null : _formImageUrl);
    private bool HasImage => DisplayImageUrl is not null;
    private bool _showDeleteConfirm;
    private Guid? _pendingDeleteId;
    private HashSet<Guid> _selectedIds = new HashSet<Guid>();
    private bool _showBulkDeleteConfirm;
    private bool _bulkDeleting;

    private bool AllSelected => _items.Count > 0 && _items.All(i => _selectedIds.Contains(i.Id));

    private void ToggleSelect(Guid id, bool selected)
    {
        if (selected) _selectedIds.Add(id);
        else _selectedIds.Remove(id);
        _ = PersistStateAsync();
    }

    private void ToggleSelectAll(bool selected)
    {
        if (selected)
            foreach (var id in _items.Select(i => i.Id)) _selectedIds.Add(id);
        else
            foreach (var id in _items.Select(i => i.Id)) _selectedIds.Remove(id);
        _ = PersistStateAsync();
    }

    private void OpenBulkDeleteConfirm() => _showBulkDeleteConfirm = true;

    private async Task HandleBulkDelete()
    {
        _bulkDeleting = true;
        var ids = _selectedIds.ToList();
        var tasks = ids.Select(id => Client.DeleteProduct.ExecuteAsync(id));
        var results = await Task.WhenAll(tasks);
        _bulkDeleting = false;
        _showBulkDeleteConfirm = false;

        var deleted = results.Count(r => r.Data?.DeleteProduct == true);
        _selectedIds.Clear();

        if (deleted > 0)
        {
            ToastService.Success($"Đã xóa {deleted} sản phẩm.");
            await LoadAsync();
        }
        if (deleted < ids.Count)
            ToastService.Error($"{ids.Count - deleted} sản phẩm không thể xóa.");
    }

    private static readonly List<SelectOption<string>> SortOptions =
    [
        new("name_asc", "Tên A → Z"),
        new("name_desc", "Tên Z → A"),
        new("price_asc", "Giá tăng dần"),
        new("price_desc", "Giá giảm dần")
    ];

    private List<SelectOption<Guid?>> CategoryOptions =>
        [new SelectOption<Guid?>(null, "Không có"), .. _allCategories.Select(c => new SelectOption<Guid?>(c.Id, c.Name))];

    private List<SelectOption<Guid?>> FilterCategoryOptions =>
        [new SelectOption<Guid?>(null, "Tất cả danh mục"), .. _allCategories.Select(c => new SelectOption<Guid?>(c.Id, c.Name))];

    protected override async Task OnInitializedAsync()
    {
        if (TryRestoreState())
        {
            _ = LoadCategoriesAsync(silent: true);
            return;
        }

        await Task.WhenAll(LoadCategoriesAsync(), LoadAsync(showLoading: true));
    }

    private bool TryRestoreState()
    {
        var cached = State.Cache;
        if (cached is null) return false;

        _search = cached.Search;
        _filterCategoryId = cached.FilterCategoryId;
        _skip = cached.Skip;
        _take = cached.Take;
        _total = cached.Total;
        _items = cached.Items.Select(i => new ProductDto(i.Id, i.Name, i.Price, i.UnitName, i.Description, i.CategoryId, i.CategoryName, i.ImageUrl)).ToList();
        _allCategories = cached.Categories.Select(c => new CategoryItem(c.Id, c.Name)).ToList();
        _selectedIds = cached.SelectedIds.ToHashSet();
        return true;
    }

    private Task PersistStateAsync()
    {
        var snapshot = new ProductPageCache(
            _search,
            _filterCategoryId,
            _skip,
            _take,
            _total,
            _items.Select(i => new ProductListItem(i.Id, i.Name, i.Price, i.UnitName, i.Description, i.CategoryId, i.CategoryName, i.ImageUrl)).ToList(),
            _allCategories.Select(c => new CategoryLookupItem(c.Id, c.Name)).ToList(),
            _selectedIds.ToList());

        return UiStateWriter.UpdateAsync(s => s with { Cache = snapshot }, "cache.products");
    }

    private Task OnSearchChangedAsync(string value)
    {
        _search = value;
        _skip = 0;
        return DebounceReloadAsync("products.search.load");
    }

    private Task OnFilterCategoryChangedAsync(Guid? value)
    {
        _filterCategoryId = value;
        _skip = 0;
        return ReloadAsyncNonBlocking();
    }

    private Task OnSortOptionChangedAsync(string value)
    {
        _sortOption = value;
        _skip = 0;
        return ReloadAsyncNonBlocking();
    }

    private Task ReloadAsyncNonBlocking()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync(showLoading: true);
            StateHasChanged();
        });

        return Task.CompletedTask;
    }

    private Task OnPriceRangeChangedAsync((double Start, double End) value)
    {
        _priceRange = value;
        _filterPriceMin = ((int)value.Start).ToString();
        _filterPriceMax = ((int)value.End).ToString();
        _skip = 0;
        return DebounceReloadAsync("products.price-range.load", 200);
    }

    private Task DebounceReloadAsync(string key, int delayMs = 300)
    {
        return DebounceManager.Debounce(
            key,
            async () => await InvokeAsync(async () => await LoadAsync()),
            delayMs);
    }

    private async Task LoadCategoriesAsync(bool silent = false)
    {
        try
        {
            var asyncExecutor = RequireAsyncExecutor();
            _allCategories = await asyncExecutor.ExecuteCachedAsync(
                "products.lookup.categories",
                FetchAllCategoriesFromApiAsync,
                loading: state => state,
                success: (state, categories) => state with
                {
                    Cache = BuildCacheWithCategories(state.Cache, categories)
                },
                error: (state, _) => state,
                cacheFor: TimeSpan.FromMinutes(5));
        }
        catch (Exception ex)
        {
            if (!silent)
                ToastService.Warning($"Không tải được danh mục: {ex.Message}");
        }
    }

    private async Task EnsureCategoriesLoadedAsync(bool forceRefresh = false)
    {
        var asyncExecutor = RequireAsyncExecutor();
        if (forceRefresh)
            await asyncExecutor.InvalidateCacheAsync("products.lookup.categories");

        if (forceRefresh || _allCategories.Count == 0)
            await LoadCategoriesAsync(silent: true);
    }

    private IAsyncActionExecutor<ProductsUiState> RequireAsyncExecutor()
        => AsyncExecutor ?? throw new InvalidOperationException("AsyncExecutor is not available.");

    private static ProductPageCache BuildCacheWithCategories(ProductPageCache? currentCache, IReadOnlyList<CategoryItem> categories)
    {
        var categoryLookup = categories.Select(c => new CategoryLookupItem(c.Id, c.Name)).ToList();

        if (currentCache is null)
        {
            return new ProductPageCache(string.Empty, null, 0, 5, 0, [], categoryLookup, []);
        }

        return currentCache with { Categories = categoryLookup };
    }

    private async Task<List<CategoryItem>> FetchAllCategoriesFromApiAsync()
    {
        var pageSize = 100;
        const int minPageSize = 1;
        var skip = 0;
        var all = new List<CategoryItem>();

        while (true)
        {
            var result = await Client.GetCategories.ExecuteAsync(skip, pageSize, null, [new CategorySortInput { Name = SortEnumType.Asc }]);
            if (result.Data?.CategoriesOffset is { } data)
            {
                if (data.Items is { } cats)
                    all.AddRange(cats.Select(c => new CategoryItem(c.Id, c.Name)));

                if (data.PageInfo?.HasNextPage != true)
                    break;

                skip += pageSize;
                continue;
            }

            if (result.Errors.Count > 0)
            {
                var message = result.Errors[0].Message;
                if (IsPageSizeExceededError(message) && pageSize > minPageSize)
                {
                    pageSize = Math.Max(minPageSize, pageSize / 2);
                    continue;
                }

                throw new InvalidOperationException(message);
            }

            break;
        }

        return all
            .GroupBy(c => c.Id)
            .Select(g => g.First())
            .ToList();
    }

    private static bool IsPageSizeExceededError(string message)
        => message.Contains("maximum allowed items per page", StringComparison.OrdinalIgnoreCase)
           || message.Contains("items per page", StringComparison.OrdinalIgnoreCase)
           || message.Contains("page size", StringComparison.OrdinalIgnoreCase)
           || message.Contains("take", StringComparison.OrdinalIgnoreCase);

    private async Task LoadAsync(bool showLoading = false)
    {
        _loading = showLoading;
        _error = null;
        if (showLoading)
            StateHasChanged();
        try
        {
            await SyncPriceRangeBoundsAsync();

            var serverFilter = BuildServerFilter();
            var order = BuildOrder();

            if (_filterCategoryId.HasValue)
            {
                var allItems = await FetchAllProductsAsync(serverFilter, order);
                var filtered = allItems.Where(i => i.CategoryId == _filterCategoryId).ToList();

                _total = filtered.Count;
                if (_skip >= _total && _total > 0)
                    _skip = Math.Max(0, ((_total - 1) / _take) * _take);

                _items = filtered.Skip(_skip).Take(_take).ToList();
                await PersistStateAsync();
            }
            else
            {
                var result = await Client.GetProducts.ExecuteAsync(_skip, _take, serverFilter, order);
                if (result.Data?.Products is { } data)
                {
                    _items = data.Items?.Select(i => new ProductDto(
                        i.Id,
                        i.Name,
                        i.Price,
                        i.UnitName,
                        i.Description,
                        i.CategoryId,
                        i.Category?.Name,
                        i.ImageUrl,
                        i.Variants.Count(v => v.IsActive),
                        i.ModifierGroups.Count(g => g.IsActive)
                    )).ToList() ?? new List<ProductDto>();
                    _total = data.TotalCount;
                    await PersistStateAsync();
                }
                else if (result.Errors.Count > 0)
                    _error = GraphQLErrorFormatter.Format(result.Errors, "Không tải được sản phẩm.");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private async Task SyncPriceRangeBoundsAsync()
    {
        var cacheKey = $"products.price.max.{_search.Trim()}.{_filterCategoryId}";
        var dynamicMax = await LazyCache.GetOrLoadAsync(
            cacheKey,
            async () =>
            {
                var baseFilter = BuildServerFilter(includePrice: false);
                var allItems = await FetchAllProductsAsync(baseFilter, null);

                if (_filterCategoryId.HasValue)
                    allItems = allItems.Where(i => i.CategoryId == _filterCategoryId).ToList();

                if (allItems.Count == 0)
                    return 50000;

                var rawMax = allItems.Max(i => i.Price);
                var rounded = (int)(Math.Ceiling(rawMax / 5000m) * 5000m);
                return Math.Max(50000, rounded);
            },
            TimeSpan.FromSeconds(10));

        _priceRangeMax = dynamicMax;

        if (!_priceRangeInitialized)
        {
            _priceRange = (0, _priceRangeMax);
            _priceRangeInitialized = true;
            return;
        }

        var start = Math.Clamp((int)_priceRange.Start, 0, _priceRangeMax);
        var end = Math.Clamp((int)_priceRange.End, start, _priceRangeMax);
        _priceRange = (start, end);

        if (decimal.TryParse(_filterPriceMin, out var min) && min > _priceRangeMax)
            _filterPriceMin = start.ToString();

        if (decimal.TryParse(_filterPriceMax, out var max) && max > _priceRangeMax)
            _filterPriceMax = end.ToString();
    }

    private ProductFilterInput? BuildServerFilter(bool includePrice = true)
    {
        var hasSearch = !string.IsNullOrWhiteSpace(_search);
        var hasPriceMin = decimal.TryParse(_filterPriceMin, out var minPrice);
        var hasPriceMax = decimal.TryParse(_filterPriceMax, out var maxPrice);

        if (!includePrice)
        {
            hasPriceMin = false;
            hasPriceMax = false;
        }

        if (!hasSearch && !hasPriceMin && !hasPriceMax)
            return null;

        DecimalOperationFilterInput? priceFilter = null;
        if (hasPriceMin || hasPriceMax)
        {
            priceFilter = new DecimalOperationFilterInput
            {
                Gte = hasPriceMin ? minPrice : null,
                Lte = hasPriceMax ? maxPrice : null
            };
        }

        return new ProductFilterInput
        {
            Or = hasSearch
                ?
                [
                    new ProductFilterInput { Name = new StringOperationFilterInput { Contains = _search } },
                    new ProductFilterInput { Description = new StringOperationFilterInput { Contains = _search } }
                ]
                : null,
            Price = priceFilter
        };
    }

    private async Task<List<ProductDto>> FetchAllProductsAsync(ProductFilterInput? filter, IReadOnlyList<ProductSortInput>? order)
    {
        var pageSize = 100;
        const int minPageSize = 1;
        var skip = 0;
        var all = new List<ProductDto>();

        while (true)
        {
            var result = await Client.GetProducts.ExecuteAsync(skip, pageSize, filter, order);
            if (result.Data?.Products is { } data)
            {
                if (data.Items is { } items)
                {
                    all.AddRange(items.Select(i => new ProductDto(
                        i.Id,
                        i.Name,
                        i.Price,
                        i.UnitName,
                        i.Description,
                        i.CategoryId,
                        i.Category?.Name,
                        i.ImageUrl,
                        i.Variants.Count(v => v.IsActive),
                        i.ModifierGroups.Count(g => g.IsActive))));
                }

                if (data.PageInfo?.HasNextPage != true)
                    break;

                skip += pageSize;
                continue;
            }

            if (result.Errors.Count > 0)
            {
                var message = result.Errors[0].Message;
                if (IsPageSizeExceededError(message) && pageSize > minPageSize)
                {
                    pageSize = Math.Max(minPageSize, pageSize / 2);
                    continue;
                }

                throw new InvalidOperationException(GraphQLErrorFormatter.Format(result.Errors, "Không tải được sản phẩm."));
            }

            break;
        }

        return all
            .GroupBy(i => i.Id)
            .Select(g => g.First())
            .ToList();
    }

    private IReadOnlyList<ProductSortInput>? BuildOrder()
    {
        var sort = new ProductSortInput();
        switch (_sortOption)
        {
            case "name_desc":
                sort.Name = SortEnumType.Desc;
                break;
            case "price_asc":
                sort.Price = SortEnumType.Asc;
                break;
            case "price_desc":
                sort.Price = SortEnumType.Desc;
                break;
            default:
                sort.Name = SortEnumType.Asc;
                break;
        }

        return [sort];
    }

    private bool MatchesCurrentFilter(Guid id, string name, decimal price, string? description, Guid? categoryId)
    {
        var textMatches = string.IsNullOrWhiteSpace(_search)
            || name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
        var categoryMatches = !_filterCategoryId.HasValue || categoryId == _filterCategoryId;
        var priceMinMatches = !decimal.TryParse(_filterPriceMin, out var minPrice) || price >= minPrice;
        var priceMaxMatches = !decimal.TryParse(_filterPriceMax, out var maxPrice) || price <= maxPrice;
        return textMatches && categoryMatches && priceMinMatches && priceMaxMatches;
    }

    private int CurrentPage => (_skip / _take) + 1;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_total / (double)_take));
    private IEnumerable<int> VisiblePages
    {
        get
        {
            if (TotalPages <= 7)
                return Enumerable.Range(1, TotalPages);

            var start = Math.Max(1, CurrentPage - 2);
            var end = Math.Min(TotalPages, start + 4);
            start = Math.Max(1, end - 4);
            return Enumerable.Range(start, end - start + 1);
        }
    }

    private async Task GoToPageAsync(int page)
    {
        var targetPage = Math.Clamp(page, 1, TotalPages);
        _skip = (targetPage - 1) * _take;
        await LoadAsync();
    }

    private async Task OpenCreateAsync()
    {
        await EnsureCategoriesLoadedAsync(forceRefresh: true);
        if (_allCategories.Count == 0)
            ToastService.Warning("Chưa có danh mục để chọn. Vui lòng tạo danh mục trước.");

        _editId = null;
        _formName = "";
        _formPriceStr = "";
        _formUnitName = "";
        _formCategoryId = null;
        _formDescription = "";
        ResetImageForm();
        _showCreate = true;
    }
    private void CloseCreate() => _showCreate = false;
    private void CloseEdit() => _showEdit = false;

    private async Task OpenEditAsync(ProductDto item)
    {
        await EnsureCategoriesLoadedAsync(forceRefresh: true);
        if (_allCategories.Count == 0)
            ToastService.Warning("Chưa có danh mục để chọn. Vui lòng tạo danh mục trước.");

        _editId = item.Id;
        _formName = item.Name;
        _formPriceStr = item.Price.ToString();
        _formUnitName = item.UnitName ?? "";
        _formCategoryId = item.CategoryId;
        _formDescription = item.Description ?? "";
        _pendingImage = null;
        _imagePreviewUrl = null;
        _formImageUrl = item.ImageUrl ?? "";
        _showEdit = true;
    }

    private string GetCategoryDisplayName(Guid? categoryId)
    {
        if (!categoryId.HasValue) return "Không có";
        return _allCategories.FirstOrDefault(c => c.Id == categoryId.Value)?.Name ?? "(Không tìm thấy danh mục)";
    }

    private string? GetCategoryName(Guid? categoryId)
    {
        if (!categoryId.HasValue) return null;
        return _allCategories.FirstOrDefault(c => c.Id == categoryId.Value)?.Name;
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        _pendingImage = e.File;
        // Create a local data URL for preview without uploading
        var buffer = new byte[e.File.Size];
        await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        await stream.ReadExactlyAsync(buffer);
        _imagePreviewUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }

    private async Task<string?> UploadPendingImageAsync(string folder)
    {
        if (_pendingImage is null) return null;
        var url = await ImageUploadSvc.UploadAsync(_pendingImage, folder);
        _pendingImage = null;
        _imagePreviewUrl = null;
        if (url is null) ToastService.Error("Tải ảnh thất bại.");
        return url;
    }

    private void ResetImageForm()
    {
        _pendingImage = null;
        _imagePreviewUrl = null;
        _formImageUrl = "";
    }

    private async Task HandleCreate()
    {
        if (!decimal.TryParse(_formPriceStr, out var price)) return;
        _saving = true;

        // Upload pending image if any
        var uploadedUrl = await UploadPendingImageAsync("products");
        var imageUrl = uploadedUrl ?? (string.IsNullOrEmpty(_formImageUrl) ? null : _formImageUrl);

        var desc = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription;
        var unitName = string.IsNullOrWhiteSpace(_formUnitName) ? null : _formUnitName;
        var result = await Client.CreateProduct.ExecuteAsync(_formName, price, _formCategoryId, desc, imageUrl, unitName);
        _saving = false;
        if (result.Data?.CreateProduct is { } created)
        {
            _showCreate = false;
            ToastService.Success("Đã thêm sản phẩm.");

            if (MatchesCurrentFilter(created.Id, created.Name, created.Price, created.Description, created.CategoryId))
            {
                _total++;
                var activeVariantCount = _items.FirstOrDefault(x => x.Id == created.Id)?.ActiveVariantCount ?? 0;
                var activeModifierGroupCount = _items.FirstOrDefault(x => x.Id == created.Id)?.ActiveModifierGroupCount ?? 0;
                _items.Insert(0, new ProductDto(
                    created.Id,
                    created.Name,
                    created.Price,
                    created.UnitName,
                    created.Description,
                    created.CategoryId,
                    GetCategoryName(created.CategoryId),
                    created.ImageUrl,
                    activeVariantCount,
                    activeModifierGroupCount));
                if (_items.Count > _take)
                    _items.RemoveAt(_items.Count - 1);
            }
            await PersistStateAsync();
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private async Task HandleEdit()
    {
        if (!decimal.TryParse(_formPriceStr, out var price)) return;
        _saving = true;

        // Upload pending image if any
        var uploadedUrl = await UploadPendingImageAsync("products");
        var imageUrl = uploadedUrl ?? (string.IsNullOrEmpty(_formImageUrl) ? null : _formImageUrl);

        var desc = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription;
        var unitName = string.IsNullOrWhiteSpace(_formUnitName) ? null : _formUnitName;
        var result = await Client.UpdateProduct.ExecuteAsync(_editId!.Value, _formName, price, _formCategoryId, desc, imageUrl, unitName);
        _saving = false;
        if (result.Data?.UpdateProduct is { } updated)
        {
            _showEdit = false;
            ToastService.Success("Đã cập nhật sản phẩm.");

            var index = _items.FindIndex(x => x.Id == updated.Id);
            if (index >= 0)
            {
                if (MatchesCurrentFilter(updated.Id, updated.Name, updated.Price, updated.Description, updated.CategoryId))
                {
                    _items[index] = new ProductDto(
                        updated.Id,
                        updated.Name,
                        updated.Price,
                        updated.UnitName,
                        updated.Description,
                        updated.CategoryId,
                        GetCategoryName(updated.CategoryId),
                        updated.ImageUrl,
                        _items[index].ActiveVariantCount,
                        _items[index].ActiveModifierGroupCount);
                    await PersistStateAsync();
                }
                else
                {
                    _items.RemoveAt(index);
                    _total = Math.Max(0, _total - 1);
                    if (_items.Count == 0 && _skip > 0 && _total > 0)
                    {
                        _skip = Math.Max(0, _skip - _take);
                        await LoadAsync();
                    }
                    await PersistStateAsync();
                }
            }
            else
            {
                await LoadAsync();
            }
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    private void OpenDeleteConfirm(Guid id)
    {
        _pendingDeleteId = id;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (!_pendingDeleteId.HasValue)
            return;

        _showDeleteConfirm = false;
        var id = _pendingDeleteId.Value;
        _pendingDeleteId = null;
        await HandleDelete(id);
    }

    private async Task HandleDelete(Guid id)
    {
        var result = await Client.DeleteProduct.ExecuteAsync(id);
        if (result.Data?.DeleteProduct == true)
        {
            ToastService.Success("Đã xóa sản phẩm.");
            var index = _items.FindIndex(x => x.Id == id);
            if (index >= 0)
            {
                _items.RemoveAt(index);
                _total = Math.Max(0, _total - 1);

                if (_items.Count == 0 && _skip > 0 && _total > 0)
                    _skip = Math.Max(0, _skip - _take);

                if ((_items.Count < _take && _total > _items.Count) || (_items.Count == 0 && _total > 0))
                    await LoadAsync();
                else
                    await PersistStateAsync();
            }
            else
            {
                await LoadAsync();
            }
        }
        else
        {
            ToastService.Error(GraphQLErrorFormatter.Format(result.Errors));
        }
    }

    // ── Configure dialog state ──────────────────────────────────────────────
    private bool _showConfigure;
    private Guid? _configuringProductId;
    private string _configuringProductName = "";
    private bool _loadingConfig;

    // Variants
    private List<VariantRowDto> _variants = new List<VariantRowDto>();
    private bool _showVariantForm;
    private Guid? _editVariantId;
    private string _vCode = "", _vName = "", _vPriceStr = "", _vSortStr = "0";
    private bool _vActive = true;
    private bool _savingVariant;

    // Modifier Groups
    private List<ModifierGroupRowDto> _modifierGroups = new List<ModifierGroupRowDto>();
    private bool _showGroupForm;
    private Guid? _editGroupId;
    private string _gName = "", _gMinStr = "0", _gMaxStr = "1", _gSortStr = "0";
    private ModifierSelectionMode _gMode = ModifierSelectionMode.Multiple;
    private bool _gRequired, _gActive = true;
    private bool _savingGroup;

    // Modifier Options
    private Guid? _optionFormGroupId;
    private Guid? _editOptionId;
    private string _oName = "", _oPriceStr = "0", _oMaxQtyStr = "1", _oSortStr = "0";
    private bool _oDefault, _oActive = true;
    private bool _savingOption;

    private static readonly List<SelectOption<ModifierSelectionMode>> SelectionModeOptions =
    [
        new(ModifierSelectionMode.Single, "Chọn 1"),
        new(ModifierSelectionMode.Multiple, "Chọn nhiều")
    ];

    private void OpenConfigureAsync(ProductDto item)
    {
        _configuringProductId = item.Id;
        _configuringProductName = item.Name;
        _showVariantForm = false;
        _showGroupForm = false;
        _optionFormGroupId = null;
        _showConfigure = true;
        _ = LoadConfigAsync();
    }

    private async Task LoadConfigAsync()
    {
        if (_configuringProductId is null) return;
        _loadingConfig = true;
        try
        {
            var result = await Client.GetProductConfigurator.ExecuteAsync(_configuringProductId.Value);
            var product = result.Data?.ProductById;
            if (product is null) return;

            _variants = product.Variants
                .Select(v => new VariantRowDto(v.Id, v.Code, v.Name, v.Price, v.SortOrder, v.IsActive))
                .ToList();

            _modifierGroups = product.ModifierGroups
                .Select(g => new ModifierGroupRowDto(
                    g.Id, g.Name, g.SelectionMode, g.MinSelect, g.MaxSelect,
                    g.SortOrder, g.IsRequired, g.IsActive,
                    g.Options.Select(o => new ModifierOptionRowDto(
                        o.Id, o.Name, o.PriceDelta, o.MaxQty, o.SortOrder, o.IsDefault, o.IsActive)).ToList()))
                .ToList();
        }
        finally
        {
            _loadingConfig = false;
            StateHasChanged();
        }
    }

    // Variant CRUD
    private void OpenAddVariant() { _editVariantId = null; _vCode = ""; _vName = ""; _vPriceStr = ""; _vSortStr = "0"; _vActive = true; _showVariantForm = true; }
    private void OpenEditVariant(VariantRowDto v) { _editVariantId = v.Id; _vCode = v.Code; _vName = v.Name; _vPriceStr = v.Price.ToString(); _vSortStr = v.SortOrder.ToString(); _vActive = v.IsActive; _showVariantForm = true; }
    private void CancelVariantForm() { _showVariantForm = false; _editVariantId = null; }

    private async Task SaveVariantAsync()
    {
        if (!decimal.TryParse(_vPriceStr, out var price)) return;
        _savingVariant = true;
        var input = new ProductVariantInput { Code = _vCode, Name = _vName, Price = price, SortOrder = int.TryParse(_vSortStr, out var vSort) ? vSort : 0, IsActive = _vActive };
        try
        {
            if (_editVariantId.HasValue)
            {
                var r = await Client.UpdateProductVariant.ExecuteAsync(_editVariantId.Value, input);
                if (r.Data?.UpdateProductVariant is null) { ToastService.Error(GraphQLErrorFormatter.Format(r.Errors)); return; }
            }
            else
            {
                var r = await Client.CreateProductVariant.ExecuteAsync(_configuringProductId!.Value, input);
                if (r.Data?.CreateProductVariant is null) { ToastService.Error(GraphQLErrorFormatter.Format(r.Errors)); return; }
            }
            CancelVariantForm();
            await LoadConfigAsync();
            await RefreshProductRowAsync();
        }
        finally { _savingVariant = false; }
    }

    private async Task DeleteVariantAsync(Guid id)
    {
        var r = await Client.DeleteProductVariant.ExecuteAsync(id);
        if (r.Data?.DeleteProductVariant == true) { await LoadConfigAsync(); await RefreshProductRowAsync(); }
        else ToastService.Error(GraphQLErrorFormatter.Format(r.Errors));
    }

