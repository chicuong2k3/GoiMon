{
  "schema": "http://localhost:5000/graphql",
  "documents": "src/GoiMon.Client/GraphQL/**/*.graphql",
  "extensions": {
    "strawberryShake": {
      "name": "GoiMonClient",
      "namespace": "GoiMon.Client.GraphQL",
      "url": "http://localhost:5000/graphql",
      "records": {
        "inputs": false,
        "entities": false
      },
      "transportProfiles": [
        {
          "default": "Http",
          "subscription": "WebSocket"
        }
      ]
    }
  }
}
