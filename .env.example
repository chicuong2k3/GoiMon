# =============================================================
# GoiMon Docker Compose Environment Variables
# Copy this file to .env and fill in real values
# =============================================================

# --- Database (cloud PostgreSQL) ---
DATABASE_URL=Host=your-cloud-host;Database=goimon;Username=your_user;Password=your_password;SslMode=Require

# --- JWT ---
JWT_SIGNING_KEY=changeme_use_a_strong_random_key
JWT_ISSUER=goimon-api
JWT_AUDIENCE=goimon-client
JWT_EXPIRY_MINUTES=1440

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google-callback

# --- OAuth: Facebook ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://yourdomain.com/auth/facebook-callback

# --- Email (SMTP) ---
EMAIL_HOST=smtp-mail.outlook.com
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_DISPLAY_NAME=GoiMon

# --- OTP ---
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_DELIVERY_METHOD=Email

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seq (structured logging) ---
SEQ_URL=http://seq:80

# --- Internal service URLs (do not change unless you know what you're doing) ---
PORTAL_GRAPHQL_ENDPOINT=http://api:5000/graphql

# --- Port mapping (host:container) ---
API_PORT=5000
PORTAL_PORT=5002
